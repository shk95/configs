{
  "$comment": [
    "Claude Code permission adapter; project authority and safety live in AGENTS.md.",
    "Tool permission never authorizes an unrequested Git or host mutation.",
    "Publication, history rewrite, release, deletion, and host activation stay absent."
  ],
  "permissions": {
    "allow": [
      "Bash(tool/doctor.sh:*)",
      "Bash(tool/setup:*)",
      "Bash(tool/worktree.sh:*)",
      "Bash(tool/checks/:*)",
      "Bash(tool/version-control/:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git config core.hooksPath:*)",

      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",

      "Bash(gitleaks:*)",

      "Bash(nix flake check:*)",
      "Bash(nix flake show:*)",
      "Bash(nix flake metadata:*)",
      "Bash(nix build:*)",
      "Bash(nix eval:*)",
      "Bash(nix run:*)",
      "Bash(nix fmt:*)",
      "Bash(nix develop:*)",
      "Bash(nix-instantiate --parse:*)",
      "Bash(direnv allow:*)"
    ]
  }
}
