#!/bin/sh

# Run only the checks owned by content being pushed. Deletion-only pushes skip
# checks, and missing foreign-native tooling remains visible without making one
# platform depend on another.

set -eu

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

paths=$(mktemp)
trap 'rm -f "$paths"' EXIT
saw_ref=0
pushing_content=0

is_zero() {
  case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  saw_ref=1
  is_zero "$local_sha" && continue
  pushing_content=1

  if is_zero "$remote_sha"; then
    base=$(git merge-base "$local_sha" dev 2>/dev/null \
      || git rev-list --max-parents=0 "$local_sha" | head -1)
  else
    base=$remote_sha
  fi
  git diff --name-only "$base" "$local_sha" >>"$paths"
done

if [ "$saw_ref" -eq 1 ] && [ "$pushing_content" -eq 0 ]; then
  echo "· deletions only, skipping checks"
  exit 0
fi

if [ "$saw_ref" -eq 0 ]; then
  git diff-tree --no-commit-id --name-only -r HEAD >>"$paths"
fi

scopes=$(sort -u "$paths" | tool/version-control/classify --stdin)
printf '→ scopes\n%s\n' "$scopes"

if printf '%s\n' "$scopes" | grep -qx unclassified; then
  fail "A pushed path has no owning scope."
fi

if printf '%s\n' "$scopes" | grep -qx repository; then
  printf '→ version-control fixtures\n'
  tool/version-control/test || fail "Version-control policy fixtures failed."
fi

if printf '%s\n' "$scopes" | grep -qx unixlike; then
  printf '→ Unix-like test\n'
  tool/checks/test || fail "Unix-like tests failed."
fi

if printf '%s\n' "$scopes" | grep -qx windows; then
  # Only `pwsh.exe` counts. A Unix-like `pwsh` is not native Windows evidence,
  # and modules/powershell.nix installs one into every home this repository
  # configures — accepting it would make the branch below unreachable and leave
  # Windows work unpushable from the Linux and macOS clones where it is often
  # authored. The merge gate is the windows-latest CI job, not this hook.
  if command -v pwsh.exe >/dev/null 2>&1; then
    printf '→ Windows desired-state check\n'
    pwsh.exe -NoProfile -File ./windows/tools/check-desired-state.ps1 \
      || fail "Windows desired-state validation failed."
    printf '→ Windows tests\n'
    pwsh.exe -NoProfile -File ./windows/tools/test.ps1 \
      || fail "Windows tests failed."
  else
    echo "· native PowerShell unavailable; Windows checks remain unverified locally and CI must supply evidence"
  fi
fi

if printf '%s\n' "$scopes" | grep -qx common; then
  if [ -x common/check ]; then
    printf '→ common check\n'
    common/check || fail "Common checks failed."
  else
    fail "Common content changed but common/check is unavailable."
  fi
fi
