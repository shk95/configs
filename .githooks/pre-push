#!/bin/sh

# Run only the checks owned by content being pushed. Deletion-only pushes skip
# checks, and a check this host cannot run stays visible as unverified without
# making one platform depend on another.
#
# .githooks/evidence owns what each outcome means. This hook decides which
# checks are selected, never whether a missing tool is a failure.

set -eu

hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$hooks_dir/evidence"

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

paths=$(mktemp)
trap 'rm -f "$paths"' EXIT
saw_ref=0
pushing_content=0

is_zero() {
  case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  saw_ref=1
  is_zero "$local_sha" && continue
  pushing_content=1

  if is_zero "$remote_sha"; then
    base=$(git merge-base "$local_sha" dev 2>/dev/null \
      || git rev-list --max-parents=0 "$local_sha" | head -1)
  else
    base=$remote_sha
  fi
  git diff --name-only "$base" "$local_sha" >>"$paths"
done

if [ "$saw_ref" -eq 1 ] && [ "$pushing_content" -eq 0 ]; then
  echo "· deletions only, skipping checks"
  exit 0
fi

if [ "$saw_ref" -eq 0 ]; then
  git diff-tree --no-commit-id --name-only -r HEAD >>"$paths"
fi

scopes=$(sort -u "$paths" | tool/version-control/classify --stdin)
printf '→ scopes\n%s\n' "$scopes"

if printf '%s\n' "$scopes" | grep -qx unclassified; then
  fail "A pushed path has no owning scope."
fi

if printf '%s\n' "$scopes" | grep -qx repository; then
  evidence_run "version-control fixtures" tool/version-control/test || exit 1
fi

if printf '%s\n' "$scopes" | grep -qx unixlike; then
  evidence_run "Unix-like test" tool/checks/test || exit 1
fi

if printf '%s\n' "$scopes" | grep -qx windows; then
  # Only `pwsh.exe` counts. A Unix-like `pwsh` is not native Windows evidence,
  # and modules/powershell.nix installs one into every home this repository
  # configures — accepting it would leave Windows work unpushable from the
  # Linux and macOS clones where it is often authored. The merge gate is the
  # windows-latest CI job, not this hook.
  if command -v pwsh.exe >/dev/null 2>&1; then
    evidence_run "Windows desired-state check" \
      pwsh.exe -NoProfile -File ./windows/tools/check-desired-state.ps1 || exit 1
    evidence_run "Windows tests" \
      pwsh.exe -NoProfile -File ./windows/tools/test.ps1 || exit 1
  else
    evidence_unavailable "Windows checks" "native PowerShell is unavailable" || exit 1
  fi
fi

if printf '%s\n' "$scopes" | grep -qx common; then
  # Not a host capability: common material that arrives without its own check
  # is an incomplete change, and no runner can supply the missing script.
  if [ -x common/check ]; then
    evidence_run "common check" common/check || exit 1
  else
    fail "Common content changed but common/check is unavailable."
  fi
fi

evidence_summary
