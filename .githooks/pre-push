#!/bin/sh

# Run only the checks owned by content being pushed. Deletion-only pushes skip
# checks, and a check this host cannot run stays visible as unverified without
# making one platform depend on another.
#
# .githooks/evidence owns what each outcome means. This hook decides which
# checks are selected, never whether a missing tool is a failure.

set -eu

hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$hooks_dir/evidence"

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

changes=$(mktemp)
trap 'rm -f "$changes"' EXIT
saw_ref=0
pushing_content=0

is_zero() {
  case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  saw_ref=1
  is_zero "$local_sha" && continue
  pushing_content=1

  if is_zero "$remote_sha"; then
    base=$(git merge-base "$local_sha" dev 2>/dev/null \
      || git rev-list --max-parents=0 "$local_sha" | head -1)
  else
    base=$remote_sha
  fi
  git diff --name-status "$base" "$local_sha" >>"$changes"
done

if [ "$saw_ref" -eq 1 ] && [ "$pushing_content" -eq 0 ]; then
  echo "· deletions only, skipping checks"
  exit 0
fi

if [ "$saw_ref" -eq 0 ]; then
  git diff-tree --no-commit-id --name-status -r HEAD >>"$changes"
fi

units=$(sort -u "$changes" | tool/dispatch/select push)
printf '→ selected checks\n%s\n' "${units:-none}"

selected() { printf '%s\n' "$units" | grep -qx "$1"; }

if selected unclassified; then
  fail "A pushed path has no owning scope."
fi

if selected repository:fixtures; then
  evidence_run "version-control fixtures" tool/version-control/test || exit 1
fi

if selected unixlike:test; then
  evidence_run "Unix-like test" tool/checks/test || exit 1
fi

if selected windows:desired-state || selected windows:tests; then
  # Pick the pwsh that belongs to this host rather than the first one PATH
  # happens to expose. A Unix-like host — including WSL, where `pwsh.exe` is
  # also reachable through Windows interop — runs the checks under its own
  # native `pwsh`: modules/powershell.nix installs one into every home this
  # repository configures, the suite's WIN_ENV_E2E cases self-skip there, and
  # the windows-latest CI job remains the native gate for what a Linux pwsh
  # cannot exercise. Reaching for `pwsh.exe` over WSL interop instead runs an
  # unsigned script from \\wsl.localhost\... under Windows' own execution
  # policy, which refuses it (SecurityError) for reasons that have nothing to
  # do with the change being pushed — that was the recurring failure #113
  # tracked and the reason every prior windows-scope push from WSL needed
  # `--no-verify`. An actual Windows host (Git for Windows' own `sh`, detected
  # the same way tool/version-control/commit's --publish guard does) keeps
  # using only `pwsh.exe`, unchanged from before.
  windows_pwsh=
  case $(uname -s 2>/dev/null) in
    MINGW* | MSYS* | CYGWIN*)
      if command -v pwsh.exe >/dev/null 2>&1; then
        windows_pwsh=pwsh.exe
      fi
      ;;
    *)
      if command -v pwsh >/dev/null 2>&1; then
        windows_pwsh=pwsh
        echo "· running the Windows checks under this host's own pwsh (not pwsh.exe); WIN_ENV_E2E cases self-skip here and the windows-latest CI job remains the native gate for them"
      fi
      ;;
  esac

  if [ -n "$windows_pwsh" ]; then
    if selected windows:desired-state; then
      evidence_run "Windows desired-state check" \
        "$windows_pwsh" -NoProfile -File ./windows/tools/check-desired-state.ps1 || exit 1
    fi
    if selected windows:tests; then
      evidence_run "Windows tests" \
        "$windows_pwsh" -NoProfile -File ./windows/tools/test.ps1 || exit 1
    fi
  else
    evidence_unavailable "Windows checks" "native PowerShell is unavailable" || exit 1
  fi
fi

if selected common:check; then
  # Not a host capability: common material that arrives without its own check
  # is an incomplete change, and no runner can supply the missing script.
  if [ -x common/check ]; then
    evidence_run "common check" common/check || exit 1
  else
    fail "Common content changed but common/check is unavailable."
  fi
fi

evidence_summary
