#!/bin/sh
# Inspect transmitted Git objects. Native suites belong to exact-candidate
# verification; a push must have the scanner that can veto outbound secrets.
# INV repository/local-development-integration
# INV repository/local-gate-selects-by-effect
# INV repository/conventional-subject
# INV repository/release-tag-contract
# INV repository/evidence-three-states
set -eu
export GIT_NO_REPLACE_OBJECTS=1 REQUIRE_NATIVE=1
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL
hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$hooks_dir/evidence"

remote_master=
remote_master_loaded=false
read_remote_master() {
  if ! "$remote_master_loaded"; then
    result=$(git ls-remote --refs -- "$1" refs/heads/master) || return
    remote_master=${result%%[[:space:]]*}
    remote_master_loaded=true
  fi
}

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000)
      case "$remote_ref" in
        refs/tags/unixlike-v*|refs/tags/windows-v*|refs/tags/common-v*)
          echo 'Release tags are immutable; deletion is refused' >&2; exit 1 ;;
      esac
      continue ;;
  esac
  case "$remote_ref" in
    refs/tags/*)
      tag=$(printf '%s' "$local_ref" | sed 's|^refs/tags/||')
      [ "$remote_ref" = "refs/tags/$tag" ] || {
        echo 'Release tag renaming is refused' >&2; exit 1;
      }
      case "$remote_sha" in
        0000000000000000000000000000000000000000|"$local_sha") ;;
        *) echo 'Release tags are immutable; replacement is refused' >&2; exit 1 ;;
      esac
      [ "$(git rev-parse "refs/tags/$tag")" = "$local_sha" ] || {
        echo 'Tag source does not match the transmitted object' >&2; exit 1;
      }
      evidence_run "release tag" tool/version-control/audit --tag "$tag" || exit 1
      read_remote_master "$2"
      if [ -z "$remote_master" ] || ! git merge-base --is-ancestor "$local_sha^{commit}" "$remote_master"; then
        echo 'Publish the release commit to remote master before pushing its tag' >&2
        exit 1
      fi
      ;;
    refs/heads/*)
      if [ "$remote_sha" = 0000000000000000000000000000000000000000 ]; then
        read_remote_master "$2"
        # A local master can contain commits that the remote has never seen.
        base=${remote_master:-$(git hash-object -t tree --stdin </dev/null)}
      else
        base=$remote_sha
      fi
      if [ "$base" != "$(git hash-object -t tree --stdin </dev/null)" ] && ! git rev-parse --verify "$base^{commit}" >/dev/null; then
        echo 'Fetch the remote target explicitly before checking this push' >&2; exit 1;
      fi
      if [ "$remote_sha" != 0000000000000000000000000000000000000000 ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo 'Non-fast-forward push refused; use the separately approved history-rewrite workflow' >&2
        exit 1
      fi
      evidence_run "transmitted history" tool/version-control/audit --range "$base" "$local_sha" || exit 1
      evidence_run "transmitted secrets" tool/version-control/scan-secrets --range "$base" "$local_sha" || exit 1
      ;;
    *) echo "Unsupported destination ref: $remote_ref" >&2; exit 1 ;;
  esac
done
evidence_summary
