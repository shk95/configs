#!/bin/sh
# Inspect transmitted history only. Final candidate suites run before local
# dev integration; this hook never runs suites from an unrelated checkout.
# INV repository/local-development-integration
# INV repository/local-gate-selects-by-effect
# INV repository/conventional-subject
# INV repository/release-tag-contract
# INV repository/evidence-three-states
set -eu
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL
hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$hooks_dir/evidence"

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000)
      case "$remote_ref" in
        refs/tags/unixlike-v*|refs/tags/windows-v*|refs/tags/common-v*)
          echo 'Release tags are immutable; deletion is refused' >&2; exit 1 ;;
      esac
      continue ;;
  esac
  case "$remote_ref" in
    refs/tags/*)
      tag=$(printf '%s' "$local_ref" | sed 's|^refs/tags/||')
      [ "$remote_ref" = "refs/tags/$tag" ] || {
        echo 'Release tag renaming is refused' >&2; exit 1;
      }
      case "$remote_sha" in
        0000000000000000000000000000000000000000|"$local_sha") ;;
        *) echo 'Release tags are immutable; replacement is refused' >&2; exit 1 ;;
      esac
      [ "$(git rev-parse "refs/tags/$tag")" = "$local_sha" ] || {
        echo 'Tag source does not match the transmitted object' >&2; exit 1;
      }
      evidence_run "release tag" tool/version-control/audit --tag "$tag" || exit 1
      ;;
    refs/heads/*)
      if [ "$remote_sha" = 0000000000000000000000000000000000000000 ]; then
        base=$(git merge-base "$local_sha" dev)
      else
        base=$remote_sha
      fi
      git rev-parse --verify "$base^{commit}" >/dev/null || {
        echo 'Fetch the remote target explicitly before checking this push' >&2; exit 1;
      }
      evidence_run "transmitted history" tool/version-control/audit --range "$base" "$local_sha" || exit 1
      ;;
    *) echo "Unsupported destination ref: $remote_ref" >&2; exit 1 ;;
  esac
done
evidence_summary
