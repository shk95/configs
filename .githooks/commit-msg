#!/bin/sh
#
# Enforces Conventional Commits, so `git log --oneline` stays readable and
# changelog tooling can group commits by type later.
#
# INV repository/conventional-subject
#
# The subject grammar is stack-agnostic; the closing-keyword check below is
# this repository's.

# Guards the `sed '/^[[:space:]]*$/d'` call below from Git for Windows' MSYS
# argument conversion, which rewrites a leading-`/` argv element into a
# Windows path before sed sees it. See tool/version-control/hygiene for the
# full explanation and the observed failure (#79). Inert everywhere else.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

# A closing keyword is refused anywhere in the message, and before the
# subjects Git writes itself are let through, because a merge's body is ours.
# The grammar is the tool's; the merge gate runs the same tool over a pull
# request's commits, which is the complete check.
#
# INV repository/no-closing-keyword
closing_keywords="$(git rev-parse --show-toplevel)/tool/version-control/closing-keywords"
if [ -x "$closing_keywords" ]; then
  "$closing_keywords" --message "$1" || exit 1
fi

subject=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -1)

# Git writes these itself; they are not ours to reformat.
case "$subject" in
  "Merge "*|"Revert "*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+$'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<EOF

✗ Commit message is not a Conventional Commit.

  Got:      $subject
  Expected: <type>(<optional scope>): <description>

  Types:    build chore ci docs feat fix perf refactor revert style test
  Examples: feat(auth): add passwordless sign-in
            fix(db): stop save from rewinding the revision
            feat(api)!: make list endpoints paginated

  Bypass once with: git commit --no-verify

EOF
  exit 1
fi

# Long subjects get truncated by every tool that displays them.
if [ ${#subject} -gt 72 ]; then
  printf '\n✗ Subject is %s characters; keep it under 72.\n\n  %s\n\n' "${#subject}" "$subject" >&2
  exit 1
fi
