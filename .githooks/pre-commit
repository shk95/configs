#!/bin/sh
#
# Domain-aware local checks plus the three repository-wide scans: desired-state
# hygiene, the invariant registry, and secrets.
#
# Windows-only commits must not require Nix. The classifier is shared with the
# pre-push hook, CI, and the version-control skill. What a check that could not
# run means is decided in .githooks/evidence rather than here, so this hook
# needs no knowledge of any domain's tooling.
#
# Bypass with `git commit --no-verify`.

set -e

# Guards this script's sed/grep/awk calls from Git for Windows' MSYS argument
# conversion (#79); see tool/version-control/hygiene. Inert elsewhere.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$hooks_dir/evidence"

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

abort() {
  printf '  %s\n' "$1" >&2
  exit 1
}

run_check() {
  name=$1
  hint=$2
  script="tool/checks/$name"
  [ -x "$script" ] || return 0
  evidence_run "$name" "$script" || abort "$hint"
}

# Which checks this change needs, which is not the same question as who owns
# it. tool/dispatch/select answers the first; classify still answers the second
# for release tags, promotion, and CI job selection.
units=$(git diff --cached --name-status --relative | tool/dispatch/select commit)

selected() { printf '%s\n' "$units" | grep -qx "$1"; }

if selected unclassified; then
  fail "A staged path has no owning scope. Update tool/version-control/classify."
fi

if selected unixlike:format; then
  run_check format "Formatting is off. See tool/checks/format for the fix command."
fi

if selected unixlike:lint; then
  run_check lint "Static analysis found problems."
fi

if selected unixlike:payloads; then
  run_check payloads "Fix the payload it rejected, or declare it in assets/payloads.json."
fi

if selected repository:fixtures; then
  evidence_run "version-control fixtures" tool/version-control/test \
    || abort "Version-control policy fixtures failed."
fi

# Desired-state hygiene is repository-wide, domain-agnostic and cheap, the same
# shape as the secret scan below, so it runs unconditionally rather than
# through tool/dispatch/select. The run_check helper above resolves
# tool/checks/<name> and cannot reach a repository-scope check, so this calls
# evidence_run directly.
evidence_run hygiene tool/version-control/hygiene \
  || abort "See invariants/repository/hygiene-*.md and tool/version-control/hygiene.allow."

# The invariant registry check is repository-wide for the same reason
# hygiene is: a fixture renamed in any scope can orphan the tag an entry
# depends on, so it runs unconditionally rather than through dispatch.
evidence_run invariants tool/version-control/invariants \
  || abort "See invariants/README.md."

# Hooks are opt-in, so CI mirrors the secret check. A credential that reaches
# history stays there after the file is deleted, making the staged state the
# cheapest place to catch one.
# INV repository/no-secret-in-history
if command -v gitleaks >/dev/null 2>&1; then
  if gitleaks git --help >/dev/null 2>&1; then
    evidence_run gitleaks gitleaks git --staged --redact --no-banner \
      || abort "Possible secret in staged changes."
  else
    evidence_run gitleaks gitleaks protect --staged --redact --no-banner \
      || abort "Possible secret in staged changes."
  fi
else
  evidence_unavailable gitleaks "gitleaks is not installed" || exit 1
fi

evidence_summary
