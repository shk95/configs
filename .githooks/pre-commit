#!/bin/sh
#
# Domain-aware local checks and a repository-wide secret scan.
#
# Windows-only commits must not require Nix. The classifier is shared with the
# pre-push hook, CI, and the version-control skill.
#
# Bypass with `git commit --no-verify`.

set -e

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

run_check() {
  script="tool/checks/$1"
  [ -x "$script" ] || return 0
  printf '→ %s\n' "$1"
  "$script" || fail "$2"
}

scopes=$(tool/version-control/classify --staged)

if printf '%s\n' "$scopes" | grep -qx unclassified; then
  fail "A staged path has no owning scope. Update tool/version-control/classify."
fi

if printf '%s\n' "$scopes" | grep -qx unixlike; then
  run_check format "Formatting is off. See tool/checks/format for the fix command."
  run_check lint   "Static analysis found problems."
fi

if printf '%s\n' "$scopes" | grep -qx repository; then
  printf '→ version-control fixtures\n'
  tool/version-control/test || fail "Version-control policy fixtures failed."
fi

# Hooks are opt-in, so CI mirrors the secret check. A credential that reaches
# history stays there after the file is deleted, making the staged state the
# cheapest place to catch one.
if command -v gitleaks >/dev/null 2>&1; then
  printf '→ gitleaks\n'
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks git --staged --redact --no-banner || fail "Possible secret in staged changes."
  else
    gitleaks protect --staged --redact --no-banner || fail "Possible secret in staged changes."
  fi
else
  printf '· gitleaks not installed, skipping the secret scan\n'
fi
