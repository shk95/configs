keybinds clear-defaults=true {
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
    normal {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl p" { SwitchToMode "pane"; }
        bind "Ctrl t" { SwitchToMode "tab"; }
        bind "Ctrl h" { SwitchToMode "move"; }
        bind "Ctrl r" { SwitchToMode "resize"; }
        bind "Ctrl s" { SwitchToMode "scroll"; }
        bind "Ctrl o" { SwitchToMode "session"; }
        bind "Ctrl q" { Quit; }
    }
    pane {
        bind "h" "left" { MoveFocus "left"; }
        bind "j" "down" { MoveFocus "down"; }
        bind "k" "up" { MoveFocus "up"; }
        bind "l" "right" { MoveFocus "right"; }
        bind "p" { SwitchFocus; }
        bind "n" { NewPane; SwitchToMode "locked"; }
        bind "d" { NewPane "down"; SwitchToMode "locked"; }
        bind "r" { NewPane "right"; SwitchToMode "locked"; }
        bind "s" { NewPane "stacked"; SwitchToMode "locked"; }
        bind "x" { CloseFocus; SwitchToMode "locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "i" { TogglePanePinned; SwitchToMode "locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "locked"; }
        bind "c" { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "esc" { SwitchToMode "locked"; }
    }
    move {
        bind "h" "left" { MovePane "left"; }
        bind "j" "down" { MovePane "down"; }
        bind "k" "up" { MovePane "up"; }
        bind "l" "right" { MovePane "right"; }
        bind "n" "tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "esc" { SwitchToMode "locked"; }
    }
    tab {
        bind "h" "left" { GoToPreviousTab; }
        bind "l" "right" { GoToNextTab; }
        bind "H" { MoveTab "left"; }
        bind "L" { MoveTab "right"; }
        bind "n" { NewTab; SwitchToMode "locked"; }
        bind "x" { CloseTab; SwitchToMode "locked"; }
        bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "locked"; }
        bind "b" { BreakPane; SwitchToMode "locked"; }
        bind "[" { BreakPaneLeft; SwitchToMode "locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "locked"; }
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }
        bind "tab" { ToggleTab; }
        bind "esc" { SwitchToMode "locked"; }
    }
    renamepane {
        bind "enter" "Ctrl c" { SwitchToMode "locked"; }
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
    renametab {
        bind "enter" "Ctrl c" { SwitchToMode "locked"; }
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    resize {
        bind "h" "left" { Resize "Increase left"; }
        bind "j" "down" { Resize "Increase down"; }
        bind "k" "up" { Resize "Increase up"; }
        bind "l" "right" { Resize "Increase right"; }
        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "+" "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "esc" { SwitchToMode "locked"; }
    }
    scroll {
        bind "j" "down" { ScrollDown; }
        bind "k" "up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "s" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Ctrl c" "esc" { ScrollToBottom; SwitchToMode "locked"; }
    }
    entersearch {
        bind "enter" { SwitchToMode "search"; }
        bind "Ctrl c" "esc" { SwitchToMode "scroll"; }
    }
    search {
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "Ctrl c" "esc" { ScrollToBottom; SwitchToMode "locked"; }
    }
    session {
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "c" {
            LaunchOrFocusPlugin "zellij:configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "esc" { SwitchToMode "locked"; }
    }
}

default_mode "locked"
default_shell "zsh"
copy_clipboard "system"
copy_on_select true
session_name "unixlike"
attach_to_session true
on_force_close "detach"
show_startup_tips false
show_release_notes false

// Ghostty drives theme_light/theme_dark through its colour-scheme report,
// including over SSH. Non-reporting terminals use the explicit light fallback.
// The Zellij process owns these UI colours; the local terminal owns ANSI and
// its default background. Apply this file on the host running Zellij.
// Keep routine UI emphasis blue/grey; reserve semantic colours for alerts.
// Zellij 0.45.1 uses ribbon_unselected.emphasis_1 as a hover/alternate
// tab BACKGROUND, so it must be a light fill rather than an accent colour.
// The dark Modus Vivendi member is independent of the light palette.
themes {
    bluegray-light {
        text_unselected {
            base 48 54 64
            background 225 230 237
            emphasis_0 53 90 135
            emphasis_1 87 100 116
            emphasis_2 53 90 135
            emphasis_3 45 98 109
        }
        text_selected {
            base 48 54 64
            background 214 225 240
            emphasis_0 53 90 135
            emphasis_1 87 100 116
            emphasis_2 53 90 135
            emphasis_3 45 98 109
        }
        ribbon_selected {
            base 53 90 135
            background 214 225 240
            emphasis_0 53 90 135
            emphasis_1 87 100 116
            emphasis_2 53 90 135
            emphasis_3 154 63 74
        }
        ribbon_unselected {
            base 87 100 116
            background 225 230 237
            emphasis_0 53 90 135
            emphasis_1 214 225 240
            emphasis_2 87 100 116
            emphasis_3 154 63 74
        }
        table_title {
            base 53 90 135
            background 236 239 243
            emphasis_0 53 90 135
            emphasis_1 45 98 109
            emphasis_2 53 90 135
            emphasis_3 102 76 130
        }
        table_cell_selected {
            base 48 54 64
            background 214 225 240
            emphasis_0 53 90 135
            emphasis_1 45 98 109
            emphasis_2 53 90 135
            emphasis_3 102 76 130
        }
        table_cell_unselected {
            base 48 54 64
            background 236 239 243
            emphasis_0 53 90 135
            emphasis_1 45 98 109
            emphasis_2 53 90 135
            emphasis_3 102 76 130
        }
        list_selected {
            base 48 54 64
            background 214 225 240
            emphasis_0 53 90 135
            emphasis_1 45 98 109
            emphasis_2 53 90 135
            emphasis_3 102 76 130
        }
        list_unselected {
            base 48 54 64
            background 236 239 243
            emphasis_0 53 90 135
            emphasis_1 45 98 109
            emphasis_2 53 90 135
            emphasis_3 102 76 130
        }
        frame_selected {
            base 53 90 135
            background 0
            emphasis_0 53 90 135
            emphasis_1 87 100 116
            emphasis_2 53 90 135
            emphasis_3 0
        }
        frame_highlight {
            base 53 90 135
            background 0
            emphasis_0 154 63 74
            emphasis_1 53 90 135
            emphasis_2 53 90 135
            emphasis_3 53 90 135
        }
        frame_unselected {
            base 170 182 198
            background 0
            emphasis_0 87 100 116
            emphasis_1 87 100 116
            emphasis_2 87 100 116
            emphasis_3 0
        }
        exit_code_success {
            base 53 96 74
            background 0
            emphasis_0 45 98 109
            emphasis_1 236 239 243
            emphasis_2 102 76 130
            emphasis_3 53 90 135
        }
        exit_code_error {
            base 154 63 74
            background 0
            emphasis_0 118 86 31
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 102 76 130
            player_2 53 90 135
            player_3 45 98 109
            player_4 87 100 116
            player_5 53 96 74
            player_6 102 76 130
            player_7 154 63 74
            player_8 48 54 64
            player_9 0
            player_10 0
        }
    }
    modus-vivendi {
        text_unselected {
            base 255 255 255
            background 0 0 0
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 68 188 68
            emphasis_3 254 172 208
        }
        text_selected {
            base 255 255 255
            background 90 90 90
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 68 188 68
            emphasis_3 254 172 208
        }
        ribbon_selected {
            base 0 0 0
            background 68 188 68
            emphasis_0 0 0 0
            emphasis_1 90 90 90
            emphasis_2 0 0 0
            emphasis_3 90 90 90
        }
        ribbon_unselected {
            base 255 255 255
            background 89 89 89
            emphasis_0 255 255 255
            emphasis_1 166 166 166
            emphasis_2 255 255 255
            emphasis_3 166 166 166
        }
        table_title {
            base 68 188 68
            background 0 0 0
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 68 188 68
            emphasis_3 254 172 208
        }
        table_cell_selected {
            base 255 255 255
            background 90 90 90
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 68 188 68
            emphasis_3 254 172 208
        }
        table_cell_unselected {
            base 255 255 255
            background 0 0 0
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 68 188 68
            emphasis_3 254 172 208
        }
        list_selected {
            base 255 255 255
            background 90 90 90
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 68 188 68
            emphasis_3 254 172 208
        }
        list_unselected {
            base 255 255 255
            background 0 0 0
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 68 188 68
            emphasis_3 254 172 208
        }
        frame_selected {
            base 68 188 68
            background 0
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 254 172 208
            emphasis_3 0
        }
        frame_highlight {
            base 255 127 159
            background 0
            emphasis_0 255 95 89
            emphasis_1 182 160 255
            emphasis_2 255 127 159
            emphasis_3 255 127 159
        }
        frame_unselected {
            base 89 89 89
            background 0
            emphasis_0 255 127 159
            emphasis_1 0 211 208
            emphasis_2 254 172 208
            emphasis_3 0
        }
        exit_code_success {
            base 68 188 68
            background 0
            emphasis_0 0 211 208
            emphasis_1 0 0 0
            emphasis_2 254 172 208
            emphasis_3 47 175 255
        }
        exit_code_error {
            base 255 95 89
            background 0
            emphasis_0 208 188 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 254 172 208
            player_2 47 175 255
            player_3 0 211 208
            player_4 208 188 0
            player_5 68 188 68
            player_6 182 160 255
            player_7 255 95 89
            player_8 254 196 63
            player_9 0
            player_10 0
        }
    }
}
theme_dark "modus-vivendi"
theme_light "bluegray-light"
theme "bluegray-light"
