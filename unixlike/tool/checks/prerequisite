# Sourced by the Unix-like checks. Not executable on its own.
#
# A host that has no Nix cannot evaluate this domain at all, and until now each
# check simply ran `nix` and let the shell's "command not found" surface as a
# failure. That reports a check this host could never run as a check that ran
# and found a problem, which is the opposite of what
# docs/policy/definition-of-done/repository.md asks for, and it left native
# Windows clones unable to push a change to a Unix-like payload they had every
# right to edit.
#
# Exit status 69 is the repository's unverified state; see
# docs/policy/architecture.md. REQUIRE_NATIVE=1 turns it back into a failure, and CI
# sets that so the merge gate never accepts an unchecked change.

require_command() {
  require_missing=
  for require_name in "$@"; do
    command -v "$require_name" >/dev/null 2>&1 \
      || require_missing="$require_missing $require_name"
  done
  [ -n "$require_missing" ] || return 0

  if [ "${REQUIRE_NATIVE:-0}" = 1 ]; then
    printf '\033[31m✗ required tooling is missing:%s\033[0m\n' "$require_missing" >&2
    exit 1
  fi

  printf '· unverified: this host has no%s\n' "$require_missing" >&2
  exit 69
}

# Test runners need Python for the read-only contract tools. macOS can expose
# an xcrun python3 stub that passes `command -v` but cannot execute. Use the
# locked nixpkgs interpreter for the test runner in that case. Call from the
# repository root; this does not provision Python for a consumer host.
python_for_test() {
  if python3 -c 'pass' >/dev/null 2>&1; then
    command -v python3
    return
  fi
  require_command nix
  python_store=$(nix build --no-link --print-out-paths --impure --expr \
    'let f = builtins.getFlake (toString ./unixlike); in f.inputs.nixpkgs.legacyPackages.${builtins.currentSystem}.python3')
  printf '%s/bin/python3\n' "$python_store"
}
