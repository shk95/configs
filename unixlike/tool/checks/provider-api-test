#!/bin/sh
# The public consumer uses only the exported constructors. Check that host
# values reach the final evaluators and that invalid input is refused by name.
set -eu
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix
cd "$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
provider_root=$PWD

# Exercise the public output across an actual flake boundary. Use a physical
# temporary path: macOS's /var is a symlink, which Nix refuses in path inputs.
consumer_dir=$(mktemp -d)
consumer_dir=$(CDPATH= cd -- "$consumer_dir" && pwd -P)
trap 'rm -rf "$consumer_dir"' EXIT
cat > "$consumer_dir/flake.nix" <<EOF
{
  inputs.configs.url = "path:$provider_root";
  outputs = {configs, ...}: {
    nixosConfigurations.example = configs.lib.mkNixos {
      name = "example";
      host = {system = "aarch64-linux"; kind = "orbstack"; user = "user1"; stateVersion = "25.11";};
      profiles = [];
      git = {name = "Example"; email = "example@example.invalid";};
    };
    darwinConfigurations.example-mac = configs.lib.mkDarwin {
      host = {system = "aarch64-darwin"; hostName = "utm"; user = "user1";};
      git = {name = "Example"; email = "example@example.invalid";};
    };
    homeConfigurations.example = configs.lib.mkHome {
      system = "x86_64-linux";
      user = "shk";
      git = {name = "Example"; email = "example@example.invalid";};
    };
  };
}
EOF

if ! lock_result=$(nix flake lock "path:$consumer_dir" 2>&1); then
  printf '%s\n' "$lock_result" >&2
  exit 1
fi
[ "$(nix eval --raw "path:$consumer_dir#nixosConfigurations.example.config.networking.hostName")" = example ]
[ "$(nix eval --raw "path:$consumer_dir#darwinConfigurations.example-mac.config.networking.hostName")" = utm ]
[ "$(nix eval --raw "path:$consumer_dir#homeConfigurations.example.config.home.username")" = shk ]

eval_api() {
  nix eval --raw --impure --expr "
    let
      provider = builtins.getFlake (toString ./.);
      git = { name = \"Example\"; email = \"example@example.invalid\"; };
      nixosHost = { system = \"aarch64-linux\"; kind = \"orbstack\"; user = \"user1\"; stateVersion = \"25.11\"; };
    in $1"
}

accept() {
  label=$1 expected=$2 expression=$3
  actual=$(eval_api "$expression")
  [ "$actual" = "$expected" ] || {
    printf 'provider API: %s returned %s, expected %s\n' "$label" "$actual" "$expected" >&2
    exit 1
  }
}

refuse() {
  label=$1 message=$2 expression=$3
  if output=$(eval_api "$expression" 2>&1); then
    printf 'provider API: accepted %s\n' "$label" >&2
    exit 1
  fi
  printf '%s' "$output" | grep -Fq "$message" || {
    printf 'provider API: %s failed without %s\n%s\n' "$label" "$message" "$output" >&2
    exit 1
  }
}

accept 'NixOS host name' example \
  '(provider.lib.mkNixos { name = "example"; host = nixosHost; profiles = []; inherit git; }).config.networking.hostName'
accept 'NixOS consumer Git identity' example@example.invalid \
  '(provider.lib.mkNixos { name = "example"; host = nixosHost; profiles = []; inherit git; }).config.home-manager.users.user1.programs.git.settings.user.email'
accept 'NixOS system extension' yes \
  '(provider.lib.mkNixos { name = "example"; host = nixosHost; profiles = []; inherit git; systemModules = [{ environment.variables.CONSUMER = "yes"; }]; }).config.environment.variables.CONSUMER'
accept 'NixOS home extension' yes \
  '(provider.lib.mkNixos { name = "example"; host = nixosHost; profiles = []; inherit git; homeModules = [{ home.sessionVariables.CONSUMER = "yes"; }]; }).config.home-manager.users.user1.home.sessionVariables.CONSUMER'
accept 'Darwin host name' utm \
  '(provider.lib.mkDarwin { host = { system = "aarch64-darwin"; hostName = "utm"; user = "user1"; }; inherit git; }).config.networking.hostName'
accept 'Darwin consumer Git identity' example@example.invalid \
  '(provider.lib.mkDarwin { host = { system = "aarch64-darwin"; hostName = "utm"; user = "user1"; }; inherit git; }).config.home-manager.users.user1.programs.git.settings.user.email'
accept 'standalone home user' shk \
  '(provider.lib.mkHome { system = "x86_64-linux"; user = "shk"; inherit git; }).config.home.username'
accept 'standalone home Git identity' example@example.invalid \
  '(provider.lib.mkHome { system = "x86_64-linux"; user = "shk"; inherit git; }).config.programs.git.settings.user.email'

refuse 'missing identity' 'lib.mkHome: missing required field git' \
  '(provider.lib.mkHome { system = "x86_64-linux"; user = "shk"; }).config.home.username'
refuse 'missing Git address' 'lib.mkHome.git: missing required field email' \
  '(provider.lib.mkHome { system = "x86_64-linux"; user = "shk"; git = {name = "Example";}; }).config.home.username'
refuse 'missing NixOS state version' 'host.stateVersion' \
  '(provider.lib.mkNixos { name = "example"; host = builtins.removeAttrs nixosHost ["stateVersion"]; profiles = []; inherit git; }).config.networking.hostName'
refuse 'illegal machine combination' 'identity.nixosHosts.example: aarch64-linux vm on vmware is not a host' \
  '(provider.lib.mkNixos { name = "example"; host = nixosHost // {kind = "vm"; hypervisor = "vmware";}; profiles = []; inherit git; }).config.networking.hostName'
refuse 'duplicate profile' 'hostSelections.nixos.example: profiles must not be repeated' \
  '(provider.lib.mkNixos { name = "example"; host = nixosHost // {system = "x86_64-linux"; kind = "wsl";}; profiles = ["agents" "agents"]; inherit git; }).config.networking.hostName'
refuse 'unavailable profile' 'hostSelections.nixos.example: profile agents is unavailable for orbstack' \
  '(provider.lib.mkNixos { name = "example"; host = nixosHost; profiles = ["agents"]; inherit git; }).config.networking.hostName'
refuse 'unknown profile' 'profiles' \
  '(provider.lib.mkNixos { name = "example"; host = nixosHost; profiles = ["unknown"]; inherit git; }).config.networking.hostName'

printf '✓ exported provider constructors accept and refuse consumer inputs\n'
