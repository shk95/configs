{
  # tool/checks/eval-coverage-test: two NixOS configurations for the platform
  # the test runs on, which the test substitutes for @system@ in a temporary
  # copy, because a pure flake cannot ask for the current system. Both
  # instantiate, but their builders refuse execution. Provider verification
  # must evaluate them without realizing either host closure.
  description = "eval-coverage fixture: two NixOS hosts";
  outputs = _: let
    host = name: {
      config.system.build.toplevel = derivation {
        inherit name;
        system = "@system@";
        builder = "/bin/false";
      };
      # Both spellings: tool/checks/test reads the first, and a `nix flake
      # check` that learns a NixOS configuration's platform reads the second.
      pkgs.stdenv = {
        hostPlatform.system = "@system@";
        system = "@system@";
      };
    };
  in {
    nixosConfigurations = {
      this-host = host "this-host";
      other-host = host "other-host";
    };
  };
}
