#!/bin/sh
# Fixtures for the coverage rule in tool/checks/evaluate.
#
# INV unixlike/eval-covers-every-host
#
# Evaluation must reach every synthetic composition without realizing a host
# closure. The fixtures cover accepted and refused evaluation outcomes.
#
# CHECKS_FLAKE points tool/checks/evaluate at a fixture flake instead of this
# repository; the fixtures carry no inputs, so nothing is fetched.

set -e
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix

repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
cd "$repo"

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

fixtures="$repo/tool/checks/fixtures/eval-coverage"

# ---------------------------------------------------------------------------
# The evaluation check reaches every configuration
# ---------------------------------------------------------------------------
#
# INV unixlike/eval-covers-every-host
printf '→ accepts a flake that exports one configuration\n'
if ! output=$(CHECKS_FLAKE="path:$fixtures/probe" tool/checks/evaluate 2>&1); then
  printf '%s\n' "$output" >&2
  fail "the evaluation check rejected the probe fixture"
fi
printf '%s\n' "$output" | grep -q 'homeConfigurations.probe' \
  || fail "the evaluation check did not report the probe configuration"

for case in empty-flavour no-flavour; do
  printf '→ rejects %s\n' "$case"
  if output=$(CHECKS_FLAKE="path:$fixtures/$case" tool/checks/evaluate 2>&1); then
    printf '%s\n' "$output" >&2
    fail "the evaluation check passed the $case fixture"
  fi
done

# A composition for another platform must still instantiate. Depending on
# Nix, flake shape validation may detect the bad derivation before the explicit
# walk; either path must reject the broken composition for its actual reason.
printf '→ rejects a host that fails to evaluate, by name\n'
if output=$(CHECKS_FLAKE="path:$fixtures/failing-host" tool/checks/evaluate 2>&1); then
  printf '%s\n' "$output" >&2
  fail "the evaluation check passed a host whose toplevel does not instantiate"
fi
if printf '%s\n' "$output" | grep -q 'nixosConfigurations.broken eval ✗ (FAIL)$'; then
  printf '%s\n' "$output" | grep -q 'nixosConfigurations.sound eval ✓$' || {
    printf '%s\n' "$output" >&2
    fail "the evaluation check did not report the sound host beside the broken one"
  }
elif ! printf '%s\n' "$output" | grep -q 'the broken fixture host does not instantiate'; then
  printf '%s\n' "$output" >&2
  fail "the evaluation check failed for a reason other than the broken host"
fi

# Native derivations whose builders refuse execution still evaluate. This
# catches a regression which turns composition evidence into host realization.
printf '→ evaluates native compositions without executing their builders\n'
compositions=$(mktemp -d)
compositions=$(CDPATH= cd -- "$compositions" && pwd -P)
trap 'rm -rf "$compositions"' EXIT
here=$(nix eval --raw --impure --expr 'builtins.currentSystem')
sed "s/@system@/$here/g" "$fixtures/nixos-hosts/flake.nix.in" > "$compositions/flake.nix"
if ! output=$(CHECKS_FLAKE="path:$compositions" tool/checks/evaluate 2>&1); then
  printf '%s\n' "$output" >&2
  fail 'native compositions were realized instead of evaluated'
fi
for name in this-host other-host; do
  printf '%s\n' "$output" | grep -q "nixosConfigurations.$name eval ✓" \
    || fail "missing native composition $name"
done
# The provider requires every family, even when other compositions are valid.
printf '→ accepts all required families without executing native builders\n'
sed "s/@system@/$here/g" "$fixtures/required-families/flake.nix.in" > "$compositions/flake.nix"
if ! output=$(CHECKS_FLAKE="path:$compositions" CHECKS_STRICT_FAMILIES=1 tool/checks/evaluate 2>&1); then
  printf '%s\n' "$output" >&2
  fail 'the strict evaluation check rejected all required families'
fi
for family in homeConfigurations nixosConfigurations darwinConfigurations; do
  printf '→ refuses missing required family %s\n' "$family"
  sed "/^    $family =/d; s/@system@/$here/g" "$fixtures/required-families/flake.nix.in" > "$compositions/flake.nix"
  if output=$(CHECKS_FLAKE="path:$compositions" CHECKS_STRICT_FAMILIES=1 tool/checks/evaluate 2>&1); then
    fail "the strict evaluation check accepted missing $family"
  fi
  printf '%s\n' "$output" | grep -q "$family eval ✗ (ABSENT)" \
    || fail "missing $family failed without the required-family diagnosis"
done
printf '✓ evaluation coverage fixtures behave\n'
