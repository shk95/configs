#!/bin/sh
# Fixtures for the coverage rule in tool/checks/test.
#
# INV unixlike/eval-covers-every-host
#
# Evaluation is evidence only when it reached every configuration. The
# positive case is a fixture flake exporting one configuration; the negatives
# are a flavour the flake exports but that lists nothing, and a flake that
# exports no flavour at all. The real flake is the other positive case, run by
# CI as tool/checks/test itself.
#
# CHECKS_FLAKE points tool/checks/test at a fixture flake instead of this
# repository; the fixtures carry no inputs, so nothing is fetched.

set -e
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix

repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
cd "$repo"

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

fixtures="$repo/tool/checks/fixtures/eval-coverage"

# ---------------------------------------------------------------------------
# The evaluation check reaches every configuration
# ---------------------------------------------------------------------------
#
# INV unixlike/eval-covers-every-host
printf '→ accepts a flake that exports one configuration\n'
if ! output=$(CHECKS_FLAKE="path:$fixtures/probe" tool/checks/test 2>&1); then
  printf '%s\n' "$output" >&2
  fail "the evaluation check rejected the probe fixture"
fi
printf '%s\n' "$output" | grep -q 'homeConfigurations.probe' \
  || fail "the evaluation check did not report the probe configuration"

for case in empty-flavour no-flavour; do
  printf '→ rejects %s\n' "$case"
  if output=$(CHECKS_FLAKE="path:$fixtures/$case" tool/checks/test 2>&1); then
    printf '%s\n' "$output" >&2
    fail "the evaluation check passed the $case fixture"
  fi
done

# A host for another platform is evaluated and never built, so evaluation is
# all the evidence it has, and one that stops instantiating must fail the run
# by name. Which step finds it depends on the Nix that runs the check: a
# `nix flake check` that only asks for a derivation passes it, and the row
# comes from forcing `.drvPath`, with the sound host still reported beside
# it; one that instantiates every NixOS configuration stops on it first, with
# the fixture's own message. Either is the broken host's failure and no
# other's.
printf '→ rejects a host that fails to evaluate, by name\n'
if output=$(CHECKS_FLAKE="path:$fixtures/failing-host" tool/checks/test 2>&1); then
  printf '%s\n' "$output" >&2
  fail "the evaluation check passed a host whose toplevel does not instantiate"
fi
if printf '%s\n' "$output" | grep -q 'nixosConfigurations.broken  *eval ✗$'; then
  printf '%s\n' "$output" | grep -q 'nixosConfigurations.sound  *eval ✓ build — targets riscv64-linux$' || {
    printf '%s\n' "$output" >&2
    fail "the evaluation check did not report the sound host beside the broken one"
  }
elif ! printf '%s\n' "$output" | grep -q 'the broken fixture host does not instantiate'; then
  printf '%s\n' "$output" >&2
  fail "the evaluation check failed for a reason other than the broken host"
fi

# A NixOS host can activate one output, the one named after it, so that is
# the one the check builds there; every other NixOS output is evaluated and
# reported as not activatable, as all of them are anywhere else.
printf '→ builds only the NixOS output named after the host it runs on\n'
hosts_flake=$(mktemp -d)
trap 'rm -rf "$hosts_flake"' EXIT
here=$(nix eval --raw --impure --expr 'builtins.currentSystem')
sed "s/@system@/$here/g" "$fixtures/nixos-hosts/flake.nix.in" > "$hosts_flake/flake.nix"
if ! output=$(CHECKS_BUILD_ALL= CHECKS_NIXOS_HOST=this-host CHECKS_FLAKE="path:$hosts_flake" tool/checks/test 2>&1); then
  printf '%s\n' "$output" >&2
  fail "the evaluation check rejected the two-host fixture on this-host"
fi
printf '%s\n' "$output" | grep -q '^→ build nixosConfigurations.this-host$' &&
  printf '%s\n' "$output" | grep -q '^→ skip  nixosConfigurations.other-host ' &&
  ! printf '%s\n' "$output" | grep -q '^→ build nixosConfigurations.other-host$' || {
  printf '%s\n' "$output" >&2
  fail "on this-host the evaluation check did not build this-host alone"
}

# Neither fixture name is this machine's, so the same holds when the test
# itself runs on a NixOS host.
printf '→ builds no NixOS output on a host none of them is named after\n'
if ! output=$(CHECKS_BUILD_ALL= CHECKS_NIXOS_HOST= CHECKS_FLAKE="path:$hosts_flake" tool/checks/test 2>&1); then
  printf '%s\n' "$output" >&2
  fail "the evaluation check rejected the two-host fixture off-host"
fi
if printf '%s\n' "$output" | grep -q '^→ build nixosConfigurations'; then
  printf '%s\n' "$output" >&2
  fail "the evaluation check built a NixOS output on a host it is not named after"
fi

printf '✓ evaluation coverage fixtures behave\n'
