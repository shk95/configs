#!/bin/sh

# INV unixlike/install-target-explicit

set -eu
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix
require_command jq

flake=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
repo=$(CDPATH= cd -- "$flake/.." && pwd)
tool="$flake/tool/install-plan"
vm_test_tool="$flake/tool/install-vm-test"
work=$(mktemp -d)
work=$(CDPATH= cd -- "$work" && pwd -P)
trap 'rm -rf "$work"' EXIT

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

expect_refusal() {
  label=$1
  shift
  if "$tool" "$@" >"$work/refusal.out" 2>&1; then
    fail "install-plan accepted $label"
  fi
}

cd "$repo"
system=$(nix eval --raw --impure --expr builtins.currentSystem)
case "$system" in
  aarch64-linux | aarch64-darwin) host=fixture-utm ;;
  x86_64-linux) host=fixture-vm ;;
  *)
    echo "· unverified: no native installation fixture for $system"
    exit 69
    ;;
esac
target=/dev/disk/by-id/configs-install-plan-fixture
plan="$work/plan"
"$tool" "$host" "$target" "$plan" >"$work/valid.out"

[ -f "$plan/flake.nix" ] || fail "install-plan wrote no wrapper flake"
[ -f "$plan/flake.lock" ] || fail "install-plan wrote no lock"
[ -f "$plan/PLAN" ] || fail "install-plan wrote no review file"
[ "$(nix eval --raw "path:$plan#nixosConfigurations.\"$host\".config.disko.devices.disk.main.device")" = "$target" ] \
  || fail "the wrapper flake did not select the reviewed disk"
grep -Fxq "host=$host" "$plan/PLAN" || fail "the review file omitted the host"
grep -Fxq "disk=$target" "$plan/PLAN" || fail "the review file omitted the disk"

expect_refusal "a kernel-order disk path" "$host" /dev/sda "$work/kernel-path"
expect_refusal "an unknown host" missing "$target" "$work/missing"
expect_refusal "a host without a disk layout" fixture-wsl "$target" "$work/wsl"
expect_refusal "an existing plan directory" "$host" "$target" "$plan"
expect_refusal "more than one host or disk" "$host" "$target" "$work/extra" extra

if [ "$system" != aarch64-darwin ]; then
  portable=$("$vm_test_tool" --check "$host")
  [ -n "$portable" ] || fail "install-vm-test did not select the disposable VM proof"
  if "$vm_test_tool" --check fixture-wsl >"$work/vm-refusal.out" 2>&1; then
    fail "install-vm-test accepted a host without a disk layout"
  fi
fi

echo "✓ install plan requires one installable host and one persistent disk path"
