#!/bin/sh
# Static analysis: statix for common Nix anti-patterns, deadnix for unused
# bindings. Both are fetched via `nix run` rather than assumed to be on PATH,
# so this works with nothing installed beyond Nix itself.
#
# deadnix's default exit code is 0 regardless of what it finds — --fail is
# required, or this check passes silently on real dead code.

set -e
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix

# The domain root, for the reason format gives: the tree this analyses is the
# domain's, and the working directory is no longer it.
checks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$checks_dir/../.."

nix run nixpkgs#statix -- check .
nix run nixpkgs#deadnix -- --fail .

# The composition rule is static analysis of the same tree: a feature file
# names no host flavour and forces no value (INV unixlike/composition-in-one-place).
"$checks_dir/composition"
