#!/bin/sh
# Formatting check. Called by the pre-commit hook and by CI.
#
# Delegates to the flake's own `formatter.<system>` output (alejandra by
# default) rather than hardcoding a tool here, so the choice lives in one
# place: flake.nix. Assumes that formatter accepts --check, as alejandra does.

set -e
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix

# The domain root, which is where the flake is. Resolved from this script
# rather than from the working directory, because the two stopped being the
# same place when the domain moved into its own tree.
cd "$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

nix fmt -- --check .
