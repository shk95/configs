#!/bin/sh
# INV unixlike/tool-supply-ownership
set -eu
checks=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$checks/prerequisite"
require_command nix
cd "$checks/../../.."
python_cmd=$(python_for_test)
exec nix shell --inputs-from "path:$PWD/unixlike" nixpkgs#zsh \
  -c "$python_cmd" "$checks/programs-test.py"
