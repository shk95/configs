#!/bin/sh
# Fixtures for tool/checks/import-order.
#
# INV unixlike/import-order-independence
#
# The real tree still compares every host. Small detector fixtures use the
# same locked flake-parts engine and all three toplevel projections, with an
# ordered list feeding the derivations instead of rebuilding real host graphs.

set -e
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix

repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
cd "$repo"

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

# ---------------------------------------------------------------------------
# Every host composes the same in either walk order
# ---------------------------------------------------------------------------
#
# INV unixlike/import-order-independence
printf '→ accepts modules/\n'
tool/checks/import-order

printf '→ accepts a minimal stable composition\n'
CHECKS_IMPORT_MODULES="$repo/tool/checks/fixtures/import-order/minimal" tool/checks/import-order

printf '→ rejects an order-dependent pair\n'
if output=$(CHECKS_IMPORT_MODULES="$repo/tool/checks/fixtures/import-order/minimal" tool/checks/import-order tool/checks/fixtures/import-order/order-dependent 2>&1); then
  printf '%s\n' "$output" >&2
  fail "the import-order check accepted an order-dependent pair"
fi
printf '%s\n' "$output" | grep -q 'differs when the module files are collected in reverse order' \
  || fail "the import-order check failed for another reason"

for flavour in homeConfigurations nixosConfigurations darwinConfigurations; do
  printf '%s\n' "$output" | grep -q "$flavour.probe" \
    || fail "the detector did not identify $flavour.probe"
done

printf '✓ import-order fixtures behave\n'
