#!/bin/sh
# Run independent suites once before provider evaluation/build.
# INV unixlike/provider-input-refresh-bounded
# INV unixlike/host-written-payload-projected
# INV unixlike/eval-covers-every-host
set -eu
checks=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
"$checks/refresh-inputs-test"
"$checks/darwin-capture-test"
"$checks/karabiner-entry-test"
exec "$checks/eval-build" "$@"
