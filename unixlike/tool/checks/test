#!/bin/sh
# Two tiers of verification, and a rule about which configurations get the
# second one.
#
#   Tier 1 — eval.  Forces each configuration's toplevel derivation. Writing
#                   that .drv requires instantiating the whole input graph, so
#                   this already catches option typos, type errors, module
#                   assertions, bad imports *and* packages that do not exist.
#   Tier 2 — build. Realises it. What this adds over eval is narrower than it
#                   looks: sources that cannot be fetched, and derivations that
#                   fail to compile.
#
# `nix flake check` is neither, and this is the reason the script exists: it
# validates the flake's shape and its standard outputs, and does not descend
# into homeConfigurations / nixosConfigurations / darwinConfigurations at all.
# A green `nix flake check` says nothing about whether your configurations
# work. Forcing `.drvPath` is what actually evaluates them.
#
# A `nix build --dry-run` middle tier was tried and removed: measured against
# eval it caught nothing extra. A nonexistent package fails both; an
# unfetchable source passes both. It survives here only to report the size of a
# build that was skipped, which is information rather than verification.
#
# Every configuration is evaluated. Configurations targeting the current
# system are built when this host can activate them; foreign configurations
# remain explicit evaluation-only evidence until a native runner builds them.
#
# INV unixlike/eval-covers-every-host — evaluation is evidence only when it
# reached every configuration. A flavour the flake exports but that lists
# nothing, a flavour whose attribute fails to evaluate, and a run that reached
# no configuration at all are failures, not passes. So is a flavour this
# repository's flake stops exporting: the composition file's outputs are
# freeform attributes, so a misspelt one is only a warning to `nix flake
# check`. A fixture flake, reached through CHECKS_FLAKE, may export fewer
# flavours and has the missing ones reported as absent;
# tool/checks/eval-coverage-test holds those fixtures.

set -e
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix

root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
flake=${CHECKS_FLAKE:-path:$root}
here=$(nix eval --raw --impure --expr 'builtins.currentSystem')

# The flavours the flake exports, read once; each `builtins.getFlake` is a
# full evaluation outside the flake cache.
exported=$(nix eval --raw --impure --expr \
  "builtins.concatStringsSep \" \" (builtins.attrNames (builtins.getFlake \"$flake\"))")

report=$(mktemp)
trap 'rm -f "$report"' EXIT

nix flake check "$flake"

# The attribute that forces a real derivation, per flavour.
# `pkgs.stdenv.hostPlatform.system` resolves the target system for all three,
# so the probe below needs no special-casing.
toplevel_attr() {
  case $1 in
    homeConfigurations) echo "activationPackage" ;;
    *)                  echo "config.system.build.toplevel" ;;
  esac
}

# Tier 2 is expensive, and what it proves is per *repository* rather than per
# configuration: one configuration built from a clean checkout already shows
# the commit is complete and nothing local leaked into it. A second one buys
# very little for a great deal more — a minimal NixOS closure is upwards of
# 600 MiB, and CI starts from an empty store every run.
#
# So build what this host could actually activate, and say plainly what was
# not built. `nixos-rebuild switch` needs a NixOS host; home-manager runs
# anywhere. Set CHECKS_BUILD_ALL=1 to build everything regardless — worth doing
# deliberately when a flavour changes, and cheap locally once the store is warm.
activatable_here() {
  case $1 in
    nixosConfigurations) [ -r /etc/os-release ] && grep -q '^ID=nixos' /etc/os-release ;;
    *)                   return 0 ;;
  esac
}

check_flavour() {
  output=$1
  attr=$(toplevel_attr "$output")

  # INV unixlike/eval-covers-every-host: a flavour this repository's flake
  # no longer exports is a failure; a fixture flake may leave one out and has
  # it reported as absent. Empty and a failing flavour attribute are
  # failures, and the summary refuses a report that reached no configuration.
  case " $exported " in
    *" $output "*) ;;
    *)
      if [ -n "${CHECKS_FLAKE:-}" ]; then
        printf '→ skip  %s — the fixture flake exports no such flavour\n' "$output"
      else
        printf '%s|-|ABSENT\n' "$output" >> "$report"
      fi
      return 0
      ;;
  esac

  if ! names=$(nix eval --raw "$flake#$output" \
    --apply 'x: builtins.concatStringsSep "\n" (builtins.attrNames x)' 2>&1); then
    printf '%s\n' "$names" >&2
    printf '%s|-|FLAVOUR_FAIL\n' "$output" >> "$report"
    return 0
  fi
  if [ -z "$names" ]; then
    printf '%s|-|EMPTY\n' "$output" >> "$report"
    return 0
  fi

  echo "$names" | while IFS= read -r name; do
    [ -n "$name" ] || continue
    ref="$flake#$output.\"$name\""
    system=$(nix eval --raw "$ref.pkgs.stdenv.hostPlatform.system" 2>/dev/null || echo "unknown")

    printf '→ eval  %s.%s\n' "$output" "$name"
    if ! nix eval --raw "$ref.$attr.drvPath" >/dev/null; then
      printf '%s.%s|%s|EVAL_FAIL\n' "$output" "$name" "$system" >> "$report"
      continue
    fi

    if [ "$system" != "$here" ]; then
      printf '%s.%s|%s|FOREIGN\n' "$output" "$name" "$system" >> "$report"
      continue
    fi

    if [ -z "${CHECKS_BUILD_ALL:-}" ] && ! activatable_here "$output"; then
      printf '→ skip  %s.%s — nothing here can activate it\n' "$output" "$name"
      size=$(nix build --dry-run "$ref.$attr" 2>&1 \
             | sed -n 's/.*will be fetched (\([^)]*\)).*/\1/p' | head -1)
      printf '%s.%s|%s|SKIPPED|%s\n' "$output" "$name" "$system" \
             "${size:-already in the store}" >> "$report"
      continue
    fi

    printf '→ build %s.%s\n' "$output" "$name"
    if nix build --no-link "$ref.$attr"; then
      printf '%s.%s|%s|ok|\n' "$output" "$name" "$system" >> "$report"
    else
      printf '%s.%s|%s|BUILD_FAIL|\n' "$output" "$name" "$system" >> "$report"
    fi
  done
}

check_flavour homeConfigurations
check_flavour nixosConfigurations
check_flavour darwinConfigurations

echo
echo "── Verification coverage ─────────────────────────────────"
printf '   host: %s\n\n' "$here"

while IFS='|' read -r target system status detail; do
  case "$status" in
    ok)           line="eval ✓ build ✓" ;;
    EVAL_FAIL)    line="eval ✗" ;;
    BUILD_FAIL)   line="eval ✓ build ✗" ;;
    SKIPPED)      line="eval ✓ build — not activatable here ($detail)" ;;
    FOREIGN)      line="eval ✓ build — targets $system" ;;
    FLAVOUR_FAIL) line="eval ✗ — the flavour itself failed to evaluate" ;;
    EMPTY)        line="eval ✗ — exported, but lists no configuration" ;;
    ABSENT)       line="eval ✗ — the flake no longer exports this flavour" ;;
    *)            line="unknown" ;;
  esac
  printf '   %-38s %s\n' "$target" "$line"
done < "$report"
echo

if grep -q '|SKIPPED|' "$report"; then
  cat <<EOF
   · A configuration was evaluated but not built, because this host cannot
     activate it. Evaluation still instantiates its whole graph, so what is
     unproven is narrow: that its sources fetch and its derivations compile.
     Build it anyway with CHECKS_BUILD_ALL=1.

EOF
fi

if grep -qE 'FAIL|EMPTY|ABSENT' "$report"; then
  printf '\033[31m✗ A configuration failed to evaluate or build.\033[0m\n' >&2
  exit 1
fi

# INV unixlike/eval-covers-every-host: a check that found nothing to evaluate
# has failed, not passed.
if ! grep -qE '\|(ok|FOREIGN|SKIPPED)(\||$)' "$report"; then
  printf '\033[31m✗ No configuration was evaluated; the flake exports none.\033[0m\n' >&2
  exit 1
fi
