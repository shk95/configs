#!/bin/sh
# One provider suite: contract, composition, payloads and provider tooling.
# Configuration outputs are synthetic evaluation witnesses, not host targets.
# INV unixlike/provider-input-refresh-bounded
# INV unixlike/host-written-payload-projected
# INV unixlike/eval-covers-every-host
set -eu
checks=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$checks/prerequisite"
require_command nix
case "${1:-}" in
  --payloads)
    "$checks/payloads"
    exec "$checks/karabiner-test"
    ;;
  --provider) shift ;;
  *)
    for suite in just-entry-test dev-host-test refresh-inputs-test karabiner-entry-test \
      eval-coverage-test prerequisite-test; do
      "$checks/$suite"
    done
    [ "${1:-}" != --tools ] || exit 0
    ;;
esac
for suite in programs-test darwin-capture-test \
  payloads-test karabiner-test editable-files-test flake-test composition-test \
  import-order-test; do
  "$checks/$suite"
done
exec "$checks/evaluate" "$@"
