# ---------------------------------------------------------------------------
# The NixOS host carries no channel
# ---------------------------------------------------------------------------
#
# INV unixlike/nixos-no-channel
# modules/foundation/nix/shared.nix turns channels off and asserts it. A module that
# turns them back on is the violation; the real configuration must pass, and
# its search path must then name the flake's nixpkgs and nothing else, which
# is what makes a rebuild without `--flake` stop before it builds anything.

printf '→ refuses a NixOS configuration with channels on\n'
failed_assertions "$nixos" '{lib, ...}: { nix.channel.enable = lib.mkForce true; }'
expect_refusal 'INV unixlike/nixos-no-channel' 'nix.channel.enable = true'

printf '→ every real NixOS host has channels off and searches the flake alone\n'
for host in $nixos_hosts; do
  failed_assertions "nixosConfigurations.\"$host\"" '{ }'
  expect_clean "the NixOS host $host"
  nix_path=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".config.nix.nixPath" --apply 'builtins.concatStringsSep " "')
  [ "$nix_path" = "nixpkgs=flake:nixpkgs" ] ||
    fail "nixosConfigurations.$host searches '$nix_path', expected nixpkgs=flake:nixpkgs alone"
done

# ---------------------------------------------------------------------------
# A headless host is reached by a key, over one port
# ---------------------------------------------------------------------------
#
# INV unixlike/headless-key-only
# `nixos.headless` declares the account, sshd and the firewall of a host that
# boots itself, and modules/foundation/account.nix, modules/foundation/sshd.nix and
# modules/foundation/firewall.nix each assert their part. The real host must show every
# property and pass; each violation, added to it, must be refused. The
# guests are the hosts of the class, and every one of them is put through
# both directions.

for headless_host in $headless_hosts; do
  headless="nixosConfigurations.\"$headless_host\""

  printf '→ %s declares its account, key-only sshd on 22 and a firewall that opens 22 alone\n' "$headless_host"
  shape=$(nix eval --raw --impure --expr "
    let
      flake = builtins.getFlake (toString ./.);
      config = flake.$headless.config;
      account = config.users.users.\${config.host.user};
      sshd = config.services.openssh;
      firewall = config.networking.firewall;
      facts = {
        normal-user = account.isNormalUser;
        in-wheel = builtins.elem \"wheel\" account.extraGroups;
        zsh-login = (account.shell.pname or \"\") == \"zsh\";
        no-tracked-password = builtins.all (n: account.\${n} == null) [\"password\" \"hashedPassword\" \"hashedPasswordFile\" \"initialPassword\" \"initialHashedPassword\"];
        no-tracked-key = account.openssh.authorizedKeys.keys == [] && account.openssh.authorizedKeys.keyFiles == [];
        sudo-asks = config.security.sudo.wheelNeedsPassword;
        sshd-on-22 = sshd.enable && sshd.ports == [22];
        no-password-login = !sshd.settings.PasswordAuthentication && !sshd.settings.KbdInteractiveAuthentication;
        no-root-login = sshd.settings.PermitRootLogin == \"no\";
        firewall-opens-22-alone = firewall.enable && firewall.allowedTCPPorts == [22] && firewall.allowedUDPPorts == [] && firewall.allowedTCPPortRanges == [] && firewall.allowedUDPPortRanges == [];
        channels-off = !config.nix.channel.enable;
        shared-home-alone = builtins.attrNames config.home-manager.users == [config.host.user];
      };
    in builtins.concatStringsSep \" \" (builtins.filter (n: !facts.\${n}) (builtins.attrNames facts))")
  [ -z "$shape" ] || fail "nixosConfigurations.$headless_host does not hold: $shape"

  printf '→ refuses another open port, on every path to one\n'
  failed_assertions "$headless" '{ networking.firewall.allowedTCPPorts = [8080]; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a second TCP port'
  failed_assertions "$headless" '{ networking.firewall.allowedUDPPorts = [5353]; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a UDP port'
  failed_assertions "$headless" '{ networking.firewall.interfaces.eth0.allowedTCPPorts = [8080]; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a port opened on one interface'
  failed_assertions "$headless" '{lib, ...}: { networking.firewall.enable = lib.mkForce false; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a firewall turned off'

  printf '→ refuses a password or a root login over ssh\n'
  failed_assertions "$headless" '{lib, ...}: { services.openssh.settings.PasswordAuthentication = lib.mkForce true; }'
  expect_refusal 'INV unixlike/headless-key-only' 'password authentication'
  failed_assertions "$headless" '{lib, ...}: { services.openssh.settings.PermitRootLogin = lib.mkForce "yes"; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a root login'

  printf '→ refuses a tracked key, a tracked password and a passwordless sudo\n'
  failed_assertions "$headless" '{config, ...}: { users.users.${config.host.user}.openssh.authorizedKeys.keys = ["fixture-key"]; }'
  expect_refusal 'INV unixlike/headless-key-only' 'an authorized key in tracked state'
  failed_assertions "$headless" '{config, ...}: { users.users.${config.host.user}.initialPassword = "fixture"; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a password in tracked state'
  failed_assertions "$headless" '{lib, ...}: { security.sudo.wheelNeedsPassword = lib.mkForce false; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a passwordless sudo'

  printf '→ the real headless host passes\n'
  failed_assertions "$headless" '{ }'
  expect_clean "the headless host $headless_host"
done

# ---------------------------------------------------------------------------
# An OrbStack machine leaves the shared kernel alone
# ---------------------------------------------------------------------------
#
# INV unixlike/orbstack-shared-kernel
# modules/machines/orbstack.nix declares by hand what OrbStack needs from a guest
# and asserts that no binfmt emulation is registered: the registry belongs to
# the kernel every OrbStack machine and OrbStack's Docker share. The real
# host must show the shape OrbStack generates for a guest and pass; each way
# of declaring a registration, added to it, must be refused.

orbstack="nixosConfigurations.\"$orbstack_host\""

printf '→ the OrbStack machine declares the account, the network and the absence of sshd that OrbStack needs\n'
shape=$(nix eval --raw --impure --expr "
  let
    flake = builtins.getFlake (toString ./.);
    config = flake.$orbstack.config;
    account = config.users.users.\${config.host.user};
    facts = {
      uid-501 = account.uid == 501;
      in-wheel-and-orbstack = builtins.elem \"wheel\" account.extraGroups && builtins.elem \"orbstack\" account.extraGroups;
      orbstack-group = config.users.groups.orbstack.gid == 67278;
      zsh-login = (account.shell.pname or \"\") == \"zsh\";
      no-tracked-password = builtins.all (n: account.\${n} == null) [\"password\" \"hashedPassword\" \"hashedPasswordFile\" \"initialPassword\" \"initialHashedPassword\"];
      immutable-users = !config.users.mutableUsers;
      sshd-off = !config.services.openssh.enable;
      networkd-on-eth0 = config.systemd.network.enable && !config.networking.dhcpcd.enable && !config.networking.useDHCP && config.systemd.network.networks.\"50-eth0\".matchConfig.Name == \"eth0\";
      orbstack-resolv-conf = !config.services.resolved.enable && config.environment.etc.\"resolv.conf\".source == \"/opt/orbstack-guest/etc/resolv.conf\";
      watchdog-off = config.systemd.services.\"systemd-logind\".serviceConfig.WatchdogSec == 0;
      debugfs-mount-suppressed = builtins.elem \"sys-kernel-debug.mount\" config.systemd.suppressedSystemUnits;
      channels-off = !config.nix.channel.enable;
      no-binfmt = config.boot.binfmt.emulatedSystems == [] && config.boot.binfmt.registrations == {};
      no-certificate = config.security.pki.certificates == [];
      shared-home-alone = builtins.attrNames config.home-manager.users == [config.host.user];
    };
  in builtins.concatStringsSep \" \" (builtins.filter (n: !facts.\${n}) (builtins.attrNames facts))")
[ -z "$shape" ] || fail "nixosConfigurations.$orbstack_host does not hold: $shape"

printf '→ refuses a binfmt emulation, declared either way\n'
failed_assertions "$orbstack" '{ boot.binfmt.emulatedSystems = ["x86_64-linux"]; }'
expect_refusal 'INV unixlike/orbstack-shared-kernel' 'an emulated system'
failed_assertions "$orbstack" '{ boot.binfmt.registrations.fixture = { interpreter = "/run/current-system/sw/bin/true"; magicOrExtension = "fixture"; recognitionType = "extension"; }; }'
expect_refusal 'INV unixlike/orbstack-shared-kernel' 'a binfmt registration'

printf '→ the real OrbStack machine passes\n'
failed_assertions "$orbstack" '{ }'
expect_clean "the OrbStack machine $orbstack_host"

echo "✓ flake schema fixtures behave"

