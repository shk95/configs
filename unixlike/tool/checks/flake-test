#!/bin/sh
# Fixtures for the flake's own schema: the typed identity contract in
# modules/flake/identity.nix, the class composition in
# modules/flake/configurations.nix, and the two assertion-backed rules in
# modules/shell.nix and modules/packages.nix. All are enforced by evaluation,
# so the fixtures are evaluations — a value the schema must accept, a value it
# must refuse, a package that must reach one class of home and not another,
# and a module that must make a configuration's assertions fail.
#
# `builtins.getFlake` needs --impure to read a path; the locked nixpkgs `lib`
# is the one the flake evaluates with, so a module-system change in the input
# shows up here first.

set -e
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo"

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

# Evaluates identity.nix against inventory.nix plus one override module and
# prints the identity attribute asked for. `{ }` is the no-override case; a
# refusal case forces its value with `lib.mkForce`, otherwise the override
# collides with the inventory at equal priority and the merge error would
# stand in for the type refusal being proved.
identity_eval() {
  nix eval --raw --impure --expr "
    let
      flake = builtins.getFlake (toString ./.);
      lib = flake.inputs.nixpkgs.lib;
      eval = lib.evalModules {
        modules = [ ./modules/flake/identity.nix ./modules/flake/inventory.nix $1 ];
      };
    in eval.config.identity.$2"
}

# ---------------------------------------------------------------------------
# Typed identity
# ---------------------------------------------------------------------------
#
# INV unixlike/typed-identity
# The schema is identity.nix. The inventory must satisfy it, and a wrong shape
# must be refused at evaluation, before any host configuration is composed.

printf '→ accepts the inventory\n'
user=$(identity_eval '{ }' wsl.user)
[ -n "$user" ] || fail "identity.nix evaluated the inventory to an empty WSL account"

printf '→ refuses a platform outside the enum\n'
if identity_eval '{ identity.darwin.system = lib.mkForce "x86_64-linux"; }' darwin.system >/dev/null 2>&1; then
  fail "identity.nix accepted x86_64-linux as a Darwin platform"
fi

printf '→ refuses a non-string account\n'
if identity_eval '{ identity.wsl.user = lib.mkForce 5; }' wsl.user >/dev/null 2>&1; then
  fail "identity.nix accepted a number as the WSL account"
fi

printf '→ refuses a non-string host name\n'
if identity_eval '{ identity.darwin.hostName = lib.mkForce 5; }' darwin.hostName >/dev/null 2>&1; then
  fail "identity.nix accepted a number as the Darwin host name"
fi

# ---------------------------------------------------------------------------
# NixOS host inventory
# ---------------------------------------------------------------------------
#
# INV unixlike/nixos-host-inventory
# A host is an entry of identity.nixosHosts. The inventory must satisfy the
# schema, only the combinations the host lanes name may evaluate, and every
# declared host must answer to the name its entry and its output carry.

# Evaluates the inventory plus one override module and applies a function to
# identity.nixosHosts.
hosts_eval() {
  nix eval --raw --impure --expr "
    let
      flake = builtins.getFlake (toString ./.);
      lib = flake.inputs.nixpkgs.lib;
      eval = lib.evalModules {
        modules = [ ./modules/flake/identity.nix ./modules/flake/inventory.nix $1 ];
      };
    in ($2) eval.config.identity.nixosHosts"
}

# One fixture host beside the inventory's. Forcing a field of `fixture-host`
# never touches a declared host, so a refusal is about the fixture alone.
fixture_host() {
  printf '{ identity.nixosHosts.fixture-host = { system = "%s"; kind = "%s"; hypervisor = %s; user = "%s"; stateVersion = "26.05"; }; }' \
    "$1" "$2" "$3" "${4:-fixture}"
}
host_accepted() {
  hosts_eval "$(fixture_host "$@")" 'hosts: hosts.fixture-host.kind' >/dev/null 2>&1
}
host_refusal() {
  hosts_eval "$(fixture_host "$@")" 'hosts: hosts.fixture-host.kind' 2>&1 >/dev/null || true
}

printf '→ accepts the declared NixOS hosts\n'
nixos_hosts=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.attrNames hosts)')
[ -n "$nixos_hosts" ] || fail "the inventory declares no NixOS host"
wsl_host=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.filter (n: hosts.${n}.kind == "wsl") (builtins.attrNames hosts))')
[ -n "$wsl_host" ] && [ "$(printf '%s\n' "$wsl_host" | wc -l)" -eq 1 ] ||
  fail "the probes below need exactly one host of kind wsl, found: $wsl_host"
# The hosts of the headless class are the guests: every host of kind `vm`,
# under either hypervisor, until the installed-host graphical order composes
# the graphical classes into one.
headless_hosts=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep " " (builtins.filter (n: hosts.${n}.kind == "vm") (builtins.attrNames hosts))')
for hypervisor in utm vmware; do
  hosts_eval '{ }' "hosts: builtins.toJSON (builtins.any (n: hosts.\${n}.hypervisor == \"$hypervisor\") (builtins.attrNames hosts))" | grep -qx true ||
    fail "the probes below need a guest under $hypervisor, found: $headless_hosts"
done
# The OrbStack machine, the one host of its kind.
orbstack_host=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.filter (n: hosts.${n}.kind == "orbstack") (builtins.attrNames hosts))')
[ -n "$orbstack_host" ] && [ "$(printf '%s\n' "$orbstack_host" | wc -l)" -eq 1 ] ||
  fail "the probes below need exactly one OrbStack machine, found: $orbstack_host"
orbstack_user=$(hosts_eval '{ }' "hosts: hosts.\"$orbstack_host\".user")

# The invariant's other direction: the entry reaches its consumers through
# the typed option — the output is named by it, the host answers to it (#191)
# and takes its state version from it — so a mismatch means one of them
# carries an untyped copy instead.
printf '→ every NixOS host answers to the name its entry and its output carry\n'
exported=$(nix eval --raw "path:$repo#nixosConfigurations" \
  --apply 'configs: builtins.concatStringsSep "\n" (builtins.attrNames configs)')
[ "$exported" = "$nixos_hosts" ] ||
  fail "nixosConfigurations exports [$(echo $exported)], the inventory declares [$(echo $nixos_hosts)]"
for host in $nixos_hosts; do
  host_name=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".config.networking.hostName")
  [ "$host_name" = "$host" ] || fail "nixosConfigurations.$host declares networking.hostName $host_name"
  declared=$(hosts_eval '{ }' "hosts: hosts.\"$host\".stateVersion")
  applied=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".config.system.stateVersion")
  [ "$applied" = "$declared" ] || fail "nixosConfigurations.$host has state version $applied, its entry declares $declared"
  declared=$(hosts_eval '{ }' "hosts: hosts.\"$host\".system")
  applied=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".pkgs.stdenv.hostPlatform.system")
  [ "$applied" = "$declared" ] || fail "nixosConfigurations.$host targets $applied, its entry declares $declared"

  # Roadmap order 8 defines and tests the graphical classes in isolation.
  # Order 10 alone may compose them into an installed host. These option
  # markers make an accidental early composition fail at evaluation time.
  for option in \
    programs.niri.enable \
    services.greetd.enable \
    services.pipewire.enable
  do
    graphical=$(nix eval --json "path:$repo#nixosConfigurations.\"$host\".config.$option")
    [ "$graphical" = false ] || fail "nixosConfigurations.$host enables $option before the installed-host graphical order"
  done
done

printf '→ accepts each combination a host lane names\n'
host_accepted x86_64-linux wsl null "$user" || fail "identity.nix refused an x86_64 WSL host"
host_accepted x86_64-linux vm '"vmware"' || fail "identity.nix refused an x86_64 VMware guest"
host_accepted aarch64-linux vm '"utm"' || fail "identity.nix refused an aarch64 UTM guest"
host_accepted aarch64-linux orbstack null || fail "identity.nix refused an aarch64 OrbStack machine"
host_accepted x86_64-linux desktop null || fail "identity.nix refused an x86_64 desktop"

# A refusal must be the combination rule's and name the host, or a typo in
# the fixture would pass as a refusal.
refused() {
  # refused <what> <expected message, a grep pattern> <fixture_host arguments>
  what=$1
  pattern=$2
  shift 2
  if host_accepted "$@"; then
    fail "identity.nix accepted $what"
  fi
  host_refusal "$@" | grep -q "$pattern" ||
    fail "identity.nix refused $what, but not with: $pattern"
}
printf '→ refuses every other combination, naming the host\n'
not_a_host='identity.nixosHosts.fixture-host: .* is not a host this repository configures'
refused "a vm without a hypervisor" "$not_a_host" x86_64-linux vm null
refused "a hypervisor on a WSL host" "$not_a_host" x86_64-linux wsl '"vmware"' "$user"
refused "a hypervisor on a desktop" "$not_a_host" x86_64-linux desktop '"vmware"'
refused "a hypervisor on an OrbStack machine" "$not_a_host" aarch64-linux orbstack '"utm"'
refused "VMware on aarch64" "$not_a_host" aarch64-linux vm '"vmware"'
refused "UTM on x86_64" "$not_a_host" x86_64-linux vm '"utm"'
refused "WSL on aarch64" "$not_a_host" aarch64-linux wsl null "$user"
refused "a desktop on aarch64" "$not_a_host" aarch64-linux desktop null
refused "OrbStack on x86_64" "$not_a_host" x86_64-linux orbstack null
refused "a WSL host under another account" \
  'identity.nixosHosts.fixture-host: a host of kind wsl receives the WSL home classes' \
  x86_64-linux wsl null someone-else
refused "a Darwin platform for a NixOS host" 'nixosHosts.fixture-host.system.* is not of type' aarch64-darwin desktop null
refused "a kind outside the enum" 'nixosHosts.fixture-host.kind.* is not of type' x86_64-linux laptop null
refused "a hypervisor outside the enum" 'nixosHosts.fixture-host.hypervisor.* is not of type' x86_64-linux vm '"hyperv"'
no_state_version=$(fixture_host x86_64-linux desktop null | sed 's/ stateVersion = "[^"]*";//')
if hosts_eval "$no_state_version" 'hosts: hosts.fixture-host.stateVersion' >/dev/null 2>&1; then
  fail "identity.nix accepted a host without a state version"
fi
hosts_eval "$no_state_version" 'hosts: hosts.fixture-host.stateVersion' 2>&1 >/dev/null |
  grep -q 'nixosHosts.fixture-host.stateVersion.* was accessed but has no value defined' ||
  fail "identity.nix refused a host without a state version, but not for the missing value"

# ---------------------------------------------------------------------------
# Graphical classes stay out of headless homes
# ---------------------------------------------------------------------------
#
# INV unixlike/desktop-not-wsl
# modules/flake/configurations.nix composes `homeManager.desktop` into the
# Darwin home only. WezTerm is the marker: modules/wezterm.nix declares it in
# the desktop class alone, so its presence in a WSL home's packages, or in the
# headless guest's, means a graphical class reached a headless home. The
# Darwin arm proves the probe sees the desktop package where that class is
# composed. Noctalia and XWayland Satellite mark the Linux graphical class,
# which no declared host consumes before the installed-host graphical order.

packages_of() {
  nix eval --raw "path:$repo#$1" \
    --apply 'ps: builtins.concatStringsSep "\n" (map (p: p.pname or p.name) ps)'
}

wsl_user=$(identity_eval '{ }' wsl.user)
darwin_user=$(identity_eval '{ }' darwin.user)
darwin_host=$(identity_eval '{ }' darwin.hostName)

for home in \
  "homeConfigurations.\"$wsl_user\".config.home.packages" \
  "nixosConfigurations.\"$wsl_host\".config.home-manager.users.\"$wsl_user\".home.packages" \
  $(for host in $headless_hosts; do
    printf '%s\n' "nixosConfigurations.\"$host\".config.home-manager.users.\"$(hosts_eval '{ }' "hosts: hosts.\"$host\".user")\".home.packages"
  done) \
  "nixosConfigurations.\"$orbstack_host\".config.home-manager.users.\"$orbstack_user\".home.packages"
do
  printf '→ %s carries no graphical program\n' "${home%%.config*}"
  names=$(packages_of "$home")
  for marker in wezterm noctalia xwayland-satellite; do
    if printf '%s\n' "$names" | grep -qx "$marker"; then
      fail "$home carries $marker, a graphical-class program"
    fi
  done
done

printf '→ the Darwin home carries it\n'
darwin_home="darwinConfigurations.\"$darwin_host\".config.home-manager.users.\"$darwin_user\".home.packages"
names=$(packages_of "$darwin_home")
if ! printf '%s\n' "$names" | grep -qx wezterm; then
  fail "the Darwin home has no wezterm; the probe cannot see the desktop class"
fi

# Evaluates the failed assertions of a configuration extended with one more
# module. The extension is `extendModules`, so the real configuration is
# what is evaluated, plus the one definition each case adds. Two shapes of
# refusal exist and both are kept apart from an unrelated evaluation error:
# Home Manager turns a failed assertion into an evaluation error headed
# `Failed assertions:` as soon as `config` is read, while NixOS and
# nix-darwin report theirs through `config.assertions`, so a refusal there
# is a clean evaluation whose output names the tag. Leaves the status, the
# output and the diagnostics in three variables for the two checks below.
failed_assertions() {
  assertion_status=0
  assertion_output=$(nix eval --raw --impure --expr "
    let
      flake = builtins.getFlake (toString ./.);
      lib = flake.inputs.nixpkgs.lib;
      configuration = flake.$1;
      extended = configuration.extendModules { modules = [ ($2) ]; };
      failed = builtins.filter (a: !a.assertion) extended.config.assertions;
    in builtins.concatStringsSep \"\n\" (map (a: a.message) failed)" \
    2>"$assertion_diagnostics") || assertion_status=$?
}

expect_refusal() {
  tag=$1
  what=$2
  if [ "$assertion_status" -eq 0 ]; then
    printf '%s\n' "$assertion_output" | grep -q "$tag" && return 0
  elif grep -q 'Failed assertions:' "$assertion_diagnostics"; then
    grep -q "$tag" "$assertion_diagnostics" && return 0
  fi
  printf '%s\n' "$assertion_output" >&2
  cat "$assertion_diagnostics" >&2
  fail "$what was not refused by $tag"
}

expect_clean() {
  what=$1
  if [ "$assertion_status" -ne 0 ] || [ -n "$assertion_output" ]; then
    printf '%s\n' "$assertion_output" >&2
    cat "$assertion_diagnostics" >&2
    fail "$what fails an assertion or does not evaluate"
  fi
}

assertion_diagnostics=$(mktemp)
trap 'rm -f "$assertion_diagnostics"' EXIT

home="homeConfigurations.\"$wsl_user\""
nixos="nixosConfigurations.\"$wsl_host\""
darwin="darwinConfigurations.\"$darwin_host\""

# ---------------------------------------------------------------------------
# The version manager runs last and owns its toolchain
# ---------------------------------------------------------------------------
#
# INV unixlike/version-manager-last
# modules/shell.nix contributes the SDKMAN hook at `mkAfter` and asserts on
# the merged initialisation text, so a PATH line any module contributes later
# is refused at evaluation; a JDK declared as a package is refused the same
# way. The real home must pass both.

printf '→ refuses a PATH entry contributed after the version manager\n'
failed_assertions "$home" '{lib, ...}: { programs.zsh.initContent = lib.mkOrder 2000 "path+=(\"/opt/late/bin\")"; }'
expect_refusal 'INV unixlike/version-manager-last' 'a late PATH entry'

printf '→ refuses a PATH element assigned after the version manager\n'
failed_assertions "$home" '{lib, ...}: { programs.zsh.initContent = lib.mkOrder 2000 "path[1,0]=/opt/late/bin"; }'
expect_refusal 'INV unixlike/version-manager-last' 'a late PATH entry'

printf '→ refuses a JDK declared as a package\n'
failed_assertions "$home" '{pkgs, ...}: { home.packages = [pkgs.openjdk]; }'
expect_refusal 'INV unixlike/version-manager-last' 'a JDK package'

printf '→ the real home keeps the hook last and declares no toolchain\n'
failed_assertions "$home" '{ }'
expect_clean 'the WSL home'

# ---------------------------------------------------------------------------
# A package has one declaring module
# ---------------------------------------------------------------------------
#
# INV unixlike/package-ownership
# modules/packages.nix asserts, per home, that no package name is defined by
# two owners, and per system layer that no name this repository declares is
# in both the system packages and the managed home. `ripgrep` is already in
# the shared list, so a second declaration of it is the violation; the real
# configurations must pass.

printf '→ refuses a package declared by a second module in a home\n'
failed_assertions "$home" '{pkgs, ...}: { home.packages = [pkgs.ripgrep]; }'
expect_refusal 'INV unixlike/package-ownership' 'a second ripgrep declaration'

printf '→ refuses a home package declared again as a NixOS system package\n'
failed_assertions "$nixos" '{pkgs, ...}: { environment.systemPackages = [pkgs.ripgrep]; }'
expect_refusal 'INV unixlike/package-ownership' 'ripgrep in environment.systemPackages'

printf '→ refuses a home package declared again as a Darwin system package\n'
failed_assertions "$darwin" '{pkgs, ...}: { environment.systemPackages = [pkgs.ripgrep]; }'
expect_refusal 'INV unixlike/package-ownership' 'ripgrep in environment.systemPackages'

printf '→ the real NixOS and Darwin flavours declare nothing twice\n'
failed_assertions "$nixos" '{ }'
expect_clean 'the NixOS flavour'
failed_assertions "$darwin" '{ }'
expect_clean 'the Darwin flavour'

# ---------------------------------------------------------------------------
# The NixOS host carries no channel
# ---------------------------------------------------------------------------
#
# INV unixlike/nixos-no-channel
# modules/nix/shared.nix turns channels off and asserts it. A module that
# turns them back on is the violation; the real configuration must pass, and
# its search path must then name the flake's nixpkgs and nothing else, which
# is what makes a rebuild without `--flake` stop before it builds anything.

printf '→ refuses a NixOS configuration with channels on\n'
failed_assertions "$nixos" '{lib, ...}: { nix.channel.enable = lib.mkForce true; }'
expect_refusal 'INV unixlike/nixos-no-channel' 'nix.channel.enable = true'

printf '→ every real NixOS host has channels off and searches the flake alone\n'
for host in $nixos_hosts; do
  failed_assertions "nixosConfigurations.\"$host\"" '{ }'
  expect_clean "the NixOS host $host"
  nix_path=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".config.nix.nixPath" --apply 'builtins.concatStringsSep " "')
  [ "$nix_path" = "nixpkgs=flake:nixpkgs" ] ||
    fail "nixosConfigurations.$host searches '$nix_path', expected nixpkgs=flake:nixpkgs alone"
done

# ---------------------------------------------------------------------------
# A headless host is reached by a key, over one port
# ---------------------------------------------------------------------------
#
# INV unixlike/headless-key-only
# `nixos.headless` declares the account, sshd and the firewall of a host that
# boots itself, and modules/account.nix, modules/sshd.nix and
# modules/firewall.nix each assert their part. The real host must show every
# property and pass; each violation, added to it, must be refused. The
# guests are the hosts of the class, and every one of them is put through
# both directions.

for headless_host in $headless_hosts; do
  headless="nixosConfigurations.\"$headless_host\""

  printf '→ %s declares its account, key-only sshd on 22 and a firewall that opens 22 alone\n' "$headless_host"
  shape=$(nix eval --raw --impure --expr "
    let
      flake = builtins.getFlake (toString ./.);
      config = flake.$headless.config;
      account = config.users.users.\${config.host.user};
      sshd = config.services.openssh;
      firewall = config.networking.firewall;
      facts = {
        normal-user = account.isNormalUser;
        in-wheel = builtins.elem \"wheel\" account.extraGroups;
        zsh-login = (account.shell.pname or \"\") == \"zsh\";
        no-tracked-password = builtins.all (n: account.\${n} == null) [\"password\" \"hashedPassword\" \"hashedPasswordFile\" \"initialPassword\" \"initialHashedPassword\"];
        no-tracked-key = account.openssh.authorizedKeys.keys == [] && account.openssh.authorizedKeys.keyFiles == [];
        sudo-asks = config.security.sudo.wheelNeedsPassword;
        sshd-on-22 = sshd.enable && sshd.ports == [22];
        no-password-login = !sshd.settings.PasswordAuthentication && !sshd.settings.KbdInteractiveAuthentication;
        no-root-login = sshd.settings.PermitRootLogin == \"no\";
        firewall-opens-22-alone = firewall.enable && firewall.allowedTCPPorts == [22] && firewall.allowedUDPPorts == [] && firewall.allowedTCPPortRanges == [] && firewall.allowedUDPPortRanges == [];
        channels-off = !config.nix.channel.enable;
        shared-home-alone = builtins.attrNames config.home-manager.users == [config.host.user];
      };
    in builtins.concatStringsSep \" \" (builtins.filter (n: !facts.\${n}) (builtins.attrNames facts))")
  [ -z "$shape" ] || fail "nixosConfigurations.$headless_host does not hold: $shape"

  printf '→ refuses another open port, on every path to one\n'
  failed_assertions "$headless" '{ networking.firewall.allowedTCPPorts = [8080]; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a second TCP port'
  failed_assertions "$headless" '{ networking.firewall.allowedUDPPorts = [5353]; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a UDP port'
  failed_assertions "$headless" '{ networking.firewall.interfaces.eth0.allowedTCPPorts = [8080]; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a port opened on one interface'
  failed_assertions "$headless" '{lib, ...}: { networking.firewall.enable = lib.mkForce false; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a firewall turned off'

  printf '→ refuses a password or a root login over ssh\n'
  failed_assertions "$headless" '{lib, ...}: { services.openssh.settings.PasswordAuthentication = lib.mkForce true; }'
  expect_refusal 'INV unixlike/headless-key-only' 'password authentication'
  failed_assertions "$headless" '{lib, ...}: { services.openssh.settings.PermitRootLogin = lib.mkForce "yes"; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a root login'

  printf '→ refuses a tracked key, a tracked password and a passwordless sudo\n'
  failed_assertions "$headless" '{config, ...}: { users.users.${config.host.user}.openssh.authorizedKeys.keys = ["fixture-key"]; }'
  expect_refusal 'INV unixlike/headless-key-only' 'an authorized key in tracked state'
  failed_assertions "$headless" '{config, ...}: { users.users.${config.host.user}.initialPassword = "fixture"; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a password in tracked state'
  failed_assertions "$headless" '{lib, ...}: { security.sudo.wheelNeedsPassword = lib.mkForce false; }'
  expect_refusal 'INV unixlike/headless-key-only' 'a passwordless sudo'

  printf '→ the real headless host passes\n'
  failed_assertions "$headless" '{ }'
  expect_clean "the headless host $headless_host"
done

# ---------------------------------------------------------------------------
# An OrbStack machine leaves the shared kernel alone
# ---------------------------------------------------------------------------
#
# INV unixlike/orbstack-shared-kernel
# modules/host/orbstack.nix declares by hand what OrbStack needs from a guest
# and asserts that no binfmt emulation is registered: the registry belongs to
# the kernel every OrbStack machine and OrbStack's Docker share. The real
# host must show the shape OrbStack generates for a guest and pass; each way
# of declaring a registration, added to it, must be refused.

orbstack="nixosConfigurations.\"$orbstack_host\""

printf '→ the OrbStack machine declares the account, the network and the absence of sshd that OrbStack needs\n'
shape=$(nix eval --raw --impure --expr "
  let
    flake = builtins.getFlake (toString ./.);
    config = flake.$orbstack.config;
    account = config.users.users.\${config.host.user};
    facts = {
      uid-501 = account.uid == 501;
      in-wheel-and-orbstack = builtins.elem \"wheel\" account.extraGroups && builtins.elem \"orbstack\" account.extraGroups;
      orbstack-group = config.users.groups.orbstack.gid == 67278;
      zsh-login = (account.shell.pname or \"\") == \"zsh\";
      no-tracked-password = builtins.all (n: account.\${n} == null) [\"password\" \"hashedPassword\" \"hashedPasswordFile\" \"initialPassword\" \"initialHashedPassword\"];
      immutable-users = !config.users.mutableUsers;
      sshd-off = !config.services.openssh.enable;
      networkd-on-eth0 = config.systemd.network.enable && !config.networking.dhcpcd.enable && !config.networking.useDHCP && config.systemd.network.networks.\"50-eth0\".matchConfig.Name == \"eth0\";
      orbstack-resolv-conf = !config.services.resolved.enable && config.environment.etc.\"resolv.conf\".source == \"/opt/orbstack-guest/etc/resolv.conf\";
      watchdog-off = config.systemd.services.\"systemd-logind\".serviceConfig.WatchdogSec == 0;
      debugfs-mount-suppressed = builtins.elem \"sys-kernel-debug.mount\" config.systemd.suppressedSystemUnits;
      channels-off = !config.nix.channel.enable;
      no-binfmt = config.boot.binfmt.emulatedSystems == [] && config.boot.binfmt.registrations == {};
      no-certificate = config.security.pki.certificates == [];
      shared-home-alone = builtins.attrNames config.home-manager.users == [config.host.user];
    };
  in builtins.concatStringsSep \" \" (builtins.filter (n: !facts.\${n}) (builtins.attrNames facts))")
[ -z "$shape" ] || fail "nixosConfigurations.$orbstack_host does not hold: $shape"

