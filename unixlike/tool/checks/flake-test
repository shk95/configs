#!/bin/sh
# Fixtures for the flake's own schema: the typed identity contract in
# modules/flake/identity.nix, the class composition in
# modules/flake/configurations.nix, and the two assertion-backed rules in
# modules/foundation/shell/shared.nix and modules/foundation/packages.nix. All are enforced by evaluation,
# so the fixtures are evaluations — a value the schema must accept, a value it
# must refuse, a package that must reach one class of home and not another,
# and a module that must make a configuration's assertions fail.
#
# `builtins.getFlake` needs --impure to read a path; the locked nixpkgs `lib`
# is the one the flake evaluates with, so a module-system change in the input
# shows up here first.

set -e
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/prerequisite"
require_command nix

"$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/provider-api-test"

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo"

# The provider exports synthetic coverage only. A real host declaration or
# final output reintroduced here must fail before any fixture is evaluated.
[ ! -e modules/flake/inventory.nix ] || {
  printf 'provider: real host inventory has returned\n' >&2
  exit 1
}
fixture_names=$(nix eval --raw path:.#nixosConfigurations \
  --apply 'x: builtins.concatStringsSep " " (builtins.attrNames x)')
[ "$fixture_names" = 'fixture-desktop fixture-orbstack fixture-utm fixture-vm fixture-wsl' ] || {
  printf 'provider: unexpected NixOS outputs: %s\n' "$fixture_names" >&2
  exit 1
}
home_names=$(nix eval --raw path:.#homeConfigurations \
  --apply 'x: builtins.concatStringsSep " " (builtins.attrNames x)')
[ "$home_names" = example ] || {
  printf 'provider: unexpected Home Manager outputs: %s\n' "$home_names" >&2
  exit 1
}
darwin_names=$(nix eval --raw path:.#darwinConfigurations \
  --apply 'x: builtins.concatStringsSep " " (builtins.attrNames x)')
[ "$darwin_names" = fixture-mac ] || {
  printf 'provider: unexpected Darwin outputs: %s\n' "$darwin_names" >&2
  exit 1
}

fail() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  exit 1
}

# Evaluates identity.nix against inventory.nix plus one override module and
# prints the identity attribute asked for. `{ }` is the no-override case; a
# refusal case forces its value with `lib.mkForce`, otherwise the override
# collides with the inventory at equal priority and the merge error would
# stand in for the type refusal being proved.
identity_eval() {
  nix eval --raw --impure --expr "
    let
      flake = builtins.getFlake (toString ./.);
      lib = flake.inputs.nixpkgs.lib;
      eval = lib.evalModules {
        modules = [ ./modules/flake/identity.nix ./modules/flake/fixtures.nix $1 ];
      };
    in eval.config.identity.$2"
}

# ---------------------------------------------------------------------------
# Typed identity
# ---------------------------------------------------------------------------
#
# INV unixlike/typed-identity
# The schema is identity.nix. The inventory must satisfy it, and a wrong shape
# must be refused at evaluation, before any host configuration is composed.

printf '→ accepts the inventory\n'
user=$(identity_eval '{ }' wsl.user)
[ -n "$user" ] || fail "identity.nix evaluated the inventory to an empty WSL account"

printf '→ refuses a platform outside the enum\n'
if identity_eval '{ identity.darwin.system = lib.mkForce "x86_64-linux"; }' darwin.system >/dev/null 2>&1; then
  fail "identity.nix accepted x86_64-linux as a Darwin platform"
fi

printf '→ refuses a non-string account\n'
if identity_eval '{ identity.wsl.user = lib.mkForce 5; }' wsl.user >/dev/null 2>&1; then
  fail "identity.nix accepted a number as the WSL account"
fi

printf '→ refuses a non-string host name\n'
if identity_eval '{ identity.darwin.hostName = lib.mkForce 5; }' darwin.hostName >/dev/null 2>&1; then
  fail "identity.nix accepted a number as the Darwin host name"
fi

# ---------------------------------------------------------------------------
# NixOS host inventory
# ---------------------------------------------------------------------------
#
# INV unixlike/nixos-host-inventory
# A host is an entry of identity.nixosHosts. The inventory must satisfy the
# schema, only the combinations the host lanes name may evaluate, and every
# declared host must answer to the name its entry and its output carry.

# Evaluates the inventory plus one override module and applies a function to
# identity.nixosHosts.
hosts_eval() {
  nix eval --raw --impure --expr "
    let
      flake = builtins.getFlake (toString ./.);
      lib = flake.inputs.nixpkgs.lib;
      eval = lib.evalModules {
        modules = [ ./modules/flake/identity.nix ./modules/flake/fixtures.nix $1 ];
      };
    in ($2) eval.config.identity.nixosHosts"
}

# One fixture host beside the inventory's. Forcing a field of `fixture-host`
# never touches a declared host, so a refusal is about the fixture alone.
fixture_host() {
  printf '{ identity.nixosHosts.fixture-host = { system = "%s"; kind = "%s"; hypervisor = %s; user = "%s"; stateVersion = "26.05"; }; }' \
    "$1" "$2" "$3" "${4:-fixture}"
}
host_accepted() {
  hosts_eval "$(fixture_host "$@")" 'hosts: hosts.fixture-host.kind' >/dev/null 2>&1
}
host_refusal() {
  hosts_eval "$(fixture_host "$@")" 'hosts: hosts.fixture-host.kind' 2>&1 >/dev/null || true
}

printf '→ accepts the declared NixOS hosts\n'
nixos_hosts=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.attrNames hosts)')
[ -n "$nixos_hosts" ] || fail "the inventory declares no NixOS host"
wsl_host=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.filter (n: hosts.${n}.kind == "wsl") (builtins.attrNames hosts))')
[ -n "$wsl_host" ] && [ "$(printf '%s\n' "$wsl_host" | wc -l)" -eq 1 ] ||
  fail "the probes below need exactly one host of kind wsl, found: $wsl_host"
# Every self-booting host keeps the headless account, SSH and recovery class.
# The guests and the physical desktop also compose the graphical classes.
guest_hosts=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep " " (builtins.filter (n: hosts.${n}.kind == "vm") (builtins.attrNames hosts))')
headless_hosts=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep " " (builtins.filter (n: hosts.${n}.kind == "vm" || hosts.${n}.kind == "desktop") (builtins.attrNames hosts))')
utm_host=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.filter (n: hosts.${n}.hypervisor == "utm") (builtins.attrNames hosts))')
[ -n "$utm_host" ] && [ "$(printf '%s\n' "$utm_host" | wc -l)" -eq 1 ] ||
  fail "the probes below need exactly one UTM guest, found: $utm_host"
vmware_host=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.filter (n: hosts.${n}.hypervisor == "vmware") (builtins.attrNames hosts))')
[ -n "$vmware_host" ] && [ "$(printf '%s\n' "$vmware_host" | wc -l)" -eq 1 ] ||
  fail "the probes below need exactly one VMware guest, found: $vmware_host"
# The physical desktop, the one host of its kind.
desktop_host=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.filter (n: hosts.${n}.kind == "desktop") (builtins.attrNames hosts))')
[ -n "$desktop_host" ] && [ "$(printf '%s\n' "$desktop_host" | wc -l)" -eq 1 ] ||
  fail "the probes below need exactly one desktop, found: $desktop_host"
# The OrbStack machine, the one host of its kind.
orbstack_host=$(hosts_eval '{ }' 'hosts: builtins.concatStringsSep "\n" (builtins.filter (n: hosts.${n}.kind == "orbstack") (builtins.attrNames hosts))')
[ -n "$orbstack_host" ] && [ "$(printf '%s\n' "$orbstack_host" | wc -l)" -eq 1 ] ||
  fail "the probes below need exactly one OrbStack machine, found: $orbstack_host"
orbstack_user=$(hosts_eval '{ }' "hosts: hosts.\"$orbstack_host\".user")

# The invariant's other direction: the entry reaches its consumers through
# the typed option — the output is named by it, the host answers to it (#191)
# and takes its state version from it — so a mismatch means one of them
# carries an untyped copy instead.
printf '→ every NixOS host answers to the name its entry and its output carry\n'
exported=$(nix eval --raw "path:$repo#nixosConfigurations" \
  --apply 'configs: builtins.concatStringsSep "\n" (builtins.attrNames configs)')
[ "$exported" = "$nixos_hosts" ] ||
  fail "nixosConfigurations exports [$(echo $exported)], the inventory declares [$(echo $nixos_hosts)]"
for host in $nixos_hosts; do
  host_name=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".config.networking.hostName")
  [ "$host_name" = "$host" ] || fail "nixosConfigurations.$host declares networking.hostName $host_name"
  declared=$(hosts_eval '{ }' "hosts: hosts.\"$host\".stateVersion")
  applied=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".config.system.stateVersion")
  [ "$applied" = "$declared" ] || fail "nixosConfigurations.$host has state version $applied, its entry declares $declared"
  declared=$(hosts_eval '{ }' "hosts: hosts.\"$host\".system")
  applied=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".pkgs.stdenv.hostPlatform.system")
  [ "$applied" = "$declared" ] || fail "nixosConfigurations.$host targets $applied, its entry declares $declared"

  # The physical desktop and both VM guests are graphical. These markers make
  # a missing class or a leak into WSL or OrbStack fail at evaluation time.
  kind=$(hosts_eval '{ }' "hosts: hosts.\"$host\".kind")
  expected=false
  case "$kind" in desktop|vm) expected=true ;; esac
  for option in \
    programs.niri.enable \
    services.greetd.enable \
    services.pipewire.enable
  do
    graphical=$(nix eval --json "path:$repo#nixosConfigurations.\"$host\".config.$option")
    [ "$graphical" = "$expected" ] || fail "nixosConfigurations.$host has $option=$graphical, expected $expected for kind $kind"
  done
done

printf '→ accepts each combination a host lane names\n'
host_accepted x86_64-linux wsl null "$user" || fail "identity.nix refused an x86_64 WSL host"
host_accepted x86_64-linux vm '"vmware"' || fail "identity.nix refused an x86_64 VMware guest"
host_accepted aarch64-linux vm '"utm"' || fail "identity.nix refused an aarch64 UTM guest"
host_accepted aarch64-linux orbstack null || fail "identity.nix refused an aarch64 OrbStack machine"
host_accepted x86_64-linux desktop null || fail "identity.nix refused an x86_64 desktop"

# A refusal must be the combination rule's and name the host, or a typo in
# the fixture would pass as a refusal.
refused() {
  # refused <what> <expected message, a grep pattern> <fixture_host arguments>
  what=$1
  pattern=$2
  shift 2
  if host_accepted "$@"; then
    fail "identity.nix accepted $what"
  fi
  host_refusal "$@" | grep -q "$pattern" ||
    fail "identity.nix refused $what, but not with: $pattern"
}
printf '→ refuses every other combination, naming the host\n'
not_a_host='identity.nixosHosts.fixture-host: .* is not a host this repository configures'
refused "a vm without a hypervisor" "$not_a_host" x86_64-linux vm null
refused "a hypervisor on a WSL host" "$not_a_host" x86_64-linux wsl '"vmware"' "$user"
refused "a hypervisor on a desktop" "$not_a_host" x86_64-linux desktop '"vmware"'
refused "a hypervisor on an OrbStack machine" "$not_a_host" aarch64-linux orbstack '"utm"'
refused "VMware on aarch64" "$not_a_host" aarch64-linux vm '"vmware"'
refused "UTM on x86_64" "$not_a_host" x86_64-linux vm '"utm"'
refused "WSL on aarch64" "$not_a_host" aarch64-linux wsl null "$user"
refused "a desktop on aarch64" "$not_a_host" aarch64-linux desktop null
refused "OrbStack on x86_64" "$not_a_host" x86_64-linux orbstack null
refused "a WSL host under another account" \
  'identity.nixosHosts.fixture-host: a host of kind wsl receives the WSL home classes' \
  x86_64-linux wsl null someone-else
refused "a Darwin platform for a NixOS host" 'nixosHosts.fixture-host.system.* is not of type' aarch64-darwin desktop null
refused "a kind outside the enum" 'nixosHosts.fixture-host.kind.* is not of type' x86_64-linux laptop null
refused "a hypervisor outside the enum" 'nixosHosts.fixture-host.hypervisor.* is not of type' x86_64-linux vm '"hyperv"'
no_state_version=$(fixture_host x86_64-linux desktop null | sed 's/ stateVersion = "[^"]*";//')
if hosts_eval "$no_state_version" 'hosts: hosts.fixture-host.stateVersion' >/dev/null 2>&1; then
  fail "identity.nix accepted a host without a state version"
fi
hosts_eval "$no_state_version" 'hosts: hosts.fixture-host.stateVersion' 2>&1 >/dev/null |
  grep -q 'nixosHosts.fixture-host.stateVersion.* was accessed but has no value defined' ||
  fail "identity.nix refused a host without a state version, but not for the missing value"

# INV unixlike/nixos-host-inventory and INV unixlike/composition-in-one-place:
# host choices are typed separately from identity, and the one composition
# file accepts only profiles offered by that host's machine kind.
selection_eval() {
  nix eval --json --impure --expr "
    let
      inputs = (builtins.getFlake (toString ./.)).inputs;
      flake = inputs.flake-parts.lib.mkFlake { inherit inputs; } {
        imports = [
          (inputs.import-tree ./modules)
          { hostSelections.nixos.$1 = inputs.nixpkgs.lib.mkForce $2; }
        ];
      };
    in builtins.any
      (p: (p.pname or p.name) == \"codex\")
      flake.nixosConfigurations.$3.config.home-manager.users.\"$user\".home.packages"
}

printf '→ a host may omit an optional machine profile\n'
[ "$(selection_eval fixture-wsl.profiles '[]' fixture-wsl)" = false ] ||
  fail "NixOS-WSL retained the agents profile after opting out"

printf '→ a host may select an offered machine profile\n'
[ "$(selection_eval fixture-wsl.profiles '["agents"]' fixture-wsl)" = true ] ||
  fail "NixOS-WSL did not receive the selected agents profile"

printf '→ rejects a profile unavailable for the machine kind\n'
if selection_eval fixture-vm.profiles '["agents"]' fixture-vm >/dev/null 2>&1; then
  fail "the VMware machine accepted the agents profile"
fi

printf '→ rejects an unregistered host selection\n'
if selection_eval extra-host.profiles '[]' fixture-wsl >/dev/null 2>&1; then
  fail "a selection without an inventory host was accepted"
fi

printf '→ rejects a host without a selection\n'
if nix eval --raw --impure --expr '
  let
    inputs = (builtins.getFlake (toString ./.)).inputs;
    flake = inputs.flake-parts.lib.mkFlake { inherit inputs; } {
      imports = [
        (inputs.import-tree ./modules)
        { hostSelections.nixos = inputs.nixpkgs.lib.mkForce {
          fixture-utm.profiles = [];
          fixture-orbstack.profiles = [];
          fixture-vm.profiles = [];
          fixture-desktop.profiles = [];
        }; }
      ];
    };
  in flake.nixosConfigurations.fixture-wsl.config.system.build.toplevel.drvPath' >/dev/null 2>&1; then
  fail "a host without a selection was accepted"
fi

printf '→ rejects an unknown profile name\n'
if selection_eval fixture-wsl.profiles '["unlisted"]' fixture-wsl >/dev/null 2>&1; then
  fail "the host selection accepted an unknown profile name"
fi

printf '→ rejects a repeated profile\n'
if selection_eval fixture-wsl.profiles '["agents" "agents"]' fixture-wsl >/dev/null 2>&1; then
  fail "the host selection accepted a repeated profile"
fi

# ---------------------------------------------------------------------------
# Graphical classes reach graphical homes and stay out of the rest
# ---------------------------------------------------------------------------
#
# INV unixlike/desktop-not-wsl
# modules/flake/configurations.nix composes `homeManager.desktop` into the
# Darwin, physical desktop and VM guest homes. WezTerm is the cross-platform marker;
# Noctalia and XWayland Satellite mark the Linux graphical class. Their
# presence in a WSL or OrbStack home means a graphical class escaped its row.
# NixOS-WSL must also keep its Windows graphics-driver and graphical Start
# Menu integrations disabled.

packages_of() {
  nix eval --raw "path:$repo#$1" \
    --apply 'ps: builtins.concatStringsSep "\n" (map (p: p.pname or p.name) ps)'
}

wsl_user=$(identity_eval '{ }' wsl.user)
darwin_user=$(identity_eval '{ }' darwin.user)
darwin_host=$(identity_eval '{ }' darwin.hostName)

for home in \
  "homeConfigurations.\"$wsl_user\".config.home.packages" \
  "nixosConfigurations.\"$wsl_host\".config.home-manager.users.\"$wsl_user\".home.packages" \
  "nixosConfigurations.\"$orbstack_host\".config.home-manager.users.\"$orbstack_user\".home.packages"
do
  printf '→ %s carries no graphical program\n' "${home%%.config*}"
  names=$(packages_of "$home")
  for marker in wezterm noctalia xwayland-satellite; do
    if printf '%s\n' "$names" | grep -qx "$marker"; then
      fail "$home carries $marker, a graphical-class program"
    fi
  done
done

for option in useWindowsDriver startMenuLaunchers; do
  printf '→ NixOS-WSL keeps wsl.%s disabled\n' "$option"
  value=$(nix eval --json "path:$repo#nixosConfigurations.\"$wsl_host\".config.wsl.$option")
  [ "$value" = false ] || fail "NixOS-WSL enables wsl.$option"
done

printf '→ every graphical NixOS home carries both graphical classes\n'
for host in $desktop_host $guest_hosts; do
  user=$(hosts_eval '{ }' "hosts: hosts.\"$host\".user")
  graphical_home="nixosConfigurations.\"$host\".config.home-manager.users.\"$user\".home.packages"
  names=$(packages_of "$graphical_home")
  for marker in wezterm noctalia xwayland-satellite; do
    if ! printf '%s\n' "$names" | grep -qx "$marker"; then
      fail "$host has no $marker; its graphical classes are incomplete"
    fi
  done
done

printf '→ the Darwin home carries it\n'
darwin_home="darwinConfigurations.\"$darwin_host\".config.home-manager.users.\"$darwin_user\".home.packages"
names=$(packages_of "$darwin_home")
if ! printf '%s\n' "$names" | grep -qx wezterm; then
  fail "the Darwin home has no wezterm; the probe cannot see the desktop class"
fi

# ---------------------------------------------------------------------------
# The physical desktop has a portable machine contract
# ---------------------------------------------------------------------------
#
# INV unixlike/amd-apu-desktop-portable-base
# The real host proves every member of the portable contract in the positive
# direction. The assertion probes below replace one storage fact and one
# graphics fact to prove that the class refuses both kinds of drift.

printf '→ the physical desktop declares encrypted Btrfs and the AMD APU base\n'
desktop="nixosConfigurations.\"$desktop_host\""
shape=$(nix eval --raw --impure --expr "
  let
    flake = builtins.getFlake (toString ./.);
    config = flake.$desktop.config;
    contains = value: list: builtins.elem value list;
    mount = path: subvolume:
      config.fileSystems.\${path}.device == \"/dev/mapper/cryptroot\"
      && config.fileSystems.\${path}.fsType == \"btrfs\"
      && contains \"subvol=\${subvolume}\" config.fileSystems.\${path}.options
      && contains \"compress=zstd\" config.fileSystems.\${path}.options
      && contains \"noatime\" config.fileSystems.\${path}.options;
    luks = config.boot.initrd.luks.devices.cryptroot;
    facts = {
      uefi-boot = config.boot.loader.systemd-boot.enable && config.boot.loader.efi.canTouchEfiVariables;
      manual-luks = luks.device == \"/dev/disk/by-label/cryptroot\" && luks.keyFile == null && luks.crypttabExtraOpts == [];
      btrfs-root = mount \"/\" \"@\";
      btrfs-home = mount \"/home\" \"@home\";
      btrfs-nix = mount \"/nix\" \"@nix\";
      private-esp = config.fileSystems.\"/boot\".device == \"/dev/disk/by-label/boot\" && config.fileSystems.\"/boot\".fsType == \"vfat\" && contains \"umask=0077\" config.fileSystems.\"/boot\".options;
      zram-alone = config.swapDevices == [] && config.zramSwap.enable && config.zramSwap.algorithm == \"zstd\" && config.zramSwap.memoryPercent == 50;
      amdgpu-initrd = config.hardware.amdgpu.initrd.enable && contains \"amdgpu\" config.boot.initrd.kernelModules;
      amd-firmware = config.hardware.enableRedistributableFirmware && config.hardware.cpu.amd.updateMicrocode;
      mesa-graphics = config.hardware.graphics.enable && config.hardware.graphics.enable32Bit && (config.hardware.graphics.package.pname or \"\") == \"mesa\";
      network-manager = config.networking.networkmanager.enable && !config.networking.useDHCP;
      headless-recovery = config.services.openssh.enable && config.networking.firewall.allowedTCPPorts == [22];
      niri-session = config.programs.niri.enable && config.services.greetd.enable;
    };
  in builtins.concatStringsSep \" \" (builtins.filter (n: !facts.\${n}) (builtins.attrNames facts))")
[ -z "$shape" ] || fail "nixosConfigurations.$desktop_host does not hold: $shape"

if [ -e "$repo/modules/machines/hardware-configuration.nix" ] ||
  grep -R -E '/dev/disk/by-uuid|UUID=' "$repo/modules/machines/desktop.nix" "$repo/modules/machines/amd-apu.nix" >/dev/null
then
  fail "the physical desktop carries an unreviewed generated hardware file or UUID"
fi

# Evaluates the failed assertions of a configuration extended with one more
# module. The extension is `extendModules`, so the real configuration is
# what is evaluated, plus the one definition each case adds. Two shapes of
# refusal exist and both are kept apart from an unrelated evaluation error:
# Home Manager turns a failed assertion into an evaluation error headed
# `Failed assertions:` as soon as `config` is read, while NixOS and
# nix-darwin report theirs through `config.assertions`, so a refusal there
# is a clean evaluation whose output names the tag. Leaves the status, the
# output and the diagnostics in three variables for the two checks below.
failed_assertions() {
  assertion_status=0
  assertion_output=$(nix eval --raw --impure --expr "
    let
      flake = builtins.getFlake (toString ./.);
      lib = flake.inputs.nixpkgs.lib;
      configuration = flake.$1;
      extended = configuration.extendModules { modules = [ ($2) ]; };
      failed = builtins.filter (a: !a.assertion) extended.config.assertions;
    in builtins.concatStringsSep \"\n\" (map (a: a.message) failed)" \
    2>"$assertion_diagnostics") || assertion_status=$?
}

expect_refusal() {
  tag=$1
  what=$2
  if [ "$assertion_status" -eq 0 ]; then
    printf '%s\n' "$assertion_output" | grep -q "$tag" && return 0
  elif grep -q 'Failed assertions:' "$assertion_diagnostics"; then
    grep -q "$tag" "$assertion_diagnostics" && return 0
  fi
  printf '%s\n' "$assertion_output" >&2
  cat "$assertion_diagnostics" >&2
  fail "$what was not refused by $tag"
}

expect_clean() {
  what=$1
  if [ "$assertion_status" -ne 0 ] || [ -n "$assertion_output" ]; then
    printf '%s\n' "$assertion_output" >&2
    cat "$assertion_diagnostics" >&2
    fail "$what fails an assertion or does not evaluate"
  fi
}

assertion_diagnostics=$(mktemp)
trap 'rm -f "$assertion_diagnostics"' EXIT

printf '→ refuses a physical desktop with a different encrypted root device\n'
failed_assertions "$desktop" '{lib, ...}: { boot.initrd.luks.devices.cryptroot.device = lib.mkForce "/dev/sda2"; }'
expect_refusal 'INV unixlike/amd-apu-desktop-portable-base' 'a physical desktop with a different encrypted root device'

printf '→ refuses a physical desktop without early AMDGPU loading\n'
failed_assertions "$desktop" '{lib, ...}: { hardware.amdgpu.initrd.enable = lib.mkForce false; }'
expect_refusal 'INV unixlike/amd-apu-desktop-portable-base' 'a physical desktop without early AMDGPU loading'

printf '→ the real physical desktop satisfies its portable base assertions\n'
failed_assertions "$desktop" '{ }'
expect_clean 'the physical desktop'

# ---------------------------------------------------------------------------
# Installation layouts retain an inert target
# ---------------------------------------------------------------------------
#
# INV unixlike/install-target-explicit
# The real installable hosts keep a deliberately unusable by-id target until
# install-plan creates a reviewed wrapper. The schema must also refuse a
# kernel-order path even when another module tries to force one into a host.

vmware="nixosConfigurations.\"$vmware_host\""

printf '→ every installable host retains one inert persistent target\n'
for host in $vmware_host $utm_host $desktop_host; do
  target=$(nix eval --raw "path:$repo#nixosConfigurations.\"$host\".config.disko.devices.disk.main.device")
  [ "$target" = /dev/disk/by-id/INSTALL_TARGET_REQUIRED ] ||
    fail "nixosConfigurations.$host selected an installation target: $target"
  enabled=$(nix eval --json "path:$repo#nixosConfigurations.\"$host\".config.disko.enableConfig")
  [ "$enabled" = false ] || fail "nixosConfigurations.$host lets disko replace its runtime mounts"
done

for host in $vmware_host $utm_host; do
  partitions="nixosConfigurations.\"$host\".config.disko.devices.disk.main.content.partitions"
  [ "$(nix eval --raw "path:$repo#$partitions.ESP.content.format")" = vfat ] ||
    fail "nixosConfigurations.$host has no vfat EFI installation partition"
  [ "$(nix eval --raw "path:$repo#$partitions.root.content.format")" = ext4 ] ||
    fail "nixosConfigurations.$host has no ext4 installation root"
done

desktop_luks="nixosConfigurations.\"$desktop_host\".config.disko.devices.disk.main.content.partitions.cryptroot.content"
