#!/usr/bin/env python3
"""Read evaluated program selection; never query or modify installed state."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('target', nargs='?', help='Flake#configuration (for example path:./unixlike#homeConfigurations.example)')
parser.add_argument('--catalog', action='store_true', help='Show all provider definitions instead of a final configuration')
parser.add_argument('--flake', default='path:' + str(Path(__file__).resolve().parents[1]))
parser.add_argument('--json', action='store_true')
args = parser.parse_args()
if args.catalog:
    if args.target:
        parser.error('--catalog takes --flake, not a configuration target')
    target = args.flake + '#lib.programCatalog'
elif args.target and '#' in args.target:
    target = args.target
    if '#homeConfigurations.' in target:
        target += '.config.providerTools.inventory'
    elif '#nixosConfigurations.' in target or '#darwinConfigurations.' in target:
        target += '.config.providerTools.inventory'
    else:
        parser.error('select homeConfigurations, nixosConfigurations or darwinConfigurations')
else:
    parser.error('provide Flake#configuration or --catalog')
result = subprocess.run(['nix', 'eval', '--json', '--no-write-lock-file', target], text=True, capture_output=True)
if result.returncode:
    sys.stderr.write(result.stderr)
    sys.exit(result.returncode)
data = json.loads(result.stdout)
if args.json or args.catalog:
    print(json.dumps(data, indent=2, sort_keys=True))
else:
    columns = [
        'id', 'group', 'profiles', 'deployment', 'kind', 'supported', 'available',
        'selected', 'provider', 'requestedVersion', 'lockedVersion', 'owner', 'source',
    ]

    def display(value):
        if value is None:
            return '-'
        if isinstance(value, list):
            return ','.join(value)
        return str(value)

    rows = [[display(row.get(key)) for key in columns] for row in data]
    widths = [max(len(key), *(len(row[i]) for row in rows)) for i, key in enumerate(columns)]
    for row in [columns] + rows:
        print('  '.join(value.ljust(width) for value, width in zip(row, widths)).rstrip())
