            emphasis_0 188 82 21
            emphasis_1 36 131 123
            emphasis_2 102 128 11
            emphasis_3 94 64 157
        }
        list_selected {
            base 64 62 60
            background 218 216 206
            emphasis_0 188 82 21
            emphasis_1 36 131 123
            emphasis_2 102 128 11
            emphasis_3 94 64 157
        }
        list_unselected {
            base 64 62 60
            background 230 228 217
            emphasis_0 188 82 21
            emphasis_1 36 131 123
            emphasis_2 102 128 11
            emphasis_3 94 64 157
        }
        frame_unselected {
            base 183 181 172
            background 0
            emphasis_0 188 82 21
            emphasis_1 36 131 123
            emphasis_2 94 64 157
            emphasis_3 0
        }
        frame_selected {
            base 173 131 1
            background 0
            emphasis_0 188 82 21
            emphasis_1 36 131 123
            emphasis_2 94 64 157
            emphasis_3 0
        }
        frame_highlight {
            base 188 82 21
            background 0
            emphasis_0 94 64 157
            emphasis_1 188 82 21
            emphasis_2 188 82 21
            emphasis_3 188 82 21
        }
        exit_code_success {
            base 102 128 11
            background 0
            emphasis_0 36 131 123
            emphasis_1 230 228 217
            emphasis_2 94 64 157
            emphasis_3 32 94 166
        }
        exit_code_error {
            base 175 48 41
            background 0
            emphasis_0 173 131 1
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 94 64 157
            player_2 32 94 166
            player_3 0
            player_4 173 131 1
            player_5 36 131 123
            player_6 0
            player_7 175 48 41
            player_8 0
            player_9 0
            player_10 0
        }
    }
    flexoki-dark {
        text_unselected {
            base 206 205 195
            background 40 39 38
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        text_selected {
            base 255 252 240
            background 52 51 49
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        ribbon_selected {
            base 40 39 38
            background 208 162 21
            emphasis_0 16 15 15
            emphasis_1 175 48 41
            emphasis_2 94 64 157
            emphasis_3 32 94 166
        }
        ribbon_unselected {
            base 40 39 38
            background 183 181 172
            emphasis_0 64 62 60
            emphasis_1 175 48 41
            emphasis_2 32 94 166
            emphasis_3 175 48 41
        }
        table_title {
            base 208 162 21
            background 0
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        table_cell_selected {
            base 206 205 195
            background 52 51 49
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        table_cell_unselected {
            base 206 205 195
            background 40 39 38
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        list_selected {
            base 206 205 195
            background 52 51 49
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        list_unselected {
            base 206 205 195
            background 40 39 38
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 135 154 57
            emphasis_3 139 126 200
        }
        frame_unselected {
            base 87 86 83
            background 0
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 139 126 200
            emphasis_3 0
        }
        frame_selected {
            base 208 162 21
            background 0
            emphasis_0 218 112 44
            emphasis_1 58 169 159
            emphasis_2 139 126 200
            emphasis_3 0
        }
        frame_highlight {
            base 218 112 44
            background 0
            emphasis_0 139 126 200
            emphasis_1 218 112 44
            emphasis_2 218 112 44
            emphasis_3 218 112 44
        }
        exit_code_success {
            base 135 154 57
