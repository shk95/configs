keybinds clear-defaults=true {
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
    normal {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl p" { SwitchToMode "pane"; }
        bind "Ctrl t" { SwitchToMode "tab"; }
        bind "Ctrl h" { SwitchToMode "move"; }
        bind "Ctrl r" { SwitchToMode "resize"; }
        bind "Ctrl s" { SwitchToMode "scroll"; }
        bind "Ctrl o" { SwitchToMode "session"; }
        bind "Ctrl q" { Quit; }
    }
    pane {
        bind "h" "left" { MoveFocus "left"; }
        bind "j" "down" { MoveFocus "down"; }
        bind "k" "up" { MoveFocus "up"; }
        bind "l" "right" { MoveFocus "right"; }
        bind "p" { SwitchFocus; }
        bind "n" { NewPane; SwitchToMode "locked"; }
        bind "d" { NewPane "down"; SwitchToMode "locked"; }
        bind "r" { NewPane "right"; SwitchToMode "locked"; }
        bind "s" { NewPane "stacked"; SwitchToMode "locked"; }
        bind "x" { CloseFocus; SwitchToMode "locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "i" { TogglePanePinned; SwitchToMode "locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "locked"; }
        bind "c" { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "esc" { SwitchToMode "locked"; }
    }
    move {
        bind "h" "left" { MovePane "left"; }
        bind "j" "down" { MovePane "down"; }
        bind "k" "up" { MovePane "up"; }
        bind "l" "right" { MovePane "right"; }
        bind "n" "tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "esc" { SwitchToMode "locked"; }
    }
    tab {
        bind "h" "left" { GoToPreviousTab; }
        bind "l" "right" { GoToNextTab; }
        bind "H" { MoveTab "left"; }
        bind "L" { MoveTab "right"; }
        bind "n" { NewTab; SwitchToMode "locked"; }
        bind "x" { CloseTab; SwitchToMode "locked"; }
        bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "locked"; }
        bind "b" { BreakPane; SwitchToMode "locked"; }
        bind "[" { BreakPaneLeft; SwitchToMode "locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "locked"; }
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }
        bind "tab" { ToggleTab; }
        bind "esc" { SwitchToMode "locked"; }
    }
    renamepane {
        bind "enter" "Ctrl c" { SwitchToMode "locked"; }
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
    renametab {
        bind "enter" "Ctrl c" { SwitchToMode "locked"; }
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    resize {
        bind "h" "left" { Resize "Increase left"; }
        bind "j" "down" { Resize "Increase down"; }
        bind "k" "up" { Resize "Increase up"; }
        bind "l" "right" { Resize "Increase right"; }
        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "+" "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "esc" { SwitchToMode "locked"; }
    }
    scroll {
        bind "j" "down" { ScrollDown; }
        bind "k" "up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "s" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Ctrl c" "esc" { ScrollToBottom; SwitchToMode "locked"; }
    }
    entersearch {
        bind "enter" { SwitchToMode "search"; }
        bind "Ctrl c" "esc" { SwitchToMode "scroll"; }
    }
    search {
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "Ctrl c" "esc" { ScrollToBottom; SwitchToMode "locked"; }
    }
    session {
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "c" {
            LaunchOrFocusPlugin "zellij:configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "esc" { SwitchToMode "locked"; }
    }
}

default_mode "locked"
default_shell "zsh"
copy_clipboard "system"
copy_on_select true
session_name "unixlike"
attach_to_session true
on_force_close "detach"
show_startup_tips false
show_release_notes false

// Colours are named here rather than left to the host, because zellij's
// built-in fallback palette is dark — `default_palette()` in zellij-utils is
// literally `theme_hue: ThemeHue::Dark` — so declaring nothing keeps the pane
// frames, tab bar and status line dark inside a light terminal. Naming a light
// theme is no longer the guess it once was: every home
// modules/flake/configurations.nix composes renders inside a terminal whose
// colour scheme a file of this repository declares, and the two that never
// report that scheme — WezTerm and Windows Terminal — are both set to Flexoki
// Light, so the static line at the end of this file tells them what is already
// true rather than guessing at it. Ghostty reports and drives the pair itself.
// The premise is recorded once, with the declaring files and the condition
// that would reopen it, in
// docs/decisions/composed-homes-render-in-declared-terminals.md.
//
// Two settings carry it, and they do not fight. `theme_dark` and `theme_light`
// are the terminal-driven pair: with both configured, zellij swaps palettes
// from the host terminal's own colour-scheme report (CSI 2031 / DSR 997), and
// with only one of them it ignores both. The plain `theme` at the end of this
// file is the static answer for a terminal that never sends that report, and
// it is authoritative only until one arrives, so it costs a reporting terminal
// nothing. `flexoki-light` is the light member of the family every declaring
// terminal is set to; `flexoki-dark` is named as the other branch of the pair,
// the palette a terminal reporting dark would be given, not as a theme this
// repository selects.
//
// Unlike the Catppuccin pair this replaces, only one half resolves against a
// zellij built-in: the pinned zellij-utils ships `flexoki-dark` (checked in
// its `assets/themes/`) but no `flexoki-light` counterpart, so both are
// defined explicitly below rather than leaving one to a builtin that may not
// keep shipping and the other to one that does not exist yet. `flexoki-dark`
// below is copied byte-for-byte from that builtin so the pair stays visually
// consistent; `flexoki-light` is derived from it by the same rule applied to
// every field: each neutral (`base-900`, `base-200`, ...) is swapped for its
// mirror position in Flexoki's fifteen-stop scale (black/paper at the poles,
// `base-500` at the centre — e.g. `base-900` <-> `base-100`), and each accent
// is swapped from Flexoki's 400 (dark-normal) family to its same-hue 600
// (light-normal) family. The two ribbon components' `emphasis_1..3` push past
// their own family (to a 600-family accent) for contrast against an already
// bright ribbon background in `flexoki-dark`; `flexoki-light` mirrors that
// push the only way the palette allows, by using the black pole outright,
// since Flexoki names no accent family darker than 600. See
// https://github.com/kepano/flexoki for the source palette.
//
// Which terminals actually answer that query is the part to be exact about:
// the pair is inert without an answer, and the static `theme` is what every
// silent terminal ends up rendering.
//
//   Ghostty            answers — its binary carries the `[?996` / `[?997`
//                      sequences and a `color_scheme_updates` mode, so the
//                      pair takes over as soon as its reply lands.
//   WezTerm            does not. The pinned build has no colour-scheme private
//                      mode in its `DecPrivateModeCode` list at all, so the
//                      query goes unanswered.
//   Windows Terminal   does not either, as of 1.23.20211.0 — installed as
//                      the package
//                      `Microsoft.WindowsTerminal_1.23.20211.0_x64__8wekyb3d8bbwe`.
//                      Probed on 2026-09-05 from a plain tab outside zellij,
//                      which would otherwise intercept the reply:
//                      `printf '\033[?996n\033[c'` came back with the DA1
//                      answer `?61;4;6;7;14;21;22;23;24;28;32;42;52c` alone
//                      and no `?997;1n` or `?997;2n` in front of it.
//
// Two of the three are silent, so the static `theme` below is what the WezTerm
// desktops and the WSL homes actually render. It lives in this file rather
// than in modules/zellij.nix because every composed home now needs the same
// line for the same reason, and this is the one place the keymap and the
// palettes already live.
themes {
    flexoki-light {
        text_unselected {
            base 28 27 26
            background 255 252 240
            emphasis_0 218 112 44
            emphasis_1 36 131 123
            emphasis_2 102 128 11
            emphasis_3 206 93 151
        }
        text_selected {
            base 28 27 26
            background 206 205 195
            emphasis_0 218 112 44
            emphasis_1 36 131 123
            emphasis_2 102 128 11
