keybinds clear-defaults=true {
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
    normal {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl p" { SwitchToMode "pane"; }
        bind "Ctrl t" { SwitchToMode "tab"; }
        bind "Ctrl h" { SwitchToMode "move"; }
        bind "Ctrl r" { SwitchToMode "resize"; }
        bind "Ctrl s" { SwitchToMode "scroll"; }
        bind "Ctrl o" { SwitchToMode "session"; }
        bind "Ctrl q" { Quit; }
    }
    pane {
        bind "h" "left" { MoveFocus "left"; }
        bind "j" "down" { MoveFocus "down"; }
        bind "k" "up" { MoveFocus "up"; }
        bind "l" "right" { MoveFocus "right"; }
        bind "p" { SwitchFocus; }
        bind "n" { NewPane; SwitchToMode "locked"; }
        bind "d" { NewPane "down"; SwitchToMode "locked"; }
        bind "r" { NewPane "right"; SwitchToMode "locked"; }
        bind "s" { NewPane "stacked"; SwitchToMode "locked"; }
        bind "x" { CloseFocus; SwitchToMode "locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "i" { TogglePanePinned; SwitchToMode "locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "locked"; }
        bind "c" { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "esc" { SwitchToMode "locked"; }
    }
    move {
        bind "h" "left" { MovePane "left"; }
        bind "j" "down" { MovePane "down"; }
        bind "k" "up" { MovePane "up"; }
        bind "l" "right" { MovePane "right"; }
        bind "n" "tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "esc" { SwitchToMode "locked"; }
    }
    tab {
        bind "h" "left" { GoToPreviousTab; }
        bind "l" "right" { GoToNextTab; }
        bind "H" { MoveTab "left"; }
        bind "L" { MoveTab "right"; }
        bind "n" { NewTab; SwitchToMode "locked"; }
        bind "x" { CloseTab; SwitchToMode "locked"; }
        bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "locked"; }
        bind "b" { BreakPane; SwitchToMode "locked"; }
        bind "[" { BreakPaneLeft; SwitchToMode "locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "locked"; }
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }
        bind "tab" { ToggleTab; }
        bind "esc" { SwitchToMode "locked"; }
    }
    renamepane {
        bind "enter" "Ctrl c" { SwitchToMode "locked"; }
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
    renametab {
        bind "enter" "Ctrl c" { SwitchToMode "locked"; }
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    resize {
        bind "h" "left" { Resize "Increase left"; }
        bind "j" "down" { Resize "Increase down"; }
        bind "k" "up" { Resize "Increase up"; }
        bind "l" "right" { Resize "Increase right"; }
        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "+" "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "esc" { SwitchToMode "locked"; }
    }
    scroll {
        bind "j" "down" { ScrollDown; }
        bind "k" "up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "s" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Ctrl c" "esc" { ScrollToBottom; SwitchToMode "locked"; }
    }
    entersearch {
        bind "enter" { SwitchToMode "search"; }
        bind "Ctrl c" "esc" { SwitchToMode "scroll"; }
    }
    search {
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "Ctrl c" "esc" { ScrollToBottom; SwitchToMode "locked"; }
    }
    session {
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "c" {
            LaunchOrFocusPlugin "zellij:configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked";
        }
        bind "esc" { SwitchToMode "locked"; }
    }
}

// Windows Terminal 1.23 was probed on 2026-09-05 and does not answer the
// colour-scheme query that zellij's auto-switching theme_light/theme_dark
// pair depends on, so this static theme is what actually renders inside it.
// Only the light member is declared and selected: with no report arriving,
// a dark member here would be state nothing on this terminal could reach.
theme "modus-operandi"

default_mode "locked"
default_shell "pwsh.exe"
copy_clipboard "system"
copy_on_select true
session_name "win-env"
attach_to_session true
on_force_close "detach"
show_startup_tips false
show_release_notes false

// Copied from the Unix-like asset `assets/zellij/config.kdl` on 2026-09-05,
// when the Unix-like domain replaced Flexoki Light with Modus Operandi
// (#163); this domain owns the copy from here and may diverge from it. Only
// the light member is copied: the Unix-like asset carries a light/dark pair
// for terminals that report their scheme, and the terminal this payload
// renders in does not, so a dark member here would be unreachable state.
themes {
    modus-operandi {
        text_unselected {
            base 0 0 0
            background 255 255 255
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        text_selected {
            base 0 0 0
            background 189 189 189
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        ribbon_selected {
            base 255 255 255
            background 0 104 0
            emphasis_0 255 255 255
            emphasis_1 189 189 189
            emphasis_2 255 255 255
            emphasis_3 189 189 189
        }
        ribbon_unselected {
            base 255 255 255
            background 89 89 89
            emphasis_0 255 255 255
            emphasis_1 189 189 189
            emphasis_2 255 255 255
            emphasis_3 189 189 189
        }
        table_title {
            base 0 104 0
            background 255 255 255
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        table_cell_selected {
            base 0 0 0
            background 189 189 189
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        table_cell_unselected {
            base 0 0 0
            background 255 255 255
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        list_selected {
            base 0 0 0
            background 189 189 189
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        list_unselected {
            base 0 0 0
            background 255 255 255
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        frame_selected {
            base 0 104 0
            background 0
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 114 16 69
            emphasis_3 0
        }
        frame_highlight {
            base 151 37 0
            background 0
            emphasis_0 166 0 0
            emphasis_1 83 26 182
            emphasis_2 151 37 0
            emphasis_3 151 37 0
        }
        frame_unselected {
            base 89 89 89
            background 0
            emphasis_0 151 37 0
            emphasis_1 0 94 139
            emphasis_2 114 16 69
            emphasis_3 0
        }
        exit_code_success {
            base 0 104 0
            background 0
            emphasis_0 0 94 139
            emphasis_1 255 255 255
            emphasis_2 114 16 69
            emphasis_3 0 49 169
        }
        exit_code_error {
            base 166 0 0
            background 0
            emphasis_0 111 85 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 114 16 69
            player_2 0 49 169
            player_3 0 94 139
            player_4 111 85 0
            player_5 0 104 0
            player_6 83 26 182
            player_7 166 0 0
            player_8 136 73 0
            player_9 0
            player_10 0
        }
    }
}
