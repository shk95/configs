            emphasis_1 0 0 0
            emphasis_2 0 0 0
            emphasis_3 0 0 0
        }
        multiplayer_user_colors {
            player_1 160 47 111
            player_2 32 94 166
            player_3 36 131 123
            player_4 188 82 21
            player_5 102 128 11
            player_6 94 64 157
            player_7 175 48 41
            player_8 173 131 1
            player_9 0 0 0
            player_10 0 0 0
        }
    }
}
