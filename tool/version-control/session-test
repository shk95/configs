#!/bin/sh
# INV repository/worker-checkpoint
# INV repository/fixture-git-isolation
set -eu
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$root/tool/version-control/fixture-git-environment.sh"
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT HUP INT TERM
git init -q -b master "$fixture/repo"
cd "$fixture/repo"
git config user.name Fixture
git config user.email fixture@example.invalid
mkdir -p tool/version-control
cp "$root/tool/work-session.sh" tool/
for source in authoring policy policy.json repo_policy.py; do
  cp "$root/tool/version-control/$source" tool/version-control/
done
printf '/.work-session.md\n/.work-session.lock/\n' > .gitignore
git add .
git -c core.hooksPath=/dev/null commit -qm 'test(repository): fixture'
# Legacy text is preserved verbatim by inspection. No lifecycle is inferred.
printf '# Worker checkpoint\nstate: abandoned\nsession-id: legacy\n\nRemaining: review\n' > .work-session.md
before=$(git hash-object .work-session.md)
sh tool/work-session.sh inspect > "$fixture/inspection"
grep -q '^state: abandoned$' "$fixture/inspection"
grep -q '^Remaining: review$' "$fixture/inspection"
grep -q 'not policy, approval, liveness or cleanup permission' "$fixture/inspection"
! grep -q 'Resume guidance' "$fixture/inspection"
[ "$before" = "$(git hash-object .work-session.md)" ]
# Empty input and retired verbs cannot replace existing notes.
for content in '' '   '; do
  if printf '%s\n' "$content" | sh tool/work-session.sh save >/dev/null 2>&1; then
    echo 'empty handoff accepted' >&2; exit 1
  fi
  [ "$before" = "$(git hash-object .work-session.md)" ]
  [ ! -e .work-session.lock ]
done
for command in start recover replan checkpoint; do
  if printf 'replace\n' | sh tool/work-session.sh "$command" >/dev/null 2>&1; then
    echo 'retired session verb accepted' >&2; exit 1
  fi
  [ "$before" = "$(git hash-object .work-session.md)" ]
done
mkdir .work-session.lock
printf 'preserve owner\n' > .work-session.lock/owner
if printf 'replace\n' | sh tool/work-session.sh save >/dev/null 2>&1; then
  echo 'existing write lock ignored' >&2; exit 1
fi
[ "$before" = "$(git hash-object .work-session.md)" ]
grep -q '^preserve owner$' .work-session.lock/owner
rm .work-session.lock/owner
rmdir .work-session.lock
# Explicit save intentionally replaces old notes with exactly the supplied text.
printf 'Goal: fixture\nEvidence: not yet verified\nNext: inspect\n' > "$fixture/new-note"
sh tool/work-session.sh save < "$fixture/new-note" >/dev/null
cmp .work-session.md "$fixture/new-note"
[ ! -e .work-session.lock ]
[ -z "$(git status --porcelain)" ]
before=$(git hash-object .work-session.md)
git add -f .work-session.md
if printf 'replace\n' | sh tool/work-session.sh save >/dev/null 2>&1; then
  echo 'tracked checkpoint accepted' >&2; exit 1
fi
[ "$before" = "$(git hash-object .work-session.md)" ]
git rm --cached -q .work-session.md
printf '/.work-session.lock/\n' > .gitignore
if printf 'replace\n' | sh tool/work-session.sh save >/dev/null 2>&1; then
  echo 'unignored checkpoint accepted' >&2; exit 1
fi
[ "$before" = "$(git hash-object .work-session.md)" ]
git checkout -- .gitignore
mv .work-session.md "$fixture/original"
ln -s "$fixture/original" .work-session.md
if printf 'replace\n' | sh tool/work-session.sh save >/dev/null 2>&1; then
  echo 'symlink checkpoint accepted' >&2; exit 1
fi
[ "$before" = "$(git hash-object "$fixture/original")" ]
sh tool/work-session.sh inspect > "$fixture/symlink-inspection"
! grep -q '^Goal: fixture$' "$fixture/symlink-inspection"
rm .work-session.md
mkdir .work-session.md
if printf 'replace\n' | sh tool/work-session.sh save >/dev/null 2>&1; then
  echo 'directory checkpoint accepted' >&2; exit 1
fi
[ -z "$(ls -A .work-session.md)" ]
echo 'local handoff save/inspect fixtures passed'
