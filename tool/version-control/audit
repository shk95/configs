#!/bin/sh

# Audit committed history and clone-local version-control policy. Read-only.
#
# usage: tool/version-control/audit [--history [<revision>...]]
#
# Full and history modes diagnose accepted history on request. The delivery
# range checks incoming commits and merge effects without revisiting that history.
#
# INV repository/flake-lock-isolated, INV repository/release-tag-contract
# INV repository/hooks-are-the-tracked-ones
# INV repository/conventional-subject — subjects are judged by
# .githooks/commit-msg, the grammar's only owner.
#
# Exit 0 verified, 69 unverified (no master ref), any other status failed.

set -eu
export GIT_NO_REPLACE_OBJECTS=1

usage() {
  echo "usage: tool/configs audit [--history [<revision>...] | --secrets-history | --range <base> <tip> | --tag <name>]" >&2
  exit 2
}
mode=full
range_base=
range_tip=
selected_tag=
if [ "$#" -gt 0 ]; then
  case "$1" in
    --history) mode=history; shift ;;
    --secrets-history) [ "$#" -eq 1 ] || usage; mode=secrets; shift ;;
    --range)
      [ "$#" -eq 3 ] || usage
      mode=range; range_base=$2; range_tip=$3; shift 3 ;;
    --tag)
      [ "$#" -eq 2 ] || usage
      mode=tag; selected_tag=$2; shift 2 ;;
    *) usage ;;
  esac
fi
for revision in "$@"; do
  case "$revision" in -*) usage ;; esac
done

# Guards this script's sed/grep/awk calls from Git for Windows' MSYS argument
# conversion (#79); see tool/version-control/hygiene. Inert elsewhere.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

# Resolved before the directory changes: the checks beside this file read the
# repository being audited, so the fixtures run them against a throwaway one.
audit_tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(git rev-parse --show-toplevel)
cd "$root"
if [ "$mode" = secrets ]; then
  exec "$audit_tools/scan-secrets" --all
fi

warnings=0
failures=0

ok() {
  printf 'ok: %s\n' "$1"
}

warn() {
  printf 'warning: %s\n' "$1"
  warnings=$((warnings + 1))
}

fail() {
  printf 'failure: %s\n' "$1" >&2
  failures=$((failures + 1))
}

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo detached)
printf 'branch: %s\n' "$branch"

if [ "$mode" = full ]; then
  if [ -n "$(git status --porcelain)" ]; then
    warn "working tree has uncommitted changes"
  else
    ok "working tree is clean"
  fi
fi

. "$audit_tools/hooks.sh"
. "$audit_tools/incoming-range.sh"

if [ "$mode" = full ]; then
  if hooks_enabled; then
    ok "clone runs the tracked hooks ($(git config --get core.hooksPath))"
  else
    fail "core.hooksPath is '$(git config --get core.hooksPath || echo unset)' and does not resolve to .githooks"
  fi
fi

# Full diagnostics prefer local master; remote-history diagnostics prefer the
# fetched snapshot. Neither fetches nor relies on a dev ref.
ref_of() {
  if [ "$mode" = history ] && git show-ref --verify --quiet "refs/remotes/origin/$1"; then
    printf 'origin/%s\n' "$1"
  elif git show-ref --verify --quiet "refs/heads/$1"; then
    printf '%s\n' "$1"
  elif git show-ref --verify --quiet "refs/remotes/origin/$1"; then
    printf 'origin/%s\n' "$1"
  fi
}
master_ref=
if [ "$mode" != range ]; then master_ref=$(ref_of master); fi
unverified=0
required_refs=master
[ "$mode" != tag ] || required_refs=master
[ "$mode" != range ] || required_refs=
for required in $required_refs; do
  eval "resolved=\$${required}_ref"
  if [ -n "$resolved" ]; then
    ok "$required resolves to $resolved"
  else
    printf '· unverified: no local or origin/%s ref in this clone\n' "$required"
    unverified=1
  fi
done

if [ "$mode" = full ]; then
  for local_branch in $(git for-each-ref --format='%(refname:short)' refs/heads); do
    case "$local_branch" in
      master) ;;
      dev) ;; # retained legacy ref, never an authoring basis
      backup|backup/*) warn "local backup branch remains: $local_branch" ;;
      *)
        if "$audit_tools/authoring" -- "$local_branch"; then
          ok "branch name follows policy: $local_branch"
        else
          fail "branch name does not follow policy: $local_branch"
        fi
        ;;
    esac
  done
fi

commit_msg_hook="$root/.githooks/commit-msg"
commits=$(mktemp)
subject_file=$(mktemp)
trap 'rm -f "$commits" "$subject_file"' EXIT
if [ "$mode" = range ]; then
  incoming_range "$range_base" "$range_tip"
  subject_scope=$range_walk
  git log "$range_walk" --no-merges --format='%H%x09%s' >"$commits"
  # The full body, including merges, is checked once by the grammar owner.
  "$audit_tools/closing-keywords" --range "$range_base" "$range_tip" ||
    fail "incoming history has a refused or unverified commit message"
elif [ "$mode" != tag ]; then
  subject_tips=$(git rev-parse HEAD)
  subject_scope=master,HEAD
  for revision in "$@"; do
    if resolved_revision=$(git rev-parse --verify --quiet "$revision^{commit}"); then
      subject_tips="$subject_tips $resolved_revision"
      subject_scope="$subject_scope, $revision"
    else
      fail "revision to judge does not name a commit: $revision"
    fi
  done
  git log $master_ref $subject_tips --no-merges --format='%H%x09%s' >"$commits"
fi
if [ "$mode" != tag ] && [ -s "$commits" ] && [ ! -x "$commit_msg_hook" ]; then
  warn "commit subject checker is unavailable"
  unverified=1
elif [ "$mode" != tag ] && [ -s "$commits" ]; then
  tab=$(printf '\t')
  commit_failures=$failures
  while IFS="$tab" read -r sha subject; do
    printf '%s\n' "$subject" >"$subject_file"
    if "$commit_msg_hook" "$subject_file" --subject-only >/dev/null 2>&1; then
      :
    else
      fail "commit subject rejected by .githooks/commit-msg $sha: $subject"
    fi
  done <"$commits"
  if [ "$failures" -eq "$commit_failures" ]; then
    ok "non-merge commit subjects on $subject_scope follow policy"
  fi
fi

# The annotation of a release tag, one defect per line and nothing when it
# follows the form. Windows states evidence per host. Unix-like provider and
# common tags state the three lanes at domain level; their releases certify no
# real host. A lane's value opens with one of three states. Historical tags
# before these forms are excepted below by immutable name.
annotation_defects() {
  git for-each-ref --format='%(contents)' "refs/tags/$1" | awk -v domain="$2" '
    function close_block(   i) {
      if (!in_block) return
      for (i = 1; i <= 3; i++)
        if (seen[lanes[i]] == 0) print "host " label " lacks " lanes[i]
      in_block = 0
    }
    BEGIN { lanes[1] = "Evaluation"; lanes[2] = "Build"; lanes[3] = "Native runtime" }
    { sub(/^[ \t]+/, ""); sub(/[ \t\r]+$/, "") }
    $0 == "Domain: " domain { domain_seen = 1; next }
    /^Host:/ {
      close_block()
      label = $0; sub(/^Host:[ \t]*/, "", label)
      in_block = 1; hosts++
      for (i = 1; i <= 3; i++) seen[lanes[i]] = 0
      if (domain != "windows") print "a " domain " tag carries a host block: " label
      if (label !~ /^[a-z0-9][a-z0-9-]*$/) print "host label is outside [a-z0-9][a-z0-9-]*: " label
      else if (labels[label]++) print "host label is repeated: " label
      next
    }
    /^Deployment:/ { close_block(); next }
    /^(Evaluation|Build|Native runtime):/ {
      lane = $0; sub(/:.*/, "", lane)
      value = $0; sub(/^[^:]*:[ \t]*/, "", value)
      if (value !~ /^(passed|unavailable|not applicable)([ \t]*;.*)?$/)
        print lane " is none of passed, unavailable, not applicable: " value
      if (in_block) {
        if (seen[lane]++) print "host " label " repeats " lane
      } else if (domain != "windows") {
        if (top[lane]++) print lane " is repeated"
      } else {
        print lane " stands outside a host block"
      }
      next
    }
    END {
      close_block()
      if (!domain_seen) print "lacks Domain: " domain
      if (domain != "windows") {
        for (i = 1; i <= 3; i++) if (top[lanes[i]] == 0) print "lacks " lanes[i]
      } else if (hosts == 0) {
        print "has no host block"
      }
    }'
}

tag_count=0
tags=$(git tag)
[ "$mode" != range ] || tags=
[ "$mode" != tag ] || tags=$selected_tag
for tag in $tags; do
  tag_count=$((tag_count + 1))
  # Historical objects survive the one-time reconstruction outside new master.
  # Name-only exemptions would allow a forged replacement.
  case "$tag" in
    unixlike-v2026.08.31) expected=a844c146b5e966a42a3a3bb7d8245e24af4c8dcd ;;
    windows-v2026.08.31) expected=05dcfcefe69cc4f01a394364f8d68b06d5abbd5b ;;
    *) expected= ;;
  esac
  if [ -n "$expected" ]; then
    if [ "$(git rev-parse "refs/tags/$tag")" = "$expected" ] &&
       [ "$(git rev-parse "$tag^{}")" = 9586eb97114162fa96eadf1da8c90a492fcbc6f9 ]; then
      ok "preserved historical release object: $tag"
    else
      fail "historical tag object changed: $tag"
    fi
    continue
  fi
  if ! printf '%s\n' "$tag" | grep -Eq '^(unixlike|windows|common)-v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
    fail "tag name does not follow domain policy: $tag"
    continue
  fi
  if [ "$(git cat-file -t "refs/tags/$tag")" != tag ]; then
    fail "release tag is lightweight, expected annotated: $tag"
  elif [ -z "$master_ref" ]; then
    printf '· unverified: no local or origin/master ref to check tag reachability: %s\n' "$tag"
    unverified=1
  elif ! git merge-base --is-ancestor "$tag^{}" "$master_ref"; then
    fail "release tag target is not reachable from master: $tag"
  else
    domain=${tag%%-v*}
    tag_failures=$failures
    if ! version=$(git show "refs/tags/$tag^{}:$domain/release.json" | python3 "$audit_tools/release_version.py"); then
      fail "cannot verify the release declaration at $tag"
    elif [ "$tag" != "$domain-v$version" ]; then
      fail "release tag $tag differs from its target's declared version $version"
    fi
    defects=$(annotation_defects "$tag" "$domain")
    if [ -n "$defects" ]; then
      while IFS= read -r defect; do
        fail "release tag annotation: $defect ($tag)"
      done <<EOF
$defects
EOF
    fi
    if [ "$failures" -eq "$tag_failures" ]; then
      ok "release tag is annotated, evidenced, and master-reachable: $tag"
    fi
  fi
done
if [ "$mode" != range ] && [ "$tag_count" -eq 0 ]; then
  warn "no domain release tags exist; release workflow is unexercised"
fi

# Both spellings, permanently. The lock moved into the domain, and this rule
# reads history: the refreshes made before the move are still at the old path
# and always will be, because history is not rewritten.
lock_commits=
if [ "$mode" = range ]; then
  # INV repository/local-development-integration
  # INV repository/scope-ownership
  scopes=$("$audit_tools/classify" --range "$range_base" "$range_tip")
  if printf '%s\n' "$scopes" | grep -qx unclassified; then
    fail "transmitted content has an unclassified path"
  fi
  git rev-list --parents "$range_walk" >"$commits"
  while read -r commit parents; do
    set -- $parents
    if [ "$#" -lt 2 ]; then
      commit_paths=$(git diff-tree --root --no-renames --no-commit-id --name-only -r "$commit")
      if ! printf '%s\n' "$commit_paths" | "$audit_tools/classify" --single-scope --stdin >/dev/null; then
        fail "source commit has mixed or unclassified ownership: $commit"
      fi
      continue
    fi
    # Merges can span scopes. Their integration result still owns every path,
    # including a merge-only path removed before the final tip.
    commit_paths=$(git diff --no-renames --name-only "$1" "$commit")
    scopes=$(printf '%s\n' "$commit_paths" | "$audit_tools/classify" --stdin)
    if printf '%s\n' "$scopes" | grep -qx unclassified; then
      fail "merge commit has an unclassified path: $commit"
    fi
    # A combined history may select a parent's lock. A novel lock value needs
    # an isolated refresh commit of its own, even if later removed.
    for lock in flake.lock unixlike/flake.lock; do
      merged=$(git ls-tree "$commit" -- "$lock")
      inherited=false
      for parent in "$@"; do
        if [ "$merged" = "$(git ls-tree "$parent" -- "$lock")" ]; then
          inherited=true
          break
        fi
      done
      "$inherited" || fail "merge introduced a lock value outside a source refresh: $commit ($lock)"
    done
  done <"$commits"
  lock_commits=$(git log --full-history --no-merges --format='%H' "$range_walk" -- flake.lock unixlike/flake.lock)
elif [ "$mode" != tag ]; then
  lock_commits=$(git log --no-merges --format='%H' $master_ref $subject_tips -- flake.lock unixlike/flake.lock)
fi
for sha in $lock_commits; do
  [ -n "$(git show -s --format=%P "$sha")" ] || continue
  # A commit that only moves the lock is not a refresh, and the rule is about
  # refreshes. Rename detection answers that directly: a pure rename is R100
  # and is skipped, while a rename carrying a content change scores lower and
  # goes on to the rules below, where mixing it with the move fails as it
  # should.
  case "$(git diff-tree --no-commit-id -r -M --name-status "$sha" \
    -- flake.lock unixlike/flake.lock)" in
    R100*) continue ;;
  esac
  subject=$(git show -s --format=%s "$sha")
  files=$(git diff-tree --no-commit-id --name-only -r "$sha")
  if ! printf '%s\n' "$subject" | grep -Eq '^chore\(unixlike-deps\): .+'; then
    fail "flake.lock changed outside chore(unixlike-deps): $sha"
  elif [ "$files" != flake.lock ] && [ "$files" != unixlike/flake.lock ] &&
       [ "$files" != "$(printf 'unixlike/flake.lock\nunixlike/release.json')" ]; then
    fail "flake.lock refresh is mixed with other files: $sha"
  else
    ok "isolated flake.lock refresh: $sha"
  fi
done

# A spec past its review-by whose report is still pending is reported, the
# way the provisional check reports an overdue measure
# under change: it is a prompt to end the report or move the date, not a
# failure of the change at hand. The work check owns the reading.
overdue_specs=
if [ "$mode" = full ] || [ "$mode" = history ]; then
  overdue_specs=$("$audit_tools/work" --overdue) || overdue_specs=
fi
if [ -n "$overdue_specs" ]; then
  printf '%s\n' "$overdue_specs" | while IFS= read -r overdue_spec; do
    printf 'warning: overdue spec: %s\n' "$overdue_spec"
  done
  warnings=$((warnings + $(printf '%s\n' "$overdue_specs" | wc -l | tr -d ' ')))
elif [ "$mode" = full ] || [ "$mode" = history ]; then
  ok "no spec is past its review-by with a pending report"
fi

printf 'summary: %s warning(s), %s failure(s)\n' "$warnings" "$failures"
if [ "$failures" -ne 0 ]; then
  exit 1
fi
if [ "$unverified" -eq 1 ]; then
  if [ "${REQUIRE_NATIVE:-0}" = 1 ]; then
    printf 'failure: unverified under REQUIRE_NATIVE\n' >&2
    exit 1
  fi
  exit 69
fi
