#!/bin/sh

# Audit committed history and clone-local version-control policy. Read-only.
#
# usage: tool/version-control/audit [--history [<revision>...]]
#
# `--history` is the merge-gate and pre-push form, which audits committed
# history alone, because a runner has no clone-local configuration to audit.
# It judges dev and master as origin/ holds them when a fetch left those refs
# (see ref_of below); every local tag is still judged. Each <revision> is a
# commit the caller is about to publish, whose non-merge subjects are judged
# with dev's: the merge gate names HEAD, the commit under test, and
# .githooks/pre-push names the tips it pushes.
#
# INV repository/flake-lock-isolated, INV repository/release-tag-contract
# INV repository/hooks-are-the-tracked-ones
# INV repository/conventional-subject — subjects are judged by
# .githooks/commit-msg, the grammar's only owner.
#
# Exit 0 verified, 69 unverified (no dev/master ref), any other status failed.

set -eu

# The clone-local half (working tree, core.hooksPath, local branch names) is
# only answerable where a clone was configured by a person. A CI checkout is
# a detached, hook-less, branch-less shape by construction, so the merge gate
# asks for history alone rather than for findings it would have to ignore.
usage() {
  echo "usage: tool/version-control/audit [--history [<revision>...]]" >&2
  exit 2
}
mode=full
if [ "$#" -gt 0 ]; then
  [ "$1" = --history ] || usage
  mode=history
  shift
fi
for revision in "$@"; do
  case "$revision" in -*) usage ;; esac
done

# Guards this script's sed/grep/awk calls from Git for Windows' MSYS argument
# conversion (#79); see tool/version-control/hygiene. Inert elsewhere.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

# Resolved before the directory changes: the checks beside this file read the
# repository being audited, so the fixtures run them against a throwaway one.
audit_tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(git rev-parse --show-toplevel)
cd "$root"

warnings=0
failures=0

ok() {
  printf 'ok: %s\n' "$1"
}

warn() {
  printf 'warning: %s\n' "$1"
  warnings=$((warnings + 1))
}

fail() {
  printf 'failure: %s\n' "$1" >&2
  failures=$((failures + 1))
}

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo detached)
printf 'branch: %s\n' "$branch"

if [ "$mode" = full ]; then
  if [ -n "$(git status --porcelain)" ]; then
    warn "working tree has uncommitted changes"
  else
    ok "working tree is clean"
  fi
fi

# The directory Git will run hooks from, canonical. Relative values are
# relative to the worktree root; an unset value resolves to .git/hooks, which
# is never the tracked directory. Comparing directories rather than strings
# is what lets an absolute core.hooksPath naming .githooks count as enabled.
# git rev-parse prints a relative value relative to the current directory, so
# this helper is only correct after the script has changed to the toplevel,
# which every caller here does first.
hooks_actual() {
  hooks_actual_dir=$(git rev-parse --git-path hooks 2>/dev/null) || return 1
  case "$hooks_actual_dir" in
    /*) ;;
    *) hooks_actual_dir="$(git rev-parse --show-toplevel)/$hooks_actual_dir" ;;
  esac
  (CDPATH= cd -- "$hooks_actual_dir" 2>/dev/null && pwd -P)
}
# Enabled when Git's hooks directory is the tracked .githooks of any worktree
# of this repository: a linked worktree shares the clone's absolute
# core.hooksPath, which names the main worktree's copy of the same tracked
# directory.
hooks_enabled() {
  hooks_enabled_actual=$(hooks_actual) || return 1
  git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' |
    while IFS= read -r hooks_enabled_root; do
      hooks_enabled_expected=$(CDPATH= cd -- "$hooks_enabled_root/.githooks" 2>/dev/null && pwd -P) || continue
      [ "$hooks_enabled_actual" = "$hooks_enabled_expected" ] && echo yes
    done | grep -q yes
}

if [ "$mode" = full ]; then
  if hooks_enabled; then
    ok "clone runs the tracked hooks ($(git config --get core.hooksPath))"
  else
    fail "core.hooksPath is '$(git config --get core.hooksPath || echo unset)' and does not resolve to .githooks"
  fi
fi

# The integration branches the checks below judge. The full form reads a local
# branch when it exists, else the remote-tracking ref a fetch left behind. The
# history form reads origin/<name> first, for dev and master together: a local
# branch is clone state no push carries, and one that lags or leads its remote
# would fail a push, or pass it unchecked, over history it does not change.
# Resolving only one of the two to the remote would compare a fresh ref with a
# stale one and fail the traceability checks. The server keeps origin/dev and
# origin/master consistent, so the history form needs no rule for local and
# remote diverging. What it accepts: a clone that has not fetched judges the
# remote as it last saw it, and a subject on an unpublished local dev commit
# is left to .githooks/commit-msg. tool/version-control/plan-release stays on
# the local master, because it plans a tag this clone is about to create. A
# clone with neither ref cannot answer the history questions and says so as
# unverified, which CI turns into a failure.
ref_of() {
  if [ "$mode" = history ] && git show-ref --verify --quiet "refs/remotes/origin/$1"; then
    printf 'origin/%s\n' "$1"
  elif git show-ref --verify --quiet "refs/heads/$1"; then
    printf '%s\n' "$1"
  elif git show-ref --verify --quiet "refs/remotes/origin/$1"; then
    printf 'origin/%s\n' "$1"
  fi
}
dev_ref=$(ref_of dev)
master_ref=$(ref_of master)
unverified=0
for required in dev master; do
  eval "resolved=\$${required}_ref"
  if [ -n "$resolved" ]; then
    ok "$required resolves to $resolved"
  else
    printf '· unverified: no local or origin/%s ref in this clone\n' "$required"
    unverified=1
  fi
done

if [ "$mode" = full ]; then
  for local_branch in $(git for-each-ref --format='%(refname:short)' refs/heads); do
    case "$local_branch" in
      dev|master) ;;
      backup/*) warn "local backup branch remains: $local_branch" ;;
      feature/*|fix/*)
        if printf '%s\n' "$local_branch" | grep -Eq '^(feature|fix)/(unixlike|windows|common|repository)-[a-z0-9][a-z0-9-]*$'; then
          ok "branch name follows policy: $local_branch"
        else
          fail "branch name does not follow policy: $local_branch"
        fi
        ;;
      *) fail "unexpected local branch name: $local_branch" ;;
    esac
  done
fi

commit_msg_hook="$root/.githooks/commit-msg"
commits=$(mktemp)
subject_file=$(mktemp)
trap 'rm -f "$commits" "$subject_file"' EXIT
# The revisions a caller names are read with dev. git log walks the union of
# its arguments, so history a revision shares with dev is read once, and a
# promotion's merge, whose non-merge commits are already on dev, adds nothing.
# Each is resolved to a commit id, which holds no separator, so the list
# splits safely where it is expanded below.
subject_tips=
subject_scope=dev
for revision in "$@"; do
  if resolved_revision=$(git rev-parse --verify --quiet "$revision^{commit}"); then
    subject_tips="$subject_tips $resolved_revision"
    subject_scope="$subject_scope, $revision"
  else
    fail "revision to judge does not name a commit: $revision"
  fi
done
if [ -n "$dev_ref$subject_tips" ]; then
  git log $dev_ref $subject_tips --no-merges --format='%H%x09%s' >"$commits"
  tab=$(printf '\t')
  commit_failures=$failures
  while IFS="$tab" read -r sha subject; do
    printf '%s\n' "$subject" >"$subject_file"
    if "$commit_msg_hook" "$subject_file" >/dev/null 2>&1; then
      :
    else
      fail "commit subject rejected by .githooks/commit-msg $sha: $subject"
    fi
  done <"$commits"
  if [ "$failures" -eq "$commit_failures" ]; then
    ok "non-merge commit subjects on $subject_scope follow policy"
  fi
fi

if [ -n "$master_ref" ] && [ -n "$dev_ref" ]; then
  direct=$(git rev-list --no-merges "$master_ref" --not "$dev_ref")
  if [ -n "$direct" ]; then
    fail "master contains non-merge commits not present on dev"
  else
    ok "master has no direct non-merge commits outside dev"
  fi

  invalid_promotions=0
  for merge in $(git rev-list --first-parent --merges "$master_ref"); do
    parents=$(git show -s --format='%P' "$merge")
    second_parent=$(printf '%s\n' "$parents" | awk '{print $2}')
    if [ -z "$second_parent" ] || ! git merge-base --is-ancestor "$second_parent" "$dev_ref"; then
      fail "master merge does not carry history accepted through dev: $merge"
      invalid_promotions=$((invalid_promotions + 1))
    fi
  done
  if [ "$invalid_promotions" -eq 0 ]; then
    ok "master merge history is traceable through dev"
  fi
fi

# The annotation of a release tag, one defect per line and nothing when it
# follows the form. Windows states evidence per host. Unix-like provider and
# common tags state the three lanes at domain level; their releases certify no
# real host. A lane's value opens with one of three states. Historical tags
# before these forms are excepted below by immutable name.
annotation_defects() {
  git for-each-ref --format='%(contents)' "refs/tags/$1" | awk -v domain="$2" '
    function close_block(   i) {
      if (!in_block) return
      for (i = 1; i <= 3; i++)
        if (seen[lanes[i]] == 0) print "host " label " lacks " lanes[i]
      in_block = 0
    }
    BEGIN { lanes[1] = "Evaluation"; lanes[2] = "Build"; lanes[3] = "Native runtime" }
    { sub(/^[ \t]+/, ""); sub(/[ \t\r]+$/, "") }
    $0 == "Domain: " domain { domain_seen = 1; next }
    /^Host:/ {
      close_block()
      label = $0; sub(/^Host:[ \t]*/, "", label)
      in_block = 1; hosts++
      for (i = 1; i <= 3; i++) seen[lanes[i]] = 0
      if (domain != "windows") print "a " domain " tag carries a host block: " label
      if (label !~ /^[a-z0-9][a-z0-9-]*$/) print "host label is outside [a-z0-9][a-z0-9-]*: " label
      else if (labels[label]++) print "host label is repeated: " label
      next
    }
    /^Deployment:/ { close_block(); next }
    /^(Evaluation|Build|Native runtime):/ {
      lane = $0; sub(/:.*/, "", lane)
      value = $0; sub(/^[^:]*:[ \t]*/, "", value)
      if (value !~ /^(passed|unavailable|not applicable)([ \t]*;.*)?$/)
        print lane " is none of passed, unavailable, not applicable: " value
      if (in_block) {
        if (seen[lane]++) print "host " label " repeats " lane
      } else if (domain != "windows") {
        if (top[lane]++) print lane " is repeated"
      } else {
        print lane " stands outside a host block"
      }
      next
    }
    END {
      close_block()
      if (!domain_seen) print "lacks Domain: " domain
      if (domain != "windows") {
        for (i = 1; i <= 3; i++) if (top[lanes[i]] == 0) print "lacks " lanes[i]
      } else if (hosts == 0) {
        print "has no host block"
      }
    }'
}

# The tags created before the host-block form, excepted by name and held to
# the check they were created under. The list is closed: a tag is immutable,
# so nothing joins it.
legacy_tags="unixlike-v2026.08.31 windows-v2026.08.31"
legacy_annotation_defects() {
  legacy_annotation=$(git for-each-ref --format='%(contents)' "refs/tags/$1")
  for field in "Domain: $2" "Evaluation:" "Build:" "Native runtime:"; do
    printf '%s\n' "$legacy_annotation" | grep -Fq "$field" || printf 'lacks %s\n' "$field"
  done
}

tag_count=0
for tag in $(git tag); do
  tag_count=$((tag_count + 1))
  if ! printf '%s\n' "$tag" | grep -Eq '^(unixlike|windows|common)-v[0-9]{4}\.[0-9]{2}\.[0-9]{2}(\.[1-9][0-9]*)?$'; then
    fail "tag name does not follow domain policy: $tag"
    continue
  fi
  if [ "$(git cat-file -t "refs/tags/$tag")" != tag ]; then
    fail "release tag is lightweight, expected annotated: $tag"
  elif [ -z "$master_ref" ]; then
    printf '· unverified: no local or origin/master ref to check tag reachability: %s\n' "$tag"
    unverified=1
  elif ! git merge-base --is-ancestor "$tag^{}" "$master_ref"; then
    fail "release tag target is not reachable from master: $tag"
  else
    domain=${tag%%-v*}
    case " $legacy_tags " in
      *" $tag "*) defects=$(legacy_annotation_defects "$tag" "$domain") ;;
      *) defects=$(annotation_defects "$tag" "$domain") ;;
    esac
    if [ -n "$defects" ]; then
      while IFS= read -r defect; do
        fail "release tag annotation: $defect ($tag)"
      done <<EOF
$defects
EOF
    else
      ok "release tag is annotated, evidenced, and master-reachable: $tag"
    fi
  fi
done
if [ "$tag_count" -eq 0 ]; then
  warn "no domain release tags exist; release workflow is unexercised"
fi

root_commit=$(git rev-list --max-parents=0 HEAD | head -1)
# Both spellings, permanently. The lock moved into the domain, and this rule
# reads history: the refreshes made before the move are still at the old path
# and always will be, because history is not rewritten.
for sha in $(git log --format='%H' -- flake.lock unixlike/flake.lock); do
  [ "$sha" = "$root_commit" ] && continue
  # A commit that only moves the lock is not a refresh, and the rule is about
  # refreshes. Rename detection answers that directly: a pure rename is R100
  # and is skipped, while a rename carrying a content change scores lower and
  # goes on to the rules below, where mixing it with the move fails as it
  # should.
  case "$(git diff-tree --no-commit-id -r -M --name-status "$sha" \
    -- flake.lock unixlike/flake.lock)" in
    R100*) continue ;;
  esac
  subject=$(git show -s --format=%s "$sha")
  files=$(git diff-tree --no-commit-id --name-only -r "$sha")
  if ! printf '%s\n' "$subject" | grep -Eq '^chore\(unixlike-deps\): .+'; then
    fail "flake.lock changed outside chore(unixlike-deps): $sha"
  elif [ "$files" != flake.lock ] && [ "$files" != unixlike/flake.lock ]; then
    fail "flake.lock refresh is mixed with other files: $sha"
  else
    ok "isolated flake.lock refresh: $sha"
  fi
done

# A spec past its review-by whose report is still pending is reported, the
# way the provisional check reports an overdue measure outside the scopes
# under change: it is a prompt to end the report or move the date, not a
# failure of the change at hand. The work check owns the reading.
overdue_specs=$("$audit_tools/work" --overdue) || overdue_specs=
if [ -n "$overdue_specs" ]; then
  printf '%s\n' "$overdue_specs" | while IFS= read -r overdue_spec; do
    printf 'warning: overdue spec: %s\n' "$overdue_spec"
  done
  warnings=$((warnings + $(printf '%s\n' "$overdue_specs" | wc -l | tr -d ' ')))
else
  ok "no spec is past its review-by with a pending report"
fi

printf 'summary: %s warning(s), %s failure(s)\n' "$warnings" "$failures"
if [ "$failures" -ne 0 ]; then
  exit 1
fi
if [ "$unverified" -eq 1 ]; then
  if [ "${REQUIRE_NATIVE:-0}" = 1 ]; then
    printf 'failure: unverified under REQUIRE_NATIVE\n' >&2
    exit 1
  fi
  exit 69
fi
