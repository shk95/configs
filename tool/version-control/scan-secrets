#!/bin/sh
# INV repository/no-secret-in-history
set -eu
export GIT_NO_REPLACE_OBJECTS=1
tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$tools/incoming-range.sh"

case "$#:${1:-}" in
  1:--all)
    incoming_range "$(git hash-object -t tree --stdin </dev/null)" HEAD
    range_walk='--all HEAD'
    ;;
  3:--range) incoming_range "$2" "$3" ;;
  *) echo 'usage: scan-secrets --range <base> <tip> | --all' >&2; exit 2 ;;
esac
if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'Secret scan is unverified: install gitleaks' >&2
  exit 69
fi

# A push can run from a checkout unrelated to the transmitted ref. Use the
# scanner's embedded rules and no checkout-specific configuration or ignore file.
ignore=$(mktemp)
trap 'rm -f "$ignore"' EXIT
ignore_arg=$ignore
if command -v cygpath >/dev/null 2>&1; then
  ignore_arg=$(cygpath -m "$ignore")
fi
unset GITLEAKS_CONFIG
GITLEAKS_CONFIG_TOML='[extend]
useDefault = true'
export GITLEAKS_CONFIG_TOML

# Diff merges against their first parent without restricting the commit walk to
# that parent. This retains every incoming side commit, even if later reverted.
gitleaks git --redact --no-banner --ignore-gitleaks-allow --gitleaks-ignore-path "$ignore_arg" \
  --log-opts="--root --full-history --diff-merges=first-parent --no-renames --no-ext-diff --no-textconv --text --no-notes --no-show-signature --no-color --src-prefix=a/ --dst-prefix=b/ --format=medium $range_walk --" \
  "$(git rev-parse --show-toplevel)"
