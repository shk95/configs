#!/bin/sh
# INV repository/no-secret-in-history
set -eu
export GIT_NO_REPLACE_OBJECTS=1
tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$tools/incoming-range.sh"

mode=${1:-}
case "$#:$mode" in
  1:--all)
    incoming_range "$(git hash-object -t tree --stdin </dev/null)" HEAD
    range_walk='--all HEAD'
    ;;
  3:--range) incoming_range "$2" "$3" ;;
  2:--tag | 1:--text) ;;
  *) echo 'usage: scan-secrets --range <base> <tip> | --all | --tag <tag-oid> | --text' >&2; exit 2 ;;
esac
if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'Secret scan is unverified: install gitleaks' >&2
  exit 69
fi

# A push can run from a checkout unrelated to the transmitted ref. Use the
# scanner's embedded rules and no checkout-specific configuration or ignore file.
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
ignore=$scratch/ignore
: >"$ignore"
ignore_arg=$ignore
if command -v cygpath >/dev/null 2>&1; then
  ignore_arg=$(cygpath -m "$ignore")
fi
unset GITLEAKS_CONFIG GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
GITLEAKS_CONFIG_TOML='[extend]
useDefault = true'
export GITLEAKS_CONFIG_TOML

scan() {
  command=$1
  shift
  gitleaks "$command" --redact --no-banner --ignore-gitleaks-allow --gitleaks-ignore-path "$ignore_arg" "$@"
}

case "$mode" in
  --text) scan stdin ;;
  --tag)
    git cat-file tag "$2" >"$scratch/metadata"
    scan stdin <"$scratch/metadata"
    ;;
  *)
    # Diff merges against their first parent without restricting the commit
    # walk to that parent. Retain side commits even when later reverted.
    scan git --log-opts="--root --full-history --diff-merges=first-parent --no-renames --no-ext-diff --no-textconv --text --no-notes --no-show-signature --no-color --src-prefix=a/ --dst-prefix=b/ --format=medium $range_walk --" \
      "$(git rev-parse --show-toplevel)"
    git log --format=%B --no-notes $range_walk -- >"$scratch/metadata"
    if [ "$mode" = --all ]; then
      git for-each-ref --format='%(objecttype) %(objectname)' refs/tags >"$scratch/tags"
      while read -r kind oid; do
        if [ "$kind" = tag ]; then
          git cat-file tag "$oid" >>"$scratch/metadata"
          printf '\n' >>"$scratch/metadata"
        fi
      done <"$scratch/tags"
    fi
    if [ -s "$scratch/metadata" ]; then
      scan stdin <"$scratch/metadata"
    fi
    ;;
esac
