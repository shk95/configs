#!/bin/sh
#
# Enforce INV repository/issue-closes-from-report: an execution issue is
# closed automatically only from what its report says.
#
# GitHub closes a linked issue on a merge into master, and every pull request
# here targets dev, so closure was manual; a closing keyword would tie it to a
# promotion, which certifies nothing (INV repository/no-closing-keyword). This
# script is the one automatic path. For a push to dev it reads the reports
# that became done, abandoned or superseded between the two commits and whose
# spec names an issue (tool/version-control/work --became-terminal), and
# closes each issue with a comment linking the report at the pushed commit: a
# done report as completed, an abandoned or superseded one as not planned. A
# report that is still pending closes nothing, and neither does a spec that
# names no issue. It first runs the work check on the tree, so a report whose
# state does not follow from its rows closes nothing either.
#
# The only remote write is `gh issue close`. --dry-run prints each close
# instead of performing it.
#
# usage: tool/version-control/close-issues [--dry-run] <base> <head>
#
# Exit 0 verified, 69 unverified, any other status failed. See
# docs/policy/architecture.md, "Repository governance plane", and .githooks/evidence,
# which is the one place that decides what each means.

set -eu

# Guards this script's sed/grep/awk calls from Git for Windows' MSYS argument
# conversion (#79); see tool/version-control/hygiene. Inert elsewhere.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

# The three-state prerequisite contract, restated rather than sourced from
# unixlike/tool/checks/prerequisite for the reason tool/version-control/hygiene
# gives: a repository check must not depend on a domain's plane.
require_command() {
  require_missing=
  for require_name in "$@"; do
    command -v "$require_name" >/dev/null 2>&1 ||
      require_missing="$require_missing $require_name"
  done
  [ -n "$require_missing" ] || return 0

  if [ "${REQUIRE_NATIVE:-0}" = 1 ]; then
    printf '\033[31m✗ required tooling is missing:%s\033[0m\n' \
      "$require_missing" >&2
    exit 1
  fi

  printf '· unverified: this host has no%s\n' "$require_missing" >&2
  exit 69
}

usage() {
  echo "usage: tool/version-control/close-issues [--dry-run] <base> <head>" >&2
  exit 2
}

dry_run=0
if [ "${1:-}" = --dry-run ]; then
  dry_run=1
  shift
fi
[ "$#" -eq 2 ] || usage
base=$1
head=$2

require_command git gh

# The repository being read, not the one this file lives in, so the fixtures
# in tool/version-control/test run this exact script against a throwaway
# repository; the work check beside this file is the one that reads it.
tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(git rev-parse --show-toplevel)
cd "$root"

"$tools/work" >/dev/null || {
  echo "the work items do not pass tool/version-control/work; nothing is closed" >&2
  exit 1
}

head_sha=$(git rev-parse --verify "$head^{commit}")
repository=${GITHUB_REPOSITORY:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}

listing=$(mktemp)
trap 'rm -f "$listing"' EXIT
"$tools/work" --became-terminal "$base" "$head" >"$listing"

closed=0
while read -r issue state report; do
  url="https://github.com/$repository/blob/$head_sha/$report"
  if [ "$state" = done ]; then
    reason=completed
    comment="The report is done: every acceptance criterion is verified in its required lanes. $url"
  else
    reason="not planned"
    comment="The report is $state; it says how far the work got and what it left. $url"
  fi
  if [ "$dry_run" -eq 1 ]; then
    printf 'would close %s as %s: %s\n' "$issue" "$reason" "$comment"
  else
    gh issue close "${issue#\#}" --repo "$repository" --reason "$reason" --comment "$comment"
  fi
  closed=$((closed + 1))
done <"$listing"

echo "✓ close-issues: $closed issue(s) closed from a report that became terminal"
