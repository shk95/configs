#!/usr/bin/env python3
"""Repository-owned master/topic operation. No fetch, push, tag or pruning."""
# INV repository/local-development-integration
# INV repository/workspace-choice
# INV repository/local-gate-selects-by-effect
import sys
sys.dont_write_bytecode = True
import argparse
import json
import os
import re
import subprocess
from pathlib import Path
from git_workflow import (TOPIC_PREFIX, TOPIC_SEPARATOR, TOPIC_SLUG, git, linked_workspace,
                          topic_destination, topic_pattern, unfinished_operations)
from repo_policy import load
from github_proof import selected_units, verify
from topic_scope import validate as validate_topic

POLICY = load()
BASE = POLICY["base_branch"]


def run(*args, cwd=None, capture=True):
    result = subprocess.run(args, cwd=cwd, text=True, stdout=subprocess.PIPE if capture else None, check=True)
    return result.stdout.strip() if capture else ''


def clean(root):
    if git('status', '--porcelain', cwd=root):
        raise ValueError('Commit or preserve staged, unstaged and untracked changes first; nothing was discarded.')
    operations = unfinished_operations(root)
    if operations:
        raise ValueError('Finish the existing Git operation first: ' + ', '.join(operations))


def sha(value):
    if not re.fullmatch('[0-9a-f]{40}', value):
        raise ValueError('Use a reviewed full 40-character SHA.')
    return git('rev-parse', '--verify', value + '^{commit}')


def branch_head(branch):
    return git('rev-parse', '--verify', f'refs/heads/{branch}^{{commit}}')


def require_candidate(root, head):
    clean(root)
    if git('rev-parse', 'HEAD') != head:
        raise ValueError('Use the exact reviewed candidate in its checkout.')


def inspect(root):
    branch = git('branch', '--show-current')
    return {'branch': branch, 'head': git('rev-parse', 'HEAD'), 'merge_target': topic_destination(branch, POLICY),
            'master': git('rev-parse', BASE), 'workspace': str(root),
            'linked': linked_workspace(),
            'changes': git('status', '--short'), 'remote': 'not queried',
            'policy': 'tool/version-control/policy.json',
            'workspace_choice': 'retain the agreed workspace; choose --workspace for a clean new start'}


def plan(root, base, head, ci_run=None):
    """Build the exact check sequence without running checks or hosted proof."""
    base, head = sha(base), sha(head)
    require_candidate(root, head)
    git('merge-base', '--is-ancestor', base, head)
    tree = git('rev-parse', head + '^{tree}')
    units = selected_units(base, tree, root)
    branch = git('branch', '--show-current')
    if branch == BASE:
        scopes = run(str(root / 'tool/version-control/classify'), '--range', base, head).splitlines()
    else:
        scopes = validate_topic(branch, base, head, POLICY)
    steps = []

    def local(identifier, argv, subject):
        if argv[0].endswith('.ps1'):
            argv = ['pwsh', '-NoProfile', '-File', *argv]
        steps.append(dict(id=identifier, source='local', argv=list(argv), subject=subject))

    if ci_run:
        steps.append(dict(id='ci-proof', source='hosted', run=ci_run, subject='definition, exact source and selected units'))
    else:
        local('secrets', ['tool/version-control/scan-secrets', '--range', base, head], 'incoming-history-range')
        for name in ('audit', 'work'):
            local(name, ['tool/version-control/' + name, '--range', base, head], 'incoming-range')
        for name in ('hygiene', 'domain-reads', 'design-citations', 'records', 'invariants'):
            local(name, ['tool/version-control/' + name], 'candidate-index')
    local('provisional', ['tool/version-control/provisional', '--scopes',
                         ','.join(scope for scope in scopes if scope != 'none')],
          'candidate-index; current date; affected scopes')
    blockers = []
    hosted_only = {'windows:runtime': 'Windows CI runtime wiring', 'repository:windows-git': 'Native Windows Git fixtures'}
    for unit in units:
        if unit in hosted_only and not ci_run:
            blockers.append(hosted_only[unit] + ' requires exact hosted evidence via --ci-run')
        elif unit not in POLICY['ci']['suite_commands'] and unit not in hosted_only:
            raise ValueError('Unknown selected check: ' + unit)
        elif unit == 'windows:suite' and os.name != 'nt' and not ci_run:
            blockers.append('Native Windows checks unavailable: use --ci-run with exact hosted evidence')
        if ci_run or unit in hosted_only:
            steps.append(dict(id=unit, source='hosted', subject='exact-base-head-tree'))
        else:
            for index, argv in enumerate(POLICY['ci']['suite_commands'][unit]):
                local(unit + ':' + str(index + 1), argv, 'candidate-tree')
    result = dict(state='not-run', base=base, head=head, tree=tree,
                  units=units, steps=steps, blockers=blockers)
    clean(root)
    if git('rev-parse', 'HEAD') != head:
        raise ValueError('Candidate changed while planning.')
    return result


def check(root, base, head, ci_run=None):
    selected = plan(root, base, head, ci_run)
    if selected['blockers']:
        raise ValueError('; '.join(selected['blockers']))
    proof = None
    for step in selected['steps']:
        if step['source'] == 'hosted':
            if step['id'] == 'ci-proof':
                proof = verify(ci_run, selected['base'], selected['head'], selected['tree'])
            elif not proof:
                raise ValueError('Selected suite requires successful exact hosted proof')
            continue
        argv = step['argv'][:]
        for index in (0, 3) if argv[:3] == ['pwsh', '-NoProfile', '-File'] else (0,):
            if argv[index].startswith(('tool/', 'unixlike/', 'windows/')):
                argv[index] = str(root / argv[index])
        print('check:', ' '.join(argv), flush=True)
        run(*argv, cwd=root, capture=False)
    clean(root)
    if git('rev-parse', 'HEAD') != selected['head']:
        raise ValueError('Candidate changed while checks were running.')
    print(json.dumps(dict(verified_base=selected['base'], verified_head=selected['head'],
                          tree=selected['tree'], units=selected['units'], ci=proof)))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('inspect')
    start = sub.add_parser('start')
    start.add_argument('--parent', help='Start a subtopic from this local topic branch')
    start.add_argument('--commits', choices=['one', 'many'],
                       help='Use one for direct master work; optional when a topic is named')
    start.add_argument('--workspace', choices=POLICY['workspace_choices'], required=True,
                       help='The agreed checkout for this task')
    start.add_argument('--topic')
    start.add_argument('--dry-run', action='store_true')
    for name in ('plan', 'check', 'merge'):
        command = sub.add_parser(name, help='Inspect planned checks' if name == 'plan' else None)
        command.add_argument('--base', required=True)
        command.add_argument('--head', required=True)
        command.add_argument('--ci-run', help='Live successful GitHub CI run covering the exact base/head/tree')
    args = parser.parse_args()
    root = Path(git('rev-parse', '--show-toplevel'))
    os.chdir(root)
    if args.command == 'inspect':
        print(json.dumps(inspect(root), indent=2))
    elif args.command == 'start':
        clean(root)
        parent = args.parent
        if parent is not None and not (parent.startswith(TOPIC_PREFIX) and re.fullmatch(topic_pattern(POLICY), parent)):
            raise ValueError('Start a subtopic from a named topic/ branch.')
        base_branch = parent or BASE
        if args.workspace == 'current' and git('branch', '--show-current') != base_branch:
            raise ValueError(f'Start current-workspace work from {base_branch}; preserve existing work first.')
        if args.topic is None:
            if parent or args.commits != 'one' or args.workspace != 'current':
                raise ValueError('Pass --topic for topic work or --commits one for direct master work.')
            target = BASE
        elif not re.fullmatch(TOPIC_SLUG, args.topic):
            raise ValueError('Use a topic slug made of lowercase letters, digits, and hyphens.')
        elif parent:
            target = parent + TOPIC_SEPARATOR + args.topic
        else:
            target = TOPIC_PREFIX + args.topic
        base = branch_head(base_branch)
        data = dict(base=base, branch=target, workspace=args.workspace)
        if parent is not None:
            data['parent'] = parent
        print(json.dumps(data))
        if args.dry_run:
            return
        if args.workspace == 'linked':
            primary = Path(git('worktree', 'list', '--porcelain').splitlines()[0][9:])
            destination = primary.parent / (primary.name + '-wt') / target.replace('/', '-', 1)
            run('git', 'worktree', 'add', '-b', target, str(destination), base, capture=False)
        elif target != BASE:
            run('git', 'switch', '-c', target, base, capture=False)
    elif args.command == 'plan':
        print(json.dumps(plan(root, args.base, args.head, args.ci_run), indent=2))
    elif args.command == 'check':
        check(root, args.base, args.head, args.ci_run)
    else:
        base, head = sha(args.base), sha(args.head)
        branch = git('branch', '--show-current')
        destination = topic_destination(branch, POLICY)
        if not destination:
            raise ValueError('Merge must start in the reviewed topic checkout.')
        if base == head or branch_head(destination) != base:
            raise ValueError(f'Empty candidate or changed {destination} base; review the current branch and retry.')
        source_linked = linked_workspace()
        if source_linked and not git('for-each-ref', '--format=%(worktreepath)', f'refs/heads/{destination}'):
            raise ValueError(f'Check out {destination} in its destination workspace before merging from a linked worktree.')
        if destination == BASE:
            check(root, base, head, args.ci_run)
        else:
            if args.ci_run:
                raise ValueError('Hosted proof applies to the top-level master candidate.')
            require_candidate(root, head)
            if git('merge-base', base, head) == head:
                raise ValueError(f'{destination} already contains the reviewed subtopic head.')
            validate_topic(branch, base, head, POLICY)
            run(str(root / 'tool/version-control/audit'), '--range', base, head, capture=False)
            require_candidate(root, head)
        if git('branch', '--show-current') != branch:
            raise ValueError('The source branch changed during verification.')
        target_path = git('for-each-ref', '--format=%(worktreepath)', f'refs/heads/{destination}')
        if target_path:
            target = Path(target_path)
        elif source_linked:
            raise ValueError(f'The {destination} checkout disappeared during verification.')
        else:
            run('git', 'switch', '--no-guess', destination, cwd=root, capture=False)
            target = root
        clean(target)
        if git('rev-parse', 'HEAD', cwd=target) != base or git('branch', '--show-current', cwd=target) != destination:
            raise ValueError(f'{destination} changed during verification; integration stopped.')
        run('git', '-c', f'branch.{destination}.mergeOptions=', 'merge',
            '--' + POLICY['merge_method'], '-m', f"Merge branch '{branch}' into {destination}",
            head, cwd=target, capture=False)
        parents = git('show', '-s', '--format=%P', 'HEAD', cwd=target).split()
        if parents != [base, head]:
            raise ValueError('Unexpected merge identity; preserve and inspect the result.')
        if destination == BASE and git('rev-parse', 'HEAD^{tree}', cwd=target) != git('rev-parse', head + '^{tree}'):
            raise ValueError('Master merge differs from the verified tree; preserve and inspect the result.')
        print(json.dumps({'merge': git('rev-parse', 'HEAD', cwd=target), 'destination': destination,
                          'parents': parents, 'push': 'not performed'}))


if __name__ == '__main__':
    try:
        os.environ['GIT_NO_REPLACE_OBJECTS'] = '1'
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        raise SystemExit(str(error))
