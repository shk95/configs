#!/bin/sh

# Audit GitHub protection against the repository's stable CI contract.
# Read-only; requires an authenticated gh client.

set -eu

# Guards this script's sed/grep/awk calls from Git for Windows' MSYS argument
# conversion (#79); see tool/version-control/hygiene. Inert elsewhere.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

# Resolved before the directory changes: the checks beside this file read the
# repository being audited, so the fixtures run them against a throwaway one.
audit_tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(git rev-parse --show-toplevel)
cd "$root"

failures=0

ok() {
  printf 'ok: %s\n' "$1"
}

fail() {
  printf 'failure: %s\n' "$1" >&2
  failures=$((failures + 1))
}

command -v gh >/dev/null 2>&1 || {
  echo "gh is unavailable" >&2
  exit 2
}
gh auth status --hostname github.com >/dev/null 2>&1 || {
  echo "gh is not authenticated for github.com" >&2
  exit 2
}

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
default_branch=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
if [ "$default_branch" = master ]; then
  ok "default branch is master ($repo)"
else
  fail "default branch is $default_branch, expected master ($repo)"
fi

for branch in dev master; do
  endpoint="repos/$repo/branches/$branch/protection"
  if ! gh api "$endpoint" >/dev/null; then
    fail "$branch branch protection is unavailable"
    continue
  fi

  safe=$(gh api "$endpoint" --jq '
    .enforce_admins.enabled == true and
    .allow_force_pushes.enabled == false and .allow_deletions.enabled == false')
  [ "$safe" = true ] || fail "$branch does not enforce admin and safe-history rules"
  if [ "$branch" = dev ]; then
    local_flow=$(gh api "$endpoint" --jq '
      .required_status_checks == null and .required_pull_request_reviews == null and
      .required_conversation_resolution.enabled == false')
    [ "$local_flow" = true ] && ok "dev permits ordinary synchronization without PR/check gates" \
      || fail "dev still requires remote admission"
  else
    protected=$(gh api "$endpoint" --jq '
      .required_status_checks.contexts == ["Required checks"] and
      .required_status_checks.checks == [{"context":"Required checks","app_id":15368}] and
      .required_status_checks.strict == true and .required_pull_request_reviews != null and
      .required_pull_request_reviews.required_approving_review_count == 0 and
      .required_conversation_resolution.enabled == true')
    [ "$protected" = true ] && ok "master requires strict protected PR admission" \
      || fail "master protection does not match policy"
  fi
done

open_promotion_numbers=$(gh api --paginate \
  "repos/$repo/pulls?state=open&base=master&per_page=100" \
  --jq '.[] | .number')
open_promotions=$(printf '%s\n' "$open_promotion_numbers" \
  | awk 'NF { count++ } END { print count + 0 }')
invalid_open=$(gh api --paginate \
  "repos/$repo/pulls?state=open&base=master&per_page=100" \
  --jq '.[] | select((.head.ref != "dev" and (.head.ref | startswith("feature/unixlike-input-patch-") | not)) or .head.repo.full_name != "'"$repo"'") | .number' \
  | paste -sd, -)
if [ -n "$invalid_open" ]; then
  fail "open master pull requests have invalid sources: $invalid_open"
elif [ "$open_promotions" -le 1 ]; then
  ok "at most one master pull request is open"
else
  fail "$open_promotions master pull requests are open"
fi

invalid_merged=$(gh api --paginate \
  "repos/$repo/pulls?state=closed&base=master&per_page=100" \
  --jq '.[] | select(.merged_at != null) | select((.head.ref != "dev" and (.head.ref | startswith("feature/unixlike-input-patch-") | not)) or .head.repo.full_name != "'"$repo"'") | .number' \
  | paste -sd, -)
if [ -n "$invalid_merged" ]; then
  fail "merged master pull requests have invalid sources: $invalid_merged"
else
  ok "merged master pull requests came from same-repository dev or the input patch lane"
fi

merge_settings=$(gh api "repos/$repo" --jq '
  .allow_merge_commit == true and
  .allow_squash_merge == false and
  .allow_rebase_merge == false')
if [ "$merge_settings" = true ]; then
  ok "repository permits merge commits and disables squash and rebase merging"
else
  fail "repository merge methods do not enforce merge commits only"
fi

printf 'summary: %s remote failure(s)\n' "$failures"
[ "$failures" -eq 0 ]
