#!/usr/bin/env python3
"""Read-only comparison of remote settings with the tracked contract."""
# INV repository/mechanical-policy
import sys
sys.dont_write_bytecode = True
import json
from github_proof import api, repository
from repo_policy import load


def audit():
    policy = load()
    repo = repository()
    remote = api(f'repos/{repo}')
    if remote['default_branch'] != policy['base_branch']: raise ValueError('Wrong default branch')
    protection = api(f'repos/{repo}/branches/{policy["base_branch"]}/protection')
    for key, expected in policy['remote'].items():
        actual = remote.get(key) if key.startswith('allow_') and key in remote else protection.get(key)
        if isinstance(actual, dict) and 'enabled' in actual: actual = actual['enabled']
        if actual != expected: raise ValueError(f'Remote {key}: expected {expected!r}, found {actual!r}')
    from history_rewrite import audit_force_actor, approval_environment
    history = audit_force_actor(repo, protection, require_enabled=False)
    if history['enabled']: approval_environment(repo)
    print(json.dumps({'verified': True, 'history_rewrite': history, 'writes': 'none'}))


if __name__ == '__main__':
    try: audit()
    except (ValueError, OSError) as error: raise SystemExit(str(error))
