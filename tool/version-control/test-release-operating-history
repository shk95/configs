#!/bin/sh
# INV repository/private-history-acquisition-isolated
# INV repository/authenticated-release-transport
# INV repository/initializer-attempt-custody
# INV repository/fixture-git-isolation
set -eu
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL
tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$tools/fixture-git-environment.sh"
python=${CONFIGS_CONTROLLER_PYTHON:-python3}
if ! "$python" -I -S -c 'import sys; assert sys.version_info >= (3,9)' >/dev/null 2>&1; then
  echo 'private history fixtures: functional Python unavailable' >&2
  [ "${REQUIRE_NATIVE:-0}" != 1 ] && exit 69
  exit 1
fi
script="$tools/test-release-operating-history.py"
if command -v cygpath >/dev/null 2>&1; then script=$(cygpath -m "$script"); fi
"$python" -I -S -B "$script"
script="$tools/test-release-initialize.py"
if command -v cygpath >/dev/null 2>&1; then script=$(cygpath -m "$script"); fi
exec "$python" -I -S -B "$script"
