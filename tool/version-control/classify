#!/bin/sh

# Classify changed paths without running domain checks or mutating Git state.

set -eu

# Guards this script's sed/grep/awk calls from Git for Windows' MSYS argument
# conversion (#79); see tool/version-control/hygiene. Inert elsewhere.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

root=$(git rev-parse --show-toplevel)
cd "$root"

usage() {
  echo "usage: tool/version-control/classify [--staged | --range <base> <head> | --stdin | --files <path> ...]" >&2
  exit 2
}

paths=$(mktemp)
scopes=$(mktemp)
trap 'rm -f "$paths" "$scopes"' EXIT

case "${1:-}" in
  --staged)
    [ "$#" -eq 1 ] || usage
    git diff --cached --name-only --relative >"$paths"
    ;;
  --range)
    [ "$#" -eq 3 ] || usage
    git diff --name-only --relative "$2" "$3" >"$paths"
    ;;
  --stdin)
    [ "$#" -eq 1 ] || usage
    sort -u >"$paths"
    ;;
  --files)
    shift
    [ "$#" -gt 0 ] || usage
    printf '%s\n' "$@" >"$paths"
    ;;
  "")
    {
      git diff --name-only --relative HEAD
      git ls-files --others --exclude-standard
    } | sort -u >"$paths"
    ;;
  *) usage ;;
esac

if [ ! -s "$paths" ]; then
  echo none
  exit 0
fi

while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    windows/*) echo windows ;;
    flake.nix|flake.lock|modules/*|assets/*|.envrc|Justfile|tool/checks/*)
      echo unixlike
      ;;
    AGENTS.md|CLAUDE.md|CONTRIBUTING.md|README.md|LICENSE|docs/*|\
    .agents/*|.claude/*|.github/*|.githooks/*|.editorconfig|.gitattributes|\
    .gitignore|tool/setup|tool/doctor.sh|tool/worktree.sh|tool/version-control/*|\
    tool/dispatch/*)
      echo repository
      ;;
    # common/ has no arm: the change that creates the domain restores its classification, dispatch and gate together (docs/architecture.md, "Common domain").
    # INV repository/scope-ownership
    # The invariant registry (invariants/README.md is the format contract).
    # Each scope owns the entries under its own directory, so a Windows
    # invariant is a windows change and needs no Unix-like host to check.
    # The removed common scope's placeholder: its deletion must still classify
    # while it sits inside a pull-request range. Dropped when the domain returns.
    invariants/README.md|invariants/common/.gitkeep) echo repository ;;
    invariants/unixlike/*) echo unixlike ;;
    invariants/windows/*) echo windows ;;
    invariants/repository/*) echo repository ;;
    *) echo unclassified ;;
  esac
done <"$paths" | sort -u >"$scopes"

for scope in unixlike windows repository unclassified; do
  if grep -qx "$scope" "$scopes"; then
    echo "$scope"
  fi
done
