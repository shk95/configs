#!/usr/bin/env python3
# INV repository/approved-history-rewrite
import sys
sys.dont_write_bytecode = True
import argparse
import json
from history_rewrite import execute, plan, prepare, authorization, preflight

parser = argparse.ArgumentParser(description='Read-only planning; execution requires a live protected approval workflow.')
sub = parser.add_subparsers(dest='command', required=True)
for name in ('plan', 'prepare', 'authorize'):
    child = sub.add_parser(name)
    for field in ('old', 'new', 'reason'): child.add_argument('--' + field, required=True)
    if name == 'prepare': child.add_argument('--directory', required=True)
child = sub.add_parser('execute')
child.add_argument('--directory', required=True)
child = sub.add_parser('preflight', help='Read the installed protection, App capabilities and approval environment; no writes or authorization')
child.add_argument('--app-slug', required=True)
args = parser.parse_args()
try:
    if args.command == 'preflight': value = preflight(args.app_slug)
    elif args.command == 'execute': value = execute(args.directory)
    elif args.command == 'prepare': value = prepare(args.directory, args.old, args.new, args.reason)
    else:
        value = plan(args.old, args.new, args.reason)
        if args.command == 'authorize': value = authorization(value)
    print(json.dumps(value, indent=2))
except (ValueError, OSError) as error:
    raise SystemExit(str(error))
