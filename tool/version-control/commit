#!/bin/sh
#
# Confirm a templated desired-state edit and commit locally in a dedicated
# topic worktree. Ownership, quick-check selection and evidence come from the
# existing classifier, dispatcher and hook library. No publication or cleanup.
# INV repository/local-development-integration
# usage: tool/version-control/commit [--dry-run] <command>

set -eu

# INV repository/retired-capture-publication
# Recognize the retired grammar before resolving Git, readers or scratch space.
# Function positional parameters leave the normal parser's arguments intact.
refuse_retired_capture() {
  while [ "$#" -gt 0 ]; do
    case $1 in
      --dry-run | --publish) shift ;;
      --host | --hotkeys-host)
        [ "$#" -ge 2 ] || return 0
        shift 2
        ;;
      --) shift; break ;;
      -*) return 0 ;;
      *) break ;;
    esac
  done
  if [ "$#" -ge 2 ] && [ "$1" = capture ] && [ "$2" = karabiner ]; then
    printf '%s\n' 'capture karabiner is retired; no host reads or Git changes were performed.' \
      'Use the pinned host-document preview/review/save workflow in CONTRIBUTING.md.' >&2
    exit 1
  fi
}
refuse_retired_capture "$@"

# Guards the `sed -n '/^@@/,$p'` call below from Git for Windows' MSYS
# argument conversion, which rewrites a leading-`/` argv element into a
# Windows path before sed sees it. See tool/version-control/hygiene for the
# full explanation and the observed failure (#79). Inert everywhere else.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

root=$(git rev-parse --show-toplevel)
cd "$root"

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
classify="$script_dir/classify"
select_checks="$root/tool/dispatch/select"

hooks_dir="$root/.githooks"
. "$hooks_dir/evidence"

# Hooks are opt-in: tool/setup --fix sets core.hooksPath, a fresh clone does
# not. Naming the units a commit needs would otherwise report a gate that never
# applied.
hooks_path=$(git config --get core.hooksPath 2>/dev/null || true)

# The directory Git will run hooks from, canonical. Relative values are
# relative to the worktree root; an unset value resolves to .git/hooks, which
# is never the tracked directory. Comparing directories rather than strings
# is what lets an absolute core.hooksPath naming .githooks count as enabled.
# git rev-parse prints a relative value relative to the current directory, so
# this helper is only correct after the script has changed to the toplevel,
# which every caller here does first.
hooks_actual() {
  hooks_actual_dir=$(git rev-parse --git-path hooks 2>/dev/null) || return 1
  case "$hooks_actual_dir" in
    /*) ;;
    *) hooks_actual_dir="$(git rev-parse --show-toplevel)/$hooks_actual_dir" ;;
  esac
  (CDPATH= cd -- "$hooks_actual_dir" 2>/dev/null && pwd -P)
}
# Enabled when Git's hooks directory is the tracked .githooks of any worktree
# of this repository: a linked worktree shares the clone's absolute
# core.hooksPath, which names the main worktree's copy of the same tracked
# directory.
hooks_enabled() {
  hooks_enabled_actual=$(hooks_actual) || return 1
  git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' |
    while IFS= read -r hooks_enabled_root; do
      hooks_enabled_expected=$(CDPATH= cd -- "$hooks_enabled_root/.githooks" 2>/dev/null && pwd -P) || continue
      [ "$hooks_enabled_actual" = "$hooks_enabled_expected" ] && echo yes
    done | grep -q yes
}

homebrew_module=unixlike/modules/platforms/homebrew.nix

# One scratch directory for the candidate edit. Trapped on the signals a prompt is interrupted
# with as well as on EXIT, because a helper that stops at a question is exactly
# the one an operator interrupts.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# POSIX sh resumes after a trap handler, so an interrupt handler that only
# cleans up would leave the run going with its scratch files gone.
trap 'rm -rf "$work"; exit 130' INT HUP TERM

dry_run=0
plan_units_line=

usage_text() {
  cat <<'EOF'
usage: tool/configs commit [--dry-run] <command>

options:
  --dry-run                show the edit and checks without writing

commands:
  brew add <formula>       declare a Homebrew formula in unixlike/modules/platforms/homebrew.nix
  brew remove <formula>    remove a Homebrew formula
  cask add <cask>          declare a Homebrew cask
  cask remove <cask>       remove a Homebrew cask
  mas add <name> <id>      declare a Mac App Store app in unixlike/modules/platforms/homebrew.nix
  mas remove <name>        remove a Mac App Store app
  flake refresh [<input>]  refresh flake.lock, every input or one

mas add/remove edit the masApps attrset: <name> is the Nix attribute and <id>
is the numeric App Store id the maintainer supplies (no lookup here); the mas
CLI itself is already a declared Homebrew formula, so it needs no command of
its own.

Run in a dedicated topic worktree. The helper confirms and commits the edit
locally. It never fetches, pushes, opens a PR, changes branches or prunes.
EOF
}

usage() {
  usage_text >&2
  exit 2
}

refuse() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  printf '  %s\n' "$2" >&2
  exit 1
}

while [ "$#" -gt 0 ]; do
  case $1 in
    --dry-run)
      dry_run=1
      shift
      ;;
    --publish)
      refuse "--publish is retired." "Commit locally; push and master promotion are separate operations."
      ;;
    -h | --help)
      usage_text
      exit 0
      ;;
    -n | --no-verify | --no-hooks | -f | --force)
      refuse "Refusing a hook bypass: $1" \
        "AGENTS.md § Governance design: procedures and tools implement policy but must not silently create new policy. Skipping a gate is a human decision, not this tool's."
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

[ "$#" -gt 0 ] || usage
group=$1
shift

if [ "$group" = prune ]; then
  refuse "prune is retired." "Review named branches and worktrees before explicitly requested cleanup."
fi

# INV repository/change-authoring-in-linked-worktree
# Help and standalone maintenance above do not author source. Refuse all edit
# commands here, before their branch or payload can change.
tool/version-control/require-linked-worktree

item=
input=
mas_id=
case $group in
  brew | cask)
    [ "$#" -eq 2 ] || usage
    action=$1
    item=$2
    case $action in
      add | remove) ;;
      *) usage ;;
    esac
    ;;
  mas)
    [ "$#" -ge 2 ] || usage
    action=$1
    item=$2
    case $action in
      add)
        [ "$#" -eq 3 ] || usage
        mas_id=$3
        ;;
      remove)
        [ "$#" -eq 2 ] || usage
        ;;
      *) usage ;;
    esac
    ;;
  flake)
    [ "$#" -ge 1 ] || usage
    [ "$#" -le 2 ] || usage
    action=$1
    shift
    [ "$action" = refresh ] || usage
    input=${1:-}
    ;;
  *) usage ;;
esac

# A name reaches a Nix string literal and a shell argument list. Keep it to what
# Homebrew and flake inputs actually spell.
valid_name() {
  case $1 in
    '' | *[!A-Za-z0-9._/+-]*) return 1 ;;
  esac
  case $1 in
    *[A-Za-z0-9]*) return 0 ;;
    *) return 1 ;;
  esac
}

# masApps is a Nix attrset, not a string list: <name> reaches a bare attribute
# name rather than a quoted entry. Nix identifiers take digits, underscores and
# dashes unquoted (`microsoft-onedrive = 823766827;` needs no quoting), but not
# a leading digit or a slash; the quoting style a tapped cask uses is a list
# convention that has no counterpart here, so a name that would need it is
# refused rather than quoted.
valid_attr_name() {
  case $1 in
    '' | [!A-Za-z_]* | *[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# The maintainer supplies the numeric App Store id directly; this never looks
# one up.
valid_mas_id() {
  case $1 in
    '' | *[!0-9]*) return 1 ;;
  esac
  return 0
}

if [ "$group" = mas ]; then
  valid_attr_name "$item" \
    || refuse "Not a usable Nix attribute name: $item" \
      "Use lowercase letters, digits, underscores and dashes, for example 'microsoft-onedrive'. A name needing real quoting is a list convention that masApps does not use."
  [ "$action" != add ] || valid_mas_id "$mas_id" \
    || refuse "Not a usable Mac App Store id: $mas_id" \
      "Supply the numeric id mas or the App Store listing shows, for example 409183694 for Keynote. This never looks one up."
else
  [ -z "$item" ] || valid_name "$item" \
    || refuse "Not a usable package name: $item" \
      "Use the name as Homebrew spells it, for example 'displayplacer' or 'nikitabobko/tap/aerospace'."
fi
[ -z "$input" ] || valid_name "$input" \
  || refuse "Not a usable flake input name: $input" \
    "Use the input name as flake.nix declares it, for example 'nixpkgs'."

case $group in
  brew|cask|mas) target=$homebrew_module ;;
  flake) target=unixlike/flake.lock ;;
esac

# classify still owns ownership and check selection.
scope_paths=$target
scope=$("$classify" --files "$target")
case $scope in
  unixlike | windows | common | repository) ;;
  *)
    refuse "$scope_paths has no owning scope: $(printf '%s' "$scope" | tr '\n' ' ')" \
      "Update tool/version-control/classify before committing it. Both gates reject an unclassified path, and a path owned by more than one scope has no single branch to publish from."
    ;;
esac

# Refusals that hold for every command. Checked before any work so that a
# refusal leaves the clone exactly as it was found.
branch=$(git symbolic-ref --quiet --short HEAD || echo detached)
if [ "$branch" = master ]; then
  refuse "Refusing to commit on master." \
    "AGENTS.md: only this repository's dev may enter master, by pull request and merge commit. There is no operational bypass."
fi

if [ -n "$(git diff --cached --name-only)" ]; then
  refuse "The index already holds staged changes." \
    "This helper commits only the edit it makes. Commit or unstage the rest first."
fi

case "$branch" in
  feature/*|fix/*) ;;
  *) refuse "A dedicated topic branch is required." "Create a linked worktree from local dev before editing." ;;
esac

require_untouched() {
  if [ -n "$(git status --porcelain -- "$1")" ]; then
    refuse "$1 already has uncommitted changes." \
      "This helper commits only the edit it makes. Commit or restore that file first."
  fi
}

# Ownership and check selection come from the tools that own those questions.
#
# POSIX sh has no arrays, so the convention here and in
# commit_staged is the message first and one or more paths as the trailing
# variadic parameters.
report_plan() {
  plan_message=$1
  shift

  printf '\nclassification: %s\n' "$scope"
  printf 'checks:\n'
  if hooks_enabled; then
    plan_units=$(selected_units "$@")
    printf '%s\n' "$plan_units" | sed 's/^/  /'
    plan_units_line=$(printf '%s' "$plan_units" | tr '\n' ',' | sed 's/,/, /g')
  else
    # Listing units nothing will run is worse than saying so: the commit would
    # look gated when no check ran at all.
    evidence_unavailable "pre-commit checks" \
      "core.hooksPath is ${hooks_path:-unset}, does not resolve to .githooks; fix with tool/configs setup --fix" \
      || exit 1
    plan_units_line="unavailable; this clone runs no hooks"
  fi
  printf 'message: %s\n' "$plan_message"
  evidence_summary
}

selected_units() {
  for units_path in "$@"; do
    printf 'M\t%s\n' "$units_path"
  done | "$select_checks" commit
}

require_classified() {
  if selected_units "$1" | grep -qx unclassified; then
    refuse "$1 has no owning scope." \
      "Update tool/version-control/classify before committing it. Both gates reject an unclassified path."
  fi
}

confirm() {
  printf '\n%s [y/N] ' "$1"
  if ! IFS= read -r answer; then
    answer=
  fi
  case $answer in
    y | Y)
      # Stdin may be a pipe, which echoes no newline of its own. Start the
      # hook's output on a line of its own either way.
      printf '\n'
      return 0
      ;;
  esac
  printf 'Aborted. Nothing was written.\n'
  exit 1
}

commit_rejected() {
  printf '\033[31m✗ The commit was rejected.\033[0m\n' >&2
  printf '  The edit is left staged. Fix what the hook reported, or discard it with:\n' >&2
  printf '    git restore --staged --worktree --' >&2
  for rejected_path in "$@"; do
    printf ' %s' "$rejected_path" >&2
  done
  printf '\n' >&2
  exit 1
}

# Message first, then every path this commit holds; see report_plan for why.
commit_staged() {
  commit_message=$1
  shift
  if git commit -m "$commit_message"; then return 0; fi
  commit_rejected "$@"
}

# The entries of one Nix string list, in file order. The pattern is strict, and
# the strictness is only safe because require_readable_list refuses the whole
# edit when the list holds a line neither this nor the editor can read. A reader
# that quietly skipped `"displayplacer" # broken` would report that entry as
# absent, and the editor would then add a second copy of it.
list_entries() {
  awk -v list="$1" '
    $0 ~ "^[[:space:]]*" list " = \\[$" { inside = 1; next }
    inside && /^[[:space:]]*\];[[:space:]]*$/ { inside = 0 }
    inside && /^[[:space:]]*"[^"]*"$/ {
      match($0, /"[^"]*"/)
      print substr($0, RSTART + 1, RLENGTH - 2)
    }
  ' "$homebrew_module"
}

# Everything between the opener and `];` must be a blank line, a comment line,
# or a bare quoted entry. Anything else is refused rather than skipped, because
# skipping it is what turns an add into a silent duplicate.
require_readable_list() {
  unreadable=$(awk -v list="$1" '
    $0 ~ "^[[:space:]]*" list " = \\[$" { inside = 1; next }
    inside && /^[[:space:]]*\];[[:space:]]*$/ { inside = 0; next }
    inside {
      if ($0 ~ /^[[:space:]]*$/) next
      if ($0 ~ /^[[:space:]]*#/) next
      if ($0 ~ /^[[:space:]]*"[^"]*"$/) next
      sub(/^[[:space:]]+/, "")
      printf "%d: %s", NR, $0
      exit
    }
  ' "$homebrew_module")

  [ -z "$unreadable" ] || refuse \
    "$homebrew_module line $unreadable" \
    "An entry in $list must be a bare quoted name on its own line. Edit that line by hand; this helper refuses rather than skip it, because skipping it would duplicate an entry."
}

list_indent() {
  awk -v list="$1" '
    $0 ~ "^[[:space:]]*" list " = \\[$" {
      match($0, /^[[:space:]]*/)
      fallback = substr($0, 1, RLENGTH) "  "
      inside = 1
      next
    }
    inside && /^[[:space:]]*\];[[:space:]]*$/ { exit }
    inside && /^[[:space:]]*"[^"]*"$/ {
      match($0, /^[[:space:]]*/)
      print substr($0, 1, RLENGTH)
      found = 1
      exit
    }
    END { if (!found) printf "%s", fallback }
  ' "$homebrew_module"
}

# Insert or delete one entry line and nothing else.
#
# The sort key is the last slash-separated segment, not the whole string:
# casks begins with "nikitabobko/tap/aerospace", sorted under aerospace, so a
# raw-string comparison files a tapped cask in the wrong place.
#
# Comment lines are buffered rather than printed immediately, because a comment
# block belongs to the entry below it. An insert therefore lands above that
# block, and a removal takes the block with the entry: "bettercap" carries
# "Broken on Darwin in the locked nixpkgs", and leaving that behind would
# silently re-attach it to "displayplacer".
edit_list() {
  awk -v list="$1" -v mode="$2" -v item="$3" -v ind="$4" '
    function key(s,   n, p) {
      n = split(s, p, "/")
      return p[n]
    }
    function flush(   i) {
      for (i = 1; i <= buffered; i++) print buf[i]
      buffered = 0
    }
    function insert() {
      printf "%s\"%s\"\n", ind, item
      done = 1
    }
    BEGIN { state = 0; buffered = 0; done = 0 }
    state == 0 {
      print
      if ($0 ~ "^[[:space:]]*" list " = \\[$") state = 1
      next
    }
    state == 1 && /^[[:space:]]*\];[[:space:]]*$/ {
      flush()
      if (mode == "add" && !done) insert()
      print
      state = 2
      next
    }
    state == 1 && /^[[:space:]]*#/ {
      buf[++buffered] = $0
      next
    }
    state == 1 && /^[[:space:]]*"[^"]*"$/ {
      match($0, /"[^"]*"/)
      name = substr($0, RSTART + 1, RLENGTH - 2)
      if (mode == "remove" && name == item) {
        buffered = 0
        next
      }
      if (mode == "add" && !done && key(name) > key(item)) insert()
      flush()
      print
      next
    }
    { flush(); print }
  ' "$homebrew_module"
}

homebrew_command() {
  case $group in
    brew)
      list=brews
      noun=formula
      ;;
    cask)
      list=casks
      noun=cask
      ;;
  esac

  [ -f "$homebrew_module" ] || refuse "$homebrew_module is missing." \
    "This helper edits the Homebrew inventory declared there."
  grep -Eq "^[[:space:]]*$list = \[$" "$homebrew_module" \
    || refuse "$homebrew_module declares no $list list." \
      "Update the module or this helper; they disagree about the file's shape."
  require_readable_list "$list"

  require_untouched "$homebrew_module"

  if list_entries "$list" | grep -Fxq -- "$item"; then
    present=1
  else
    present=0
  fi

  case $action in
    add)
      [ "$present" -eq 0 ] || refuse "$item is already declared in $list." "Nothing to do."
      message="feat(unixlike): add homebrew $noun $item"
      ;;
    remove)
      [ "$present" -eq 1 ] || refuse "$item is not declared in $list." "Nothing to do."
      message="chore(unixlike): remove homebrew $noun $item"
      ;;
  esac

  require_classified "$homebrew_module"

  candidate="$work/candidate"
  edit_list "$list" "$action" "$item" "$(list_indent "$list")" >"$candidate"

  if cmp -s "$homebrew_module" "$candidate"; then
    refuse "The edit would change nothing in $homebrew_module." \
      "The $list list is not shaped the way this helper reads it."
  fi

  printf 'edit: %s\n' "$homebrew_module"
  git --no-pager diff --no-index --no-color -- "$homebrew_module" "$candidate" \
    | sed -n '/^@@/,$p'
  report_plan "$message" "$homebrew_module"

  [ "$dry_run" -eq 0 ] || exit 0

  confirm "Apply this edit and commit?"

  # Written in place so the file keeps its mode and identity.
  cat "$candidate" >"$homebrew_module"
  git add -- "$homebrew_module"
  commit_staged "$message" "$homebrew_module"
}

# The masApps attrset holds `name = id;` pairs rather than the quoted list
# entries edit_list understands, and its main block is followed by a
# `# safari extensions` section that a new entry never enters (issue #92: the
# main block is alphabetized and insertion is alphabetical within it only). A
# name is unique across both sections, so mas_entries and removal look at the
# whole attrset while insertion tracks the boundary itself.
mas_entries() {
  awk '
    $0 ~ "^[[:space:]]*masApps = \\{$" { inside = 1; next }
    inside && /^[[:space:]]*\};[[:space:]]*$/ { inside = 0 }
    inside && /^[[:space:]]*[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*=[[:space:]]*[0-9]+;[[:space:]]*$/ {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      split(line, parts, "=")
      name = parts[1]
      gsub(/[[:space:]]/, "", name)
      print name
    }
  ' "$homebrew_module"
}

# Everything between the opener and the matching `};` must be a blank line,
# the `# safari extensions` marker, a comment, or a bare `name = id;` entry.
# Anything else is refused rather than skipped, for the same reason
# require_readable_list refuses: skipping it would turn an add into a silent
# duplicate.
require_readable_masapps() {
  unreadable=$(awk '
    $0 ~ "^[[:space:]]*masApps = \\{$" { inside = 1; next }
    inside && /^[[:space:]]*\};[[:space:]]*$/ { inside = 0; next }
    inside {
      if ($0 ~ /^[[:space:]]*$/) next
      if ($0 ~ /^[[:space:]]*#/) next
      if ($0 ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*=[[:space:]]*[0-9]+;[[:space:]]*$/) next
      sub(/^[[:space:]]+/, "")
      printf "%d: %s", NR, $0
      exit
    }
  ' "$homebrew_module")

  [ -z "$unreadable" ] || refuse \
    "$homebrew_module line $unreadable" \
    "An entry in masApps must be a bare 'name = id;' line. Edit that line by hand; this helper refuses rather than skip it, because skipping it would duplicate an entry."
}

masapps_indent() {
  awk '
    $0 ~ "^[[:space:]]*masApps = \\{$" {
      match($0, /^[[:space:]]*/)
      fallback = substr($0, 1, RLENGTH) "  "
      inside = 1
      next
    }
    inside && /^[[:space:]]*\};[[:space:]]*$/ { exit }
    inside && /^[[:space:]]*[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*=[[:space:]]*[0-9]+;[[:space:]]*$/ {
      match($0, /^[[:space:]]*/)
      print substr($0, 1, RLENGTH)
      found = 1
      exit
    }
    END { if (!found) printf "%s", fallback }
  ' "$homebrew_module"
}

# Insert or delete one `name = id;` entry. Unlike edit_list, an insertion is
# only ever considered while still in the main block: once the
# `# safari extensions` marker is seen, an add that has not landed yet is
# placed immediately before it, and nothing after the marker is a candidate
# insertion point even when its key would sort later. Removal has no such
# restriction, because an existing entry belongs wherever it already is.
#
# The blank line that separates the two sections is buffered like a comment so
# an insertion at the boundary lands above it rather than between it and the
# marker; that is also why the marker rule inserts before it flushes, the
# opposite order from the closing brace, where a trailing insertion belongs
# after whatever is already buffered.
edit_masapps() {
  awk -v mode="$1" -v item="$2" -v id="$3" -v ind="$4" '
    function flush(   i) {
      for (i = 1; i <= buffered; i++) print buf[i]
      buffered = 0
    }
    function insert() {
      printf "%s%s = %s;\n", ind, item, id
      done = 1
    }
    BEGIN { state = 0; buffered = 0; done = 0; main = 1 }
    state == 0 {
      print
      if ($0 ~ "^[[:space:]]*masApps = \\{$") state = 1
      next
    }
    state == 1 && /^[[:space:]]*\};[[:space:]]*$/ {
      flush()
      if (mode == "add" && !done) insert()
      print
      state = 2
      next
    }
    state == 1 && /^[[:space:]]*# safari extensions[[:space:]]*$/ {
      if (mode == "add" && !done) insert()
      flush()
      print
      main = 0
      next
    }
    state == 1 && /^[[:space:]]*#/ {
      buf[++buffered] = $0
      next
    }
    state == 1 && /^[[:space:]]*$/ {
      buf[++buffered] = $0
      next
    }
    state == 1 && /^[[:space:]]*[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*=[[:space:]]*[0-9]+;[[:space:]]*$/ {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      split(line, parts, "=")
      name = parts[1]
      gsub(/[[:space:]]/, "", name)
      if (mode == "remove" && name == item) {
        buffered = 0
        next
      }
      if (mode == "add" && main && !done && name > item) insert()
      flush()
      print
      next
    }
    { flush(); print }
  ' "$homebrew_module"
}

mas_command() {
  [ -f "$homebrew_module" ] || refuse "$homebrew_module is missing." \
    "This helper edits the Mac App Store inventory declared there."
  grep -Eq '^[[:space:]]*masApps = \{$' "$homebrew_module" \
    || refuse "$homebrew_module declares no masApps attrset." \
      "Update the module or this helper; they disagree about the file's shape."
  require_readable_masapps

  require_untouched "$homebrew_module"

  if mas_entries | grep -Fxq -- "$item"; then
    present=1
  else
    present=0
  fi

  case $action in
    add)
      [ "$present" -eq 0 ] || refuse "$item is already declared in masApps." "Nothing to do."
      message="feat(unixlike): add mas app $item"
      ;;
    remove)
      [ "$present" -eq 1 ] || refuse "$item is not declared in masApps." "Nothing to do."
      message="chore(unixlike): remove mas app $item"
      ;;
  esac

  require_classified "$homebrew_module"

  candidate="$work/candidate"
  edit_masapps "$action" "$item" "$mas_id" "$(masapps_indent)" >"$candidate"

  if cmp -s "$homebrew_module" "$candidate"; then
    refuse "The edit would change nothing in $homebrew_module." \
      "masApps is not shaped the way this helper reads it."
  fi

  printf 'edit: %s\n' "$homebrew_module"
  git --no-pager diff --no-index --no-color -- "$homebrew_module" "$candidate" \
    | sed -n '/^@@/,$p'
  report_plan "$message" "$homebrew_module"

  [ "$dry_run" -eq 0 ] || exit 0

  confirm "Apply this edit and commit?"

  # Written in place so the file keeps its mode and identity.
  cat "$candidate" >"$homebrew_module"
  git add -- "$homebrew_module"
  commit_staged "$message" "$homebrew_module"
}

flake_command() {
  # AGENTS.md § Rules that are expensive to break: do not update flake inputs
  # unless the task calls for it. This is the only command that touches them,
  # and it never runs as a side effect of another one.
  # The lock is the domain's; the commit subjects name the file rather than a
  # location, so they stay as they are.
  flake_lock=unixlike/flake.lock
  flake_dir=unixlike

  require_untouched "$flake_lock"

  if [ -n "$input" ]; then
    message="chore(unixlike-deps): refresh $input in flake.lock"
    action_line="nix flake update $input"
  else
    message="chore(unixlike-deps): refresh flake.lock"
    action_line="nix flake update"
  fi

  require_classified "$flake_lock"

  printf 'edit: %s\n' "$flake_lock"
  printf 'action: %s\n' "$action_line"
  report_plan "$message" "$flake_lock"

  [ "$dry_run" -eq 0 ] || exit 0

  if ! command -v nix >/dev/null 2>&1; then
    evidence_unavailable "flake refresh" "nix is not installed" || exit 1
    evidence_summary
    exit 69
  fi

  # The prompt explicitly authorizes the input update and local commit.
  confirm "Run this update and commit the result?"


  before=$(git hash-object "$flake_lock")
  update_status=0
  if [ -n "$input" ]; then
    nix flake update --flake "./$flake_dir" "$input" || update_status=$?
  else
    nix flake update --flake "./$flake_dir" || update_status=$?
  fi
  if [ "$update_status" != 0 ]; then
    # A failed update may still have written a partial lock.
    git checkout --quiet -- "$flake_lock"
    refuse "$action_line exited $update_status." \
      "Nothing was committed. Read what nix reported and run this again."
  fi
  after=$(git hash-object "$flake_lock")

  if [ "$before" = "$after" ]; then
    printf '\nflake.lock is unchanged; nothing to commit.\n'
    exit 0
  fi

  # CONTRIBUTING.md: flake.lock refreshes go in dedicated chore(unixlike-deps)
  # commits, so nothing else may join this one.
  git add -- "$flake_lock"
  commit_staged "$message" "$flake_lock"
}

case $group in
  brew | cask) homebrew_command ;;
  mas) mas_command ;;
  flake) flake_command ;;
esac
