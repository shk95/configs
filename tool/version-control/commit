#!/bin/sh
#
# Interactive helper for routine desired-state commits: one command that
# applies a templated edit, shows exactly what it will do, and commits it.
#
# It composes the tools that already exist instead of becoming a second source
# of policy, which AGENTS.md line 93 forbids. tool/version-control/classify
# still answers who owns the change, tool/dispatch/select still answers which
# checks it needs, and .githooks/evidence still decides what a check's exit
# status means. Nothing here re-derives any of the three.
#
# The commit is a plain `git commit`, so .githooks/pre-commit runs and its
# output reaches the terminal unaltered. That is the point rather than an
# accident: exit 69 means unverified, not failed, and an unverified check is
# only meaningful if the operator reads it. Publishing gives that stream a
# second reader and copies it into the pull-request body with tee, which is a
# copy rather than an interception: every line still reaches this terminal, in
# order. There is no --no-verify here and no other hook bypass. The hook header
# offers that bypass to a human deciding to skip a gate; a tool that took it
# silently would create new policy.
#
# The scope is edits whose commit message is a template. It is not a general
# Nix editor: it inserts and deletes whole lines and never re-serialises a
# file, leaving tool/checks/format as the arbiter of layout. That check is
# selected automatically, because modules/* classifies unixlike, so a host
# without Nix reports it unverified rather than skipping the question.
#
# --publish carries the same commit the rest of the way: a branch from
# origin/dev, a push, a pull request against dev, and auto-merge. It removes
# ceremony rather than a gate. The pre-push hook still runs, branch protection
# still requires `Required checks` and an up-to-date base, and the merge still
# happens on GitHub's side once those pass. This helper prints the pull-request
# URL and stops; it never waits on CI and never merges anything itself.
#
# Every run ends at one interactive confirmation. There is deliberately no
# unattended mode: no --yes, no --force, no environment override.
#
# usage: tool/version-control/commit [--dry-run] [--publish] <command>

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
classify="$script_dir/classify"
select_checks="$root/tool/dispatch/select"

hooks_dir="$root/.githooks"
. "$hooks_dir/evidence"

# Hooks are opt-in: tool/setup --fix sets core.hooksPath, a fresh clone does
# not. Naming the units a commit needs would otherwise report a gate that never
# applied.
hooks_path=$(git config --get core.hooksPath 2>/dev/null || true)

homebrew_module=modules/darwin-homebrew.nix

# One scratch directory for the candidate edit, the pull-request body and the
# copy of the hook's output. Trapped on the signals a prompt is interrupted
# with as well as on EXIT, because a helper that stops at a question is exactly
# the one an operator interrupts.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT HUP TERM

# What the operator typed, recorded for the pull-request body. Every argument
# that reaches it has already passed valid_name or the subcommand table.
invocation="tool/version-control/commit $*"

publish=0
dry_run=0
create_branch=0
publish_branch=
existing_pr_url=
pr_url=
pr_body_file="$work/pull-request-body"
commit_log=
commit_status="$work/commit.status"
plan_units_line=

usage_text() {
  cat <<'EOF'
usage: tool/version-control/commit [--dry-run] [--publish] <command>

options:
  --dry-run                show everything that would happen and write nothing
  --publish                after committing, push, open a pull request against
                           dev, and arm auto-merge

commands:
  brew add <formula>       declare a Homebrew formula in modules/darwin-homebrew.nix
  brew remove <formula>    remove a Homebrew formula
  cask add <cask>          declare a Homebrew cask
  cask remove <cask>       remove a Homebrew cask
  flake refresh [<input>]  refresh flake.lock, every input or one

On dev the helper first creates feature/<scope>-<topic> from origin/dev; on any
other branch it commits where it is. The change is always confirmed
interactively before anything is written. There is no unattended mode and no
hook bypass.
EOF
}

usage() {
  usage_text >&2
  exit 2
}

refuse() {
  printf '\033[31m✗ %s\033[0m\n' "$1" >&2
  printf '  %s\n' "$2" >&2
  exit 1
}

while [ "$#" -gt 0 ]; do
  case $1 in
    --dry-run)
      dry_run=1
      shift
      ;;
    --publish)
      publish=1
      shift
      ;;
    -h | --help)
      usage_text
      exit 0
      ;;
    -n | --no-verify | --no-hooks | -f | --force)
      refuse "Refusing a hook bypass: $1" \
        "AGENTS.md line 93: procedures and tools implement policy but must not silently create new policy. Skipping a gate is a human decision, not this tool's."
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

[ "$#" -gt 0 ] || usage
group=$1
shift

item=
input=
case $group in
  brew | cask)
    [ "$#" -eq 2 ] || usage
    action=$1
    item=$2
    case $action in
      add | remove) ;;
      *) usage ;;
    esac
    ;;
  flake)
    [ "$#" -ge 1 ] || usage
    [ "$#" -le 2 ] || usage
    action=$1
    shift
    [ "$action" = refresh ] || usage
    input=${1:-}
    ;;
  *) usage ;;
esac

# A name reaches a Nix string literal and a shell argument list. Keep it to what
# Homebrew and flake inputs actually spell.
valid_name() {
  case $1 in
    '' | *[!A-Za-z0-9._/+-]*) return 1 ;;
  esac
  return 0
}

# A branch topic is the name reduced to what a ref and the audit's branch
# pattern both accept: lower case, letters, digits and single hyphens.
# "nikitabobko/tap/aerospace" becomes "nikitabobko-tap-aerospace".
slugify() {
  printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' \
    | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'
}

[ -z "$item" ] || valid_name "$item" \
  || refuse "Not a usable package name: $item" \
    "Use the name as Homebrew spells it, for example 'displayplacer' or 'nikitabobko/tap/aerospace'."
[ -z "$input" ] || valid_name "$input" \
  || refuse "Not a usable flake input name: $input" \
    "Use the input name as flake.nix declares it, for example 'nixpkgs'."

# The file each command edits, and the branch topic that describes the edit.
# CONTRIBUTING.md spells a branch feature/<scope>-<topic>, and
# tool/version-control/audit enforces that spelling; both halves are read from
# the tools that own them rather than restated here.
case $group in
  brew | cask)
    target=$homebrew_module
    topic="$group-$action-$(slugify "$item")"
    ;;
  flake)
    target=flake.lock
    if [ -n "$input" ]; then
      topic="deps-refresh-$(slugify "$input")"
    else
      topic=deps-refresh
    fi
    ;;
esac

# A name of nothing but punctuation slugifies to nothing and would spell
# feature/unixlike-brew-add-, which the audit's branch pattern rejects.
case $topic in
  *-)
    refuse "No branch topic can be derived from that name." \
      "A branch topic is the name reduced to letters, digits and hyphens, and that leaves nothing here."
    ;;
esac

# classify still owns ownership. A path it cannot place, or places in more than
# one scope, has no single branch to be published from.
scope=$("$classify" --files "$target")
case $scope in
  unixlike | windows | common | repository) ;;
  *)
    refuse "$target has no owning scope: $(printf '%s' "$scope" | tr '\n' ' ')" \
      "Update tool/version-control/classify before committing it. Both gates reject an unclassified path, and a path owned by more than one scope has no single branch to publish from."
    ;;
esac

# Refusals that hold for every command. Checked before any work so that a
# refusal leaves the clone exactly as it was found.
branch=$(git symbolic-ref --quiet --short HEAD || echo detached)
if [ "$branch" = master ]; then
  refuse "Refusing to commit on master." \
    "AGENTS.md: only this repository's dev may enter master, by pull request and merge commit. There is no operational bypass."
fi

if [ -n "$(git diff --cached --name-only)" ]; then
  refuse "The index already holds staged changes." \
    "This helper commits only the edit it makes. Commit or unstage the rest first."
fi

# On dev the helper works on a branch of its own; anywhere else it commits
# where it is. The branch is created after the confirmation, not here, so this
# only decides the name and refuses what cannot work.
if [ "$branch" = dev ]; then
  create_branch=1
  publish_branch="feature/$scope-$topic"

  if ! git rev-parse --verify --quiet refs/remotes/origin/dev >/dev/null; then
    refuse "origin/dev is unavailable." \
      "This helper branches from origin/dev. Run 'git fetch origin dev' first."
  fi
  # The edit below is computed against the tree of local dev. Branching from a
  # different origin/dev would carry it onto a tree it was never computed
  # against, so the two have to be the same commit. dev's protection already
  # requires an up-to-date base; this asks for nothing new.
  if [ "$(git rev-parse refs/heads/dev)" != "$(git rev-parse refs/remotes/origin/dev)" ]; then
    refuse "dev is not at origin/dev." \
      "Fast-forward first: git fetch origin dev && git merge --ff-only origin/dev."
  fi
  if git show-ref --verify --quiet "refs/heads/$publish_branch"; then
    refuse "$publish_branch already exists." \
      "That edit already has a branch. Finish or delete it before starting it again."
  fi
else
  publish_branch=$branch
fi

if [ "$publish" -eq 1 ] && [ "$branch" = detached ]; then
  refuse "HEAD is detached, so there is no branch to publish." \
    "Switch to dev or to the feature branch this change belongs on."
fi

# gh and the remote are consulted only when --publish asks for them, and only
# ever read here. Nothing below writes.
publish_preflight() {
  if ! command -v gh >/dev/null 2>&1; then
    refuse "gh is unavailable and --publish needs it." \
      "Install the GitHub CLI (https://cli.github.com), or drop --publish and open the pull request yourself."
  fi
  if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    refuse "gh is not authenticated for github.com." \
      "Run 'gh auth login' first. This helper opens the pull request as you and holds no credential of its own."
  fi

  # One listing answers both questions: a pull request from this head against
  # anything but dev is a refusal, and one against dev is the pull request to
  # arm rather than a second one to open.
  open_pulls=$(gh pr list --head "$publish_branch" --state open \
    --json baseRefName,url --jq '.[] | .baseRefName + " " + .url')
  foreign=$(printf '%s\n' "$open_pulls" | awk '$1 != "dev" && NF { print $2 }')
  if [ -n "$foreign" ]; then
    refuse "$publish_branch already has an open pull request with a different base." \
      "Close or retarget it first: $(printf '%s' "$foreign" | tr '\n' ' ')"
  fi
  existing_pr_url=$(printf '%s\n' "$open_pulls" | awk '$1 == "dev" { print $2; exit }')

  # A branch this helper is about to create must not already exist on the
  # remote: publishing onto it would have to force or merge, and neither is
  # this helper's decision to make.
  if [ "$create_branch" -eq 1 ] \
    && git ls-remote --exit-code --heads origin "$publish_branch" >/dev/null 2>&1; then
    refuse "origin already has $publish_branch." \
      "Finish or delete that branch first; this helper neither forces nor merges onto an existing one."
  fi
}

if [ "$publish" -eq 1 ]; then
  publish_preflight
fi

require_untouched() {
  if [ -n "$(git status --porcelain -- "$1")" ]; then
    refuse "$1 already has uncommitted changes." \
      "This helper commits only the edit it makes. Commit or restore that file first."
  fi
}

# Ownership and check selection come from the tools that own those questions.
report_plan() {
  plan_path=$1
  plan_message=$2

  printf '\nclassification: %s\n' "$scope"
  printf 'checks:\n'
  if [ "$hooks_path" = .githooks ]; then
    plan_units=$(selected_units "$plan_path")
    printf '%s\n' "$plan_units" | sed 's/^/  /'
    plan_units_line=$(printf '%s' "$plan_units" | tr '\n' ',' | sed 's/,/, /g')
  else
    # Listing units nothing will run is worse than saying so: the commit would
    # look gated when no check ran at all.
    evidence_unavailable "pre-commit checks" \
      "core.hooksPath is ${hooks_path:-unset}, not .githooks; fix with tool/setup --fix" \
      || exit 1
    plan_units_line="unavailable; this clone runs no hooks"
  fi
  printf 'message: %s\n' "$plan_message"
  evidence_summary
}

selected_units() {
  printf 'M\t%s\n' "$1" | "$select_checks" commit
}

require_classified() {
  if selected_units "$1" | grep -qx unclassified; then
    refuse "$1 has no owning scope." \
      "Update tool/version-control/classify before committing it. Both gates reject an unclassified path."
  fi
}

# The pull-request body carries what a reviewer cannot get from the diff: who
# owns the change, which checks the local gate selected, the exact command that
# produced it, and what the pre-commit hook reported on the machine it was made
# on. Nothing here is re-derived; every line comes from a tool that already
# answered the question.
build_pr_body() {
  body_evidence=$1
  {
    printf 'Scope: %s\n' "$scope"
    printf 'Selected checks: %s\n' "$plan_units_line"
    printf 'Command: %s\n' "$invocation"

    commit_body=$(printf '%s\n' "$message" | sed -n '2,$p')
    if [ -n "$commit_body" ]; then
      printf '\n%s\n' "$commit_body"
    fi

    printf '\nLocal pre-commit evidence:\n\n'
    printf '```text\n'
    if [ -n "$body_evidence" ] && [ -s "$body_evidence" ]; then
      # The hook colours its failures; a pull request renders the escape bytes
      # rather than the colour.
      sed "s/$(printf '\033')\[[0-9;]*m//g" "$body_evidence"
    else
      printf '(the pre-commit hook output, once the commit runs)\n'
    fi
    printf '```\n'

    printf '\nOpened by tool/version-control/commit. Auto-merge is armed, so the\n'
    printf 'merge commit happens when `Required checks` pass and not before.\n'
  } >"$pr_body_file"
}

report_publish_plan() {
  [ "$create_branch" -eq 1 ] || [ "$publish" -eq 1 ] || return 0

  printf '\n'
  if [ "$create_branch" -eq 1 ]; then
    printf 'branch: %s (new, from origin/dev)\n' "$publish_branch"
  else
    printf 'branch: %s (current)\n' "$publish_branch"
  fi
  [ "$publish" -eq 1 ] || return 0

  build_pr_body ""
  printf 'pull request title: %s\n' "$message"
  printf 'pull request body:\n'
  sed 's/^/  /' "$pr_body_file"
  printf 'commands:\n'
  if [ "$create_branch" -eq 1 ]; then
    printf '  git fetch --quiet origin dev\n'
    printf '  git switch --quiet --create %s origin/dev\n' "$publish_branch"
  fi
  printf '  git push --set-upstream origin %s\n' "$publish_branch"
  if [ -n "$existing_pr_url" ]; then
    printf '  gh pr merge --auto --merge %s\n' "$existing_pr_url"
    printf '  (that pull request is already open against dev; no second one is opened)\n'
  else
    printf '  gh pr create --base dev --head %s --title %s --body-file <body>\n' \
      "$publish_branch" "'$message'"
    printf '  gh pr merge --auto --merge <the pull request that opens>\n'
  fi
}

# The first write of the run, and only after the confirmation.
create_publish_branch() {
  [ "$create_branch" -eq 1 ] || return 0

  git fetch --quiet origin dev
  if [ "$(git rev-parse refs/heads/dev)" != "$(git rev-parse refs/remotes/origin/dev)" ]; then
    refuse "origin/dev moved while this was waiting for an answer." \
      "Nothing was written. Fast-forward dev and run this again."
  fi
  git switch --quiet --create "$publish_branch" origin/dev
  printf 'branch: created %s from origin/dev\n' "$publish_branch"
}

publish_commit() {
  [ "$publish" -eq 1 ] || return 0

  build_pr_body "$commit_log"

  printf '\n→ pushing %s\n' "$publish_branch"
  # A plain push, so .githooks/pre-push selects and runs the checks the pushed
  # content owns. A rejection stops here with the commit local; nothing is
  # retried and nothing is bypassed.
  if ! git push --set-upstream origin "$publish_branch"; then
    printf '\033[31m✗ The push was rejected.\033[0m\n' >&2
    printf '  The commit is local on %s and nothing was published. Fix what the hook\n' \
      "$publish_branch" >&2
    printf '  or the remote reported and push again; nothing here retries with a bypass.\n' >&2
    exit 1
  fi

  if [ -n "$existing_pr_url" ]; then
    pr_url=$existing_pr_url
    printf '→ reusing the pull request already open against dev\n'
  else
    printf '→ opening a pull request against dev\n'
    if ! pr_created=$(gh pr create --base dev --head "$publish_branch" \
      --title "$message" --body-file "$pr_body_file"); then
      printf '\033[31m✗ The pull request could not be opened.\033[0m\n' >&2
      printf '  The commit is pushed to %s. Open the pull request against dev yourself.\n' \
        "$publish_branch" >&2
      exit 1
    fi
    pr_url=$(printf '%s\n' "$pr_created" | sed -n 's|^\(https://[^ ]*\)$|\1|p' | tail -1)
  fi

  if [ -z "$pr_url" ]; then
    printf '\033[31m✗ No pull-request URL came back.\033[0m\n' >&2
    printf '  The commit is pushed to %s. Check the pull request on GitHub.\n' \
      "$publish_branch" >&2
    exit 1
  fi

  # --merge, never --admin: auto-merge waits for Required checks, and that
  # wait is the whole gate this flag exists to keep.
  printf '→ arming auto-merge\n'
  if ! gh pr merge --auto --merge "$pr_url"; then
    printf '\033[31m✗ Auto-merge could not be armed.\033[0m\n' >&2
    printf '  The pull request is open: %s\n' "$pr_url" >&2
    printf '  Arm it there, or merge it once Required checks pass.\n' >&2
    exit 1
  fi

  printf '\n%s\n' "$pr_url"
}

confirm() {
  printf '\n%s [y/N] ' "$1"
  if ! IFS= read -r answer; then
    answer=
  fi
  case $answer in
    y | Y)
      # Stdin may be a pipe, which echoes no newline of its own. Start the
      # hook's output on a line of its own either way.
      printf '\n'
      return 0
      ;;
  esac
  printf 'Aborted. Nothing was written.\n'
  exit 1
}

commit_rejected() {
  printf '\033[31m✗ The commit was rejected.\033[0m\n' >&2
  printf '  The edit is left staged. Fix what the hook reported, or discard it with:\n' >&2
  printf '    git restore --staged --worktree -- %s\n' "$1" >&2
  exit 1
}

commit_staged() {
  commit_path=$1
  commit_message=$2

  if [ "$publish" -eq 0 ]; then
    # No capture, no pipe, no redirection: the hook's evidence lines and its
    # closing unverified summary are the operator's to read.
    if git commit -m "$commit_message"; then
      return 0
    fi
    commit_rejected "$commit_path"
  fi

  # Publishing gives those lines a second reader, and nobody reviews a pull
  # request by scrolling somebody else's terminal. tee copies rather than
  # intercepts, so every line still reaches this terminal in order; git's own
  # status leaves the pipeline through a file, because tee's would always be 0.
  commit_log="$work/commit.log"
  {
    if git commit -m "$commit_message" 2>&1; then
      printf '0\n' >"$commit_status"
    else
      printf '%s\n' "$?" >"$commit_status"
    fi
  } | tee "$commit_log"
  if [ "$(cat "$commit_status")" = 0 ]; then
    return 0
  fi
  commit_rejected "$commit_path"
}

# The entries of one Nix string list, in file order. The pattern is strict, and
# the strictness is only safe because require_readable_list refuses the whole
# edit when the list holds a line neither this nor the editor can read. A reader
# that quietly skipped `"displayplacer" # broken` would report that entry as
# absent, and the editor would then add a second copy of it.
list_entries() {
  awk -v list="$1" '
    $0 ~ "^[[:space:]]*" list " = \\[$" { inside = 1; next }
    inside && /^[[:space:]]*\];[[:space:]]*$/ { inside = 0 }
    inside && /^[[:space:]]*"[^"]*"$/ {
      match($0, /"[^"]*"/)
      print substr($0, RSTART + 1, RLENGTH - 2)
    }
  ' "$homebrew_module"
}

# Everything between the opener and `];` must be a blank line, a comment line,
# or a bare quoted entry. Anything else is refused rather than skipped, because
# skipping it is what turns an add into a silent duplicate.
require_readable_list() {
  unreadable=$(awk -v list="$1" '
    $0 ~ "^[[:space:]]*" list " = \\[$" { inside = 1; next }
    inside && /^[[:space:]]*\];[[:space:]]*$/ { inside = 0; next }
    inside {
      if ($0 ~ /^[[:space:]]*$/) next
      if ($0 ~ /^[[:space:]]*#/) next
      if ($0 ~ /^[[:space:]]*"[^"]*"$/) next
      sub(/^[[:space:]]+/, "")
      printf "%d: %s", NR, $0
      exit
    }
  ' "$homebrew_module")

  [ -z "$unreadable" ] || refuse \
    "$homebrew_module line $unreadable" \
    "An entry in $list must be a bare quoted name on its own line. Edit that line by hand; this helper refuses rather than skip it, because skipping it would duplicate an entry."
}

list_indent() {
  awk -v list="$1" '
    $0 ~ "^[[:space:]]*" list " = \\[$" {
      match($0, /^[[:space:]]*/)
      fallback = substr($0, 1, RLENGTH) "  "
      inside = 1
      next
    }
    inside && /^[[:space:]]*\];[[:space:]]*$/ { exit }
    inside && /^[[:space:]]*"[^"]*"$/ {
      match($0, /^[[:space:]]*/)
      print substr($0, 1, RLENGTH)
      found = 1
      exit
    }
    END { if (!found) printf "%s", fallback }
  ' "$homebrew_module"
}

# Insert or delete one entry line and nothing else.
#
# The sort key is the last slash-separated segment, not the whole string:
# casks begins with "nikitabobko/tap/aerospace", sorted under aerospace, so a
# raw-string comparison files a tapped cask in the wrong place.
#
# Comment lines are buffered rather than printed immediately, because a comment
# block belongs to the entry below it. An insert therefore lands above that
# block, and a removal takes the block with the entry: "bettercap" carries
# "Broken on Darwin in the locked nixpkgs", and leaving that behind would
# silently re-attach it to "displayplacer".
edit_list() {
  awk -v list="$1" -v mode="$2" -v item="$3" -v ind="$4" '
    function key(s,   n, p) {
      n = split(s, p, "/")
      return p[n]
    }
    function flush(   i) {
      for (i = 1; i <= buffered; i++) print buf[i]
      buffered = 0
    }
    function insert() {
      printf "%s\"%s\"\n", ind, item
      done = 1
    }
    BEGIN { state = 0; buffered = 0; done = 0 }
    state == 0 {
      print
      if ($0 ~ "^[[:space:]]*" list " = \\[$") state = 1
      next
    }
    state == 1 && /^[[:space:]]*\];[[:space:]]*$/ {
      flush()
      if (mode == "add" && !done) insert()
      print
      state = 2
      next
    }
    state == 1 && /^[[:space:]]*#/ {
      buf[++buffered] = $0
      next
    }
    state == 1 && /^[[:space:]]*"[^"]*"$/ {
      match($0, /"[^"]*"/)
      name = substr($0, RSTART + 1, RLENGTH - 2)
      if (mode == "remove" && name == item) {
        buffered = 0
        next
      }
      if (mode == "add" && !done && key(name) > key(item)) insert()
      flush()
      print
      next
    }
    { flush(); print }
  ' "$homebrew_module"
}

homebrew_command() {
  case $group in
    brew)
      list=brews
      noun=formula
      ;;
    cask)
      list=casks
      noun=cask
      ;;
  esac

  [ -f "$homebrew_module" ] || refuse "$homebrew_module is missing." \
    "This helper edits the Homebrew inventory declared there."
  grep -Eq "^[[:space:]]*$list = \[$" "$homebrew_module" \
    || refuse "$homebrew_module declares no $list list." \
      "Update the module or this helper; they disagree about the file's shape."
  require_readable_list "$list"

  require_untouched "$homebrew_module"

  if list_entries "$list" | grep -Fxq -- "$item"; then
    present=1
  else
    present=0
  fi

  case $action in
    add)
      [ "$present" -eq 0 ] || refuse "$item is already declared in $list." "Nothing to do."
      message="feat(unixlike): add homebrew $noun $item"
      ;;
    remove)
      [ "$present" -eq 1 ] || refuse "$item is not declared in $list." "Nothing to do."
      message="chore(unixlike): remove homebrew $noun $item"
      ;;
  esac

  require_classified "$homebrew_module"

  candidate="$work/candidate"
  edit_list "$list" "$action" "$item" "$(list_indent "$list")" >"$candidate"

  if cmp -s "$homebrew_module" "$candidate"; then
    refuse "The edit would change nothing in $homebrew_module." \
      "The $list list is not shaped the way this helper reads it."
  fi

  printf 'edit: %s\n' "$homebrew_module"
  git --no-pager diff --no-index --no-color -- "$homebrew_module" "$candidate" \
    | sed -n '/^@@/,$p'
  report_plan "$homebrew_module" "$message"
  report_publish_plan

  [ "$dry_run" -eq 0 ] || exit 0

  if [ "$publish" -eq 1 ]; then
    confirm "Commit and publish this change?"
  else
    confirm "Apply this edit and commit?"
  fi

  # The branch comes first, while the tree still matches HEAD, so switching
  # cannot disturb an edit that has not been made yet.
  create_publish_branch

  # Written in place so the file keeps its mode and identity.
  cat "$candidate" >"$homebrew_module"
  git add -- "$homebrew_module"
  commit_staged "$homebrew_module" "$message"
  publish_commit
}

flake_command() {
  # AGENTS.md line 127: do not update flake inputs unless the task calls for
  # it. This is the only command that touches them, and it never runs as a side
  # effect of another one.
  require_untouched flake.lock

  if [ -n "$input" ]; then
    message="chore(unixlike-deps): refresh $input in flake.lock"
    action_line="nix flake update $input"
  else
    message="chore(unixlike-deps): refresh flake.lock"
    action_line="nix flake update"
  fi

  require_classified flake.lock

  printf 'edit: flake.lock\n'
  printf 'action: %s\n' "$action_line"
  report_plan flake.lock "$message"
  report_publish_plan

  [ "$dry_run" -eq 0 ] || exit 0

  if ! command -v nix >/dev/null 2>&1; then
    evidence_unavailable "flake refresh" "nix is not installed" || exit 1
    evidence_summary
    exit 69
  fi

  # Named rather than folded into the publish wording: an update writes, and
  # the prompt that authorises it has to say so.
  if [ "$publish" -eq 1 ]; then
    confirm "Run this update, then commit and publish?"
  else
    confirm "Run this update and commit the result?"
  fi

  create_publish_branch

  before=$(git hash-object flake.lock)
  if [ -n "$input" ]; then
    nix flake update "$input"
  else
    nix flake update
  fi
  after=$(git hash-object flake.lock)

  if [ "$before" = "$after" ]; then
    printf '\nflake.lock is unchanged; nothing to commit.\n'
    # Leaving an empty branch behind would be a write with nothing to show for
    # it, and the next run would then refuse because that branch exists.
    if [ "$create_branch" -eq 1 ]; then
      git switch --quiet dev
      git branch --quiet --delete "$publish_branch"
      printf 'branch: removed the empty %s\n' "$publish_branch"
    fi
    exit 0
  fi

  # CONTRIBUTING.md: flake.lock refreshes go in dedicated chore(unixlike-deps)
  # commits, so nothing else may join this one.
  git add -- flake.lock
  commit_staged flake.lock "$message"
  publish_commit
}

case $group in
  brew | cask) homebrew_command ;;
  flake) flake_command ;;
esac
