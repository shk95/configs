#!/bin/sh
# Offline synthetic repository proof. Never touches the caller's refs or remote.
# INV repository/release-preview-read-only
# INV repository/msys-argument-guard
set -eu
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL
LC_ALL=C
export LC_ALL
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_CEILING_DIRECTORIES GIT_INDEX_FILE
tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
preview="$tools/release-preview"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL="$scratch/no-global-config"
mkdir "$scratch/repo"
cd "$scratch/repo"
git init -q -b dev
git config user.name Fixture
git config user.email fixture@example.invalid
git config core.hooksPath "$scratch/no-hooks"
mkdir -p tool/version-control docs/reference unixlike/api windows/desired
cp "$tools/release-preview.rules" tool/version-control/release-preview.rules
cat >>tool/version-control/release-preview.rules <<'EOF'
check	windows-generation	windows	fixtures	required	-	pwsh-7.6.6
check	advisory-check	repository	review	advisory	-	advisory-v1
map	prefix	windows/desired/	windows-generation
map	exact	unixlike/tool/candidate-script	unixlike-inspection
map	prefix	tool/version-control/	repository-policy
map	prefix	.agents/	repository-policy
EOF
printf 'unixlike/api/* merge=fixture filter=fixture diff=fixture\n' >.gitattributes
printf 'old\n' >unixlike/api/contract.json
printf 'old\n' >windows/desired/example.json
printf 'Synthetic migration.\n' >docs/reference/migration.md
git add .
git commit -qm 'feat(repository): initialize synthetic fixture'
base=$(git rev-parse HEAD)
rules=$base
tag() {
  domain=$1; version=$2; source=$3
  printf 'Release-Format: 1\nDomain: %s\nVersion: %s\nSource: %s\n' "$domain" "$version" "$source" >"$scratch/tag-message"
  git tag -a "$domain-v$version" "$source" -F "$scratch/tag-message"
}
tag unixlike 1.0.0 "$base"
tag windows 1.0.0 "$base"
tag unixlike 2026.08.31 "$base"
baselines="$scratch/baselines"
evidence="$scratch/evidence"
output="$scratch/output"
printf 'format\t1\nsemantic\tunixlike\t1.0.0\tunixlike-v1.0.0\nsemantic\twindows\t1.0.0\twindows-v1.0.0\n' >"$baselines"
default_baselines() {
  printf 'format\t1\nsemantic\tunixlike\t1.0.0\tunixlike-v1.0.0\nsemantic\twindows\t1.0.0\twindows-v1.0.0\n' >"$baselines"
}
declaration() {
  domain=$1; impact=$2; contracts=$3; compatibility=${4:-compatible}; migration=${5:-none}; revert=${6:-}
  printf 'feat(%s): synthetic %s change\n\nRelease-Format: 1\nRelease-Domain: %s\nRelease-Impact: %s\nRelease-Contracts: %s\nRelease-Compatibility: %s\nRelease-Rationale: Synthetic compatibility intent.\nRelease-Migration: %s\n' "$domain" "$impact" "$domain" "$impact" "$contracts" "$compatibility" "$migration" >"$scratch/message"
  if [ -n "$revert" ]; then printf 'Release-Reverts: %s\n' "$revert" >>"$scratch/message"; fi
  git add .
  git commit -q -F "$scratch/message"
}
prepare_evidence() {
  candidate=$(git rev-parse HEAD)
  master=${master_override:-$base}
  tree=$(git merge-tree --write-tree "$master" "$candidate")
  printf 'format\t1\n' >"$evidence"
  awk -F'\t' -v candidate="$candidate" -v master="$master" -v tree="$tree" -v rules="$rules" '$1=="check" { print "evidence\t" $2 "\t" candidate "\t" master "\t" tree "\t" rules "\t" $7 "\tverified\tfixture://" $2 }' tool/version-control/release-preview.rules >>"$evidence"
}
run() {
  "$preview" --master "${master_override:-$base}" --candidate HEAD --rules "$rules" --baselines "$baselines" --evidence "$evidence" --json >"$output"
}
assert_text() {
  grep -Fq "$1" "$output" || { echo "missing expected output: $1" >&2; cat "$output" >&2; exit 1; }
}
pass() { run || { cat "$output" >&2; exit 1; }; assert_text '"decision":"candidate"'; }
refusal() {
  if run; then echo "unexpectedly accepted $1" >&2; cat "$output" >&2; exit 1; fi
  assert_text '"decision":"refusal"'; assert_text "\"$1\""
}
pin_rules() {
  git add tool/version-control/release-preview.rules
  git commit -qm 'docs(repository): synthetic rule adjustment'
  rules=$(git rev-parse HEAD)
}
reset_case() { git reset --hard -q "$base"; git clean -fdq; default_baselines; rules=$base; unset master_override; }

# ----------
# Metadata grammar and ownership
# ----------
#
# INV repository/release-preview-read-only
printf 'patched\n' >unixlike/api/contract.json
declaration unixlike patch unixlike-api
prepare_evidence; pass; assert_text '"next_version":"1.0.1"'
git commit --amend -q -m 'fix(unixlike): missing declaration'
prepare_evidence; refusal missing-release-trailer
git commit --amend -q -F "$scratch/message"
printf 'Release-Future: unsupported\n' >>"$scratch/message"
git commit --amend -q -F "$scratch/message"
prepare_evidence; refusal unknown-release-trailer
sed '/Release-Future:/d' "$scratch/message" >"$scratch/changed-message"
printf 'Release-Impact: minor\n' >>"$scratch/changed-message"
git commit --amend -q -F "$scratch/changed-message"
prepare_evidence; refusal invalid-release-trailer
sed 's/Release-Impact: patch/Release-Impact: patch/;s/Release-Compatibility: compatible/Release-Compatibility: breaking/' "$scratch/message" | sed '/Release-Future:/d' >"$scratch/changed-message"
git commit --amend -q -F "$scratch/changed-message"
prepare_evidence; refusal incompatible-impact
git commit --amend -q -F "$scratch/message"
prepare_evidence
printf 'future\t1\n' >"$evidence"; refusal invalid-replay-format
prepare_evidence
printf 'evidence\tunknown\tbad\tbad\tbad\tbad\ttest\tverified\tfixture\n' >>"$evidence"
refusal invalid-evidence-record
prepare_evidence
printf 'bad\001value\n' >>"$evidence"; refusal invalid-replay-format

reset_case
printf 'wrong contract\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-readiness
prepare_evidence; refusal release-contract-path-mismatch
reset_case
printf 'wrong domain\n' >unixlike/api/contract.json; declaration windows patch windows-generation
prepare_evidence; refusal release-domain-mismatch
reset_case
printf 'unknown compatibility\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api unknown
prepare_evidence; refusal unknown-compatibility
reset_case
printf 'empty baseline\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api
printf 'format\t1\n' >"$baselines"
prepare_evidence; refusal missing-domain-baseline

# ----------
# Independent bootstrap and immutable legacy history
# ----------
#
# INV repository/release-preview-read-only
# INV repository/release-tag-contract
reset_case
candidate=$(git rev-parse HEAD)
printf 'format\t1\ndomain\tunixlike\nsource\t%s\nversion\t1.0.0\ncontracts\tunixlike-api\n' "$candidate" >"$scratch/bootstrap-record"
blob=$(git hash-object -w --no-filters "$scratch/bootstrap-record")
record_tree=$(printf '100644 blob %s\tbootstrap.tsv\n' "$blob" | git mktree)
record_commit=$(printf 'docs(repository): synthetic reviewed bootstrap\n' | git commit-tree "$record_tree" -p "$candidate")
printf 'format\t1\nbootstrap\tunixlike\t%s\t%s\tbootstrap.tsv\n' "$candidate" "$record_commit" >"$baselines"
prepare_evidence
tags_before=$(git show-ref --tags)
pass; assert_text '"next_version":"1.0.0"'
[ "$tags_before" = "$(git show-ref --tags)" ] || { echo 'preview altered legacy tags' >&2; exit 1; }
printf 'format\t1\nbootstrap\tunixlike\t%s\t%s\tmissing.tsv\n' "$candidate" "$record_commit" >"$baselines"
refusal missing-bootstrap-record
printf 'format\t1\nsemantic\tunixlike\t2026.08.31\tunixlike-v2026.08.31\n' >"$baselines"
refusal invalid-semantic-baseline
printf 'format\t1\nsemantic\tunixlike\t1.0.0\tunixlike-v1.0.0\nsemantic\tunixlike\t1.0.0\tunixlike-v1.0.0\n' >"$baselines"
refusal invalid-baseline-domain

reset_case
# Calendar-looking numerals without preview-format annotation remain legacy data.
printf 'Domain: unixlike\nVersion: 2026.10.30\nSource: %s\n' "$base" >"$scratch/tag-message"
git tag -a unixlike-v2026.10.30 "$base" -F "$scratch/tag-message"
printf 'format\t1\nsemantic\tunixlike\t2026.10.30\tunixlike-v2026.10.30\n' >"$baselines"
prepare_evidence; refusal baseline-annotation-mismatch
reset_case
git tag unixlike-v1.0.2 "$base"
printf 'format\t1\nsemantic\tunixlike\t1.0.2\tunixlike-v1.0.2\n' >"$baselines"
prepare_evidence; refusal unannotated-baseline

# ----------
# Cumulative versions and exact versus ambiguous reverts
# ----------
#
# INV repository/release-preview-read-only
reset_case
printf 'patch\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api
first=$(git rev-parse HEAD)
printf 'minor\n' >unixlike/api/contract.json; declaration unixlike minor unixlike-api
prepare_evidence; pass; assert_text '"next_version":"1.1.0"'
printf 'major\n' >unixlike/api/contract.json; declaration unixlike major unixlike-api breaking docs/reference/migration.md
prepare_evidence; pass; assert_text '"next_version":"2.0.0"'; assert_text '"approval_reasons":["major","migration"]'
reset_case
printf 'new\n' >unixlike/api/contract.json; declaration unixlike minor unixlike-api
target=$(git rev-parse HEAD)
printf 'old\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api compatible none "$target"
prepare_evidence; pass; assert_text '"next_version":null'; assert_text '"canceled":true'
reset_case
printf 'new\n' >unixlike/api/contract.json; declaration unixlike minor unixlike-api
target=$(git rev-parse HEAD)
printf 'partial\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api compatible none "$target"
prepare_evidence; refusal noninverse-revert
reset_case
printf 'published\n' >unixlike/api/contract.json; declaration unixlike minor unixlike-api
released=$(git rev-parse HEAD)
tag unixlike 1.1.0 "$released"
printf 'format\t1\nsemantic\tunixlike\t1.1.0\tunixlike-v1.1.0\n' >"$baselines"
printf 'old\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api compatible none "$released"
prepare_evidence; pass; assert_text '"next_version":"1.1.1"'; assert_text '"released_revert":true'

reset_case
printf 'windows target\n' >windows/desired/example.json; declaration windows patch windows-generation
wrong_target=$(git rev-parse HEAD)
printf 'unixlike revert\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api compatible none "$wrong_target"
prepare_evidence; refusal cross-domain-revert
reset_case
printf 'revert target missing\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api compatible none deadbeef
prepare_evidence; refusal invalid-revert-target
reset_case
printf 'first change\n' >unixlike/api/contract.json; declaration unixlike minor unixlike-api
target=$(git rev-parse HEAD)
printf 'old\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api compatible none "$target"
printf 'repeated claim\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api compatible none "$target"
prepare_evidence; refusal ambiguous-revert

# ----------
# Full promotion delta and mapped/excluded/unknown cases
# ----------
#
# INV repository/release-preview-read-only
# INV repository/local-gate-selects-by-effect
reset_case
printf 'A\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api
prepare_evidence; cp "$evidence" "$scratch/evidence-A"
printf 'B\n' >windows/desired/example.json; declaration windows minor windows-generation
prepare_evidence; pass; assert_text '"id":"unixlike-api"'; assert_text '"id":"windows-generation"'
cp "$scratch/evidence-A" "$evidence"; refusal evidence-identity-mismatch
prepare_evidence
git mv unixlike/api/contract.json unixlike/api/renamed.json; declaration unixlike patch unixlike-api
prepare_evidence; pass
mkdir -p unixlike/unmapped; printf 'unknown\n' >unixlike/unmapped/input.nix; declaration unixlike patch unixlike-api
prepare_evidence; refusal mapping-review-needed
reset_case
mkdir common; printf 'unknown\n' >common/component; git add .; git commit -qm 'feat(common): synthetic unsupported component'
prepare_evidence; refusal unsupported-common
reset_case
printf 'documentation\n' >docs/reference/new.md; git add .; git commit -qm 'docs(repository): synthetic source-only update'
printf 'format\t1\n' >"$baselines"
prepare_evidence; pass; assert_text '"domains":[]'; assert_text '"id":"repository-policy"'; assert_text '"unixlike-api"'

reset_case
rm unixlike/api/contract.json; declaration unixlike patch unixlike-api
prepare_evidence; pass; assert_text '"status":"D"'
reset_case
printf 'newly added\n' >unixlike/api/added.json; declaration unixlike patch unixlike-api
prepare_evidence; pass; assert_text '"status":"A"'; assert_text '"paths":["unixlike/api/added.json"]'
reset_case
printf 'format\t1\n' >"$baselines"; prepare_evidence; run; assert_text '"decision":"no-op"'
printf 'governance\n' >tool/version-control/governance-only
 git add .; git commit -qm 'chore(repository): synthetic governance-only update'
prepare_evidence; pass; assert_text '"domains":[]'
reset_case
printf 'check\tcycle-a\trepository\treview\trequired\tcycle-b\tfixture-v1\ncheck\tcycle-b\trepository\treview\trequired\tcycle-a\tfixture-v1\n' >>tool/version-control/release-preview.rules
pin_rules; prepare_evidence; refusal dependency-cycle
reset_case
printf 'map\tprefix\tdocs/\trepository-policy\n' >>tool/version-control/release-preview.rules
pin_rules; prepare_evidence; refusal duplicate-map-definition
reset_case
printf 'map\tprefix\tdocs/\tundefined-check\n' >>tool/version-control/release-preview.rules
pin_rules; prepare_evidence; refusal unknown-check
reset_case
printf 'map\tprefix\ttool/version-control/\tadvisory-check\n' >>tool/version-control/release-preview.rules
pin_rules; prepare_evidence
sed 's/advisory-v1\tverified/advisory-v1\tfailed/' "$evidence" >"$scratch/changed-evidence"; cp "$scratch/changed-evidence" "$evidence"
pass; assert_text '"state":"failed"'

# ----------
# Exact tool/evidence identities and stable complete replay
# ----------
#
# INV repository/release-preview-read-only
# INV repository/evidence-three-states
reset_case
printf 'new\n' >unixlike/api/contract.json; declaration unixlike patch unixlike-api
prepare_evidence; pass; cp "$output" "$scratch/replay-first"
git branch unrelated-fixture-ref "$base"
TZ=UTC0 run
cmp "$scratch/replay-first" "$output" || { echo 'identical replay changed' >&2; exit 1; }
sed 's/nix-2.34.8/nix-unknown/' "$evidence" >"$scratch/bad-evidence"; cp "$scratch/bad-evidence" "$evidence"; refusal evidence-tool-mismatch
prepare_evidence
sed 's/\tverified\t/\tunverified\t/g' "$evidence" >"$scratch/bad-evidence"; cp "$scratch/bad-evidence" "$evidence"; refusal required-evidence-not-verified
prepare_evidence
sed '/unixlike-evaluation/d' "$evidence" >"$scratch/bad-evidence"; cp "$scratch/bad-evidence" "$evidence"; refusal missing-required-evidence
prepare_evidence
printf 'defect\tunixlike-api\tfixture://known-defect\n' >>"$evidence"; refusal contract-defect

prepare_evidence
# Every asserted identity is bound independently, including otherwise unaffected rows.
for identity in 3 4 5 6; do
  awk -F'\t' -v field="$identity" -v wrong=0000000000000000000000000000000000000000 'BEGIN { OFS="\t" } $1=="evidence" { $field=wrong } { print }' "$evidence" >"$scratch/changed-evidence"
  cp "$scratch/changed-evidence" "$evidence"; refusal evidence-identity-mismatch; prepare_evidence
done
message_digest=$(git show -s --format=%B HEAD | git hash-object --stdin)
pass; assert_text "\"message_digest\":\"$message_digest\""
engine_digest=$(cat "$preview" "$tools/release-preview.awk" | git hash-object --stdin)
assert_text "\"engine_digest\":\"$engine_digest\""

# ----------
# Data-only source and remote isolation/public command
# ----------
#
# INV repository/release-preview-read-only
# INV repository/operator-entry-boundary
reset_case
mkdir -p unixlike/tool
printf '#!/bin/sh\ntouch "%s/executed"\n' "$scratch" >unixlike/tool/candidate-script
chmod +x unixlike/tool/candidate-script
declaration unixlike patch unixlike-inspection
prepare_evidence
git remote add sentinel "file://$scratch/never-contact-remote"
git config merge.fixture.driver "touch $scratch/driver-executed"
git config filter.fixture.smudge "touch $scratch/filter-executed"
git config diff.fixture.textconv "touch $scratch/textconv-executed"
git config --local --list >"$scratch/config-before"
git show-ref >"$scratch/refs-before"
git status --porcelain >"$scratch/status-before"
index_before=$(git hash-object --no-filters .git/index)
mkdir "$scratch/guarded-tools"
RELEASE_FIXTURE_REAL_GIT=$(command -v git)
RELEASE_FIXTURE_FORBIDDEN_LOG="$scratch/forbidden-git"
export RELEASE_FIXTURE_REAL_GIT RELEASE_FIXTURE_FORBIDDEN_LOG
cat >"$scratch/guarded-tools/git" <<'EOF'
#!/bin/sh
case "$1" in -c) operation=$3 ;; --git-dir=*) operation=$2 ;; *) operation=$1 ;; esac
  case "$operation" in
    fetch|pull|push|ls-remote|remote|update-ref|checkout|switch|reset|add|commit|tag)
      printf '%s\n' "$*" >"$RELEASE_FIXTURE_FORBIDDEN_LOG"
      echo 'preview attempted source/remote mutation' >&2
      exit 97 ;;
  esac
exec "$RELEASE_FIXTURE_REAL_GIT" "$@"
EOF
chmod +x "$scratch/guarded-tools/git"
fixture_path=$PATH
PATH="$scratch/guarded-tools:$PATH" pass
PATH=$fixture_path; export PATH
[ ! -e "$RELEASE_FIXTURE_FORBIDDEN_LOG" ] || { cat "$RELEASE_FIXTURE_FORBIDDEN_LOG" >&2; exit 1; }
[ ! -e "$scratch/driver-executed" ] && [ ! -e "$scratch/filter-executed" ] && [ ! -e "$scratch/textconv-executed" ] || { echo 'ambient executable driver ran' >&2; exit 1; }
git config --local --list >"$scratch/config-after"; cmp "$scratch/config-before" "$scratch/config-after"
[ ! -e "$scratch/executed" ] || { echo 'candidate code executed' >&2; exit 1; }
git show-ref >"$scratch/refs-after"; cmp "$scratch/refs-before" "$scratch/refs-after"
git status --porcelain >"$scratch/status-after"; cmp "$scratch/status-before" "$scratch/status-after"
[ "$index_before" = "$(git hash-object --no-filters .git/index)" ] || { echo 'index changed' >&2; exit 1; }
"$tools/../configs" release-preview --master "$base" --candidate HEAD --rules "$rules" --baselines "$baselines" --evidence "$evidence" --json >"$output"
assert_text '"decision":"candidate"'
git branch master "$base"
"$tools/plan-release" unixlike "$base" 2026.09.30 >"$scratch/calendar"
grep -q 'tag: unixlike-v2026.09.30' "$scratch/calendar"

# Evidence references and rule identities are literal hostile data, escaped as JSON.
prepare_evidence
awk -F'\t' 'BEGIN { OFS="\t" } $1=="evidence" {$9="literal \"quote\" \\ slash $(touch hostile-sentinel) `touch hostile-sentinel`"} {print}' "$evidence" >"$scratch/changed-evidence"
cp "$scratch/changed-evidence" "$evidence"; pass
assert_text 'literal \"quote\" \\ slash $(touch hostile-sentinel) `touch hostile-sentinel`'
[ ! -e hostile-sentinel ] || { echo 'hostile evidence executed' >&2; exit 1; }
prepare_evidence
printf 'defect\tunixlike-api\tinvalid-utf8-\377\n' >>"$evidence"; refusal invalid-replay-format

# ----------
# Native entry/prerequisite and MSYS argument coverage
# ----------
#
# INV repository/release-preview-read-only
# INV repository/msys-argument-guard
# INV repository/evidence-three-states
case "$(uname -s)" in MINGW*|MSYS*) echo "Git for Windows native preview fixtures: $(git --version)" ;; *) echo "POSIX preview fixtures: $(git --version)" ;; esac
grep -q '^MSYS_NO_PATHCONV=1' "$preview"
grep -q "MSYS2_ARG_CONV_EXCL='\*'" "$preview"
mkdir "$scratch/incomplete-tools"
ln -s "$(command -v git)" "$scratch/incomplete-tools/git"
set +e
PATH="$scratch/incomplete-tools" "$preview" --master "$base" --candidate HEAD --rules "$rules" --baselines "$baselines" --evidence "$evidence" --json >"$output" 2>"$scratch/unavailable"
unavailable_status=$?
PATH="$scratch/incomplete-tools" REQUIRE_NATIVE=1 "$preview" --master "$base" --candidate HEAD --rules "$rules" --baselines "$baselines" --evidence "$evidence" --json >"$output" 2>"$scratch/unavailable-native"
native_status=$?
set -e
[ "$unavailable_status" -eq 69 ] && [ "$native_status" -eq 1 ] || { echo 'missing capability was upgraded or native job skipped' >&2; exit 1; }
grep -q 'unverified: missing awk' "$scratch/unavailable"
printf 'format\t9\n'  >"$evidence"; refusal invalid-replay-format
echo 'release-preview fixtures passed'
