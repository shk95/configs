default_baselines() {
  printf 'format\t1\nsemantic\tunixlike\t1.0.0\tunixlike-v1.0.0\t%s\nsemantic\twindows\t1.0.0\twindows-v1.0.0\t%s\n' "$(git rev-parse refs/tags/unixlike-v1.0.0)" "$(git rev-parse refs/tags/windows-v1.0.0)" >"$baselines"
}
declaration() {
  domain=$1; impact=$2; contracts=$3; compatibility=${4:-compatible}; migration=${5:-none}; revert=${6:-}
  printf 'feat(%s): synthetic %s change\n\nRelease-Format: 1\nRelease-Domain: %s\nRelease-Impact: %s\nRelease-Contracts: %s\nRelease-Compatibility: %s\nRelease-Rationale: Synthetic compatibility intent.\nRelease-Migration: %s\n' "$domain" "$impact" "$domain" "$impact" "$contracts" "$compatibility" "$migration" >"$scratch/message"
  if [ -n "$revert" ]; then printf 'Release-Reverts: %s\n' "$revert" >>"$scratch/message"; fi
  git add .
  git commit -q -F - <"$scratch/message"
}
prepare_evidence() {
  candidate=$(git rev-parse HEAD)
  master=${master_override:-$base}
  tree=$(git merge-tree --write-tree "$master" "$candidate")
  printf 'format\t1\n' >"$evidence"
  awk -F'\t' -v candidate="$candidate" -v master="$master" -v tree="$tree" -v rules="$rules" '$1=="check" { print "evidence\t" $2 "\t" candidate "\t" master "\t" tree "\t" rules "\t" $7 "\tverified\tfixture://" $2 }' tool/version-control/release-preview.rules >>"$evidence"
}
run() {
  "$preview" --master "${master_override:-$base}" --candidate HEAD --rules "$rules" --baselines "$baselines" --evidence "$evidence" --json >"$output"
}
assert_text() {
  grep -Fq "$1" "$output" || { echo "missing expected output: $1" >&2; cat "$output" >&2; exit 1; }
}
pass() { run || { cat "$output" >&2; exit 1; }; assert_text '"decision":"candidate"'; }
refusal() {
  if run; then echo "unexpectedly accepted $1" >&2; cat "$output" >&2; exit 1; fi
  assert_text '"decision":"refusal"'; assert_text "\"$1\""
}
pin_rules() {
  git add tool/version-control/release-preview.rules
  git commit -qm 'docs(repository): synthetic rule adjustment'
  rules=$(git rev-parse HEAD)
}
reset_case() { git reset --hard -q "$base"; git clean -fdq; default_baselines; rules=$base; unset master_override; }

