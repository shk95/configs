#!/bin/sh
#
# Reports and, only with --fix, applies configuration local to this clone.
# Tracked files cannot set core.hooksPath during clone, so keeping this change
# explicit prevents a setup helper from silently rewriting Git configuration.

set -eu

cd "$(dirname "$0")/.." || exit 1

usage() {
  echo "usage: tool/setup [--fix]" >&2
  exit 2
}

case "${1:-}" in
  "") fix=0 ;;
  --fix) fix=1 ;;
  *) usage ;;
esac

[ "$#" -le 1 ] || usage

expected=.githooks
current=$(git config --local --get core.hooksPath 2>/dev/null || true)

# The directory Git will run hooks from, canonical. Relative values are
# relative to the worktree root; an unset value resolves to .git/hooks, which
# is never the tracked directory. Comparing directories rather than strings
# is what lets an absolute core.hooksPath naming .githooks count as enabled.
hooks_actual() {
  hooks_actual_dir=$(git rev-parse --git-path hooks 2>/dev/null) || return 1
  case "$hooks_actual_dir" in
    /*) ;;
    *) hooks_actual_dir="$(git rev-parse --show-toplevel)/$hooks_actual_dir" ;;
  esac
  (CDPATH= cd -- "$hooks_actual_dir" 2>/dev/null && pwd -P)
}
hooks_expected=$(CDPATH= cd -- "$(git rev-parse --show-toplevel)/.githooks" 2>/dev/null && pwd -P)

if [ -n "$hooks_expected" ] && [ "$(hooks_actual)" = "$hooks_expected" ]; then
  echo "✓ core.hooksPath is ${current:-$expected} (resolves to .githooks)"
  exit 0
fi

if [ -n "$current" ]; then
  echo "! core.hooksPath is '$current'; this project expects '$expected'"
else
  echo "! core.hooksPath is not set for this clone"
fi

if [ "$fix" -eq 0 ]; then
  echo "  No changes made. Run 'tool/setup --fix' to enable the tracked hooks."
  exit 1
fi

git config --local core.hooksPath "$expected"
echo "✓ set core.hooksPath to $expected"
