# ---------------------------------------------------------------------------
# Credentials and machine-local configuration.
#
# These entries belong here before the first commit rather than after the first
# mistake: .gitignore only protects files that were never committed, and a
# secret that reaches history stays there after the file is deleted.
# ---------------------------------------------------------------------------

# Signing and key material
*.jks
*.keystore
*.p12
*.pem
*.key
*.mobileprovision
*.cer

# Environment and local overrides
.env
.env.*
!.env.example
.envrc.local
*.local

# Host-local terminal overrides
assets/wezterm/local.lua

# Agent tooling — shared settings are committed, machine-local ones are not
.claude/settings.local.json
.claude/.cc-writes/

# Maintainer scratch space. Free-form notes with no structure, no review, and no
# retention promise. Ignoring it is what keeps it out of a public history and out
# of every ignore-aware search, and therefore out of project context.
notes/

# ---------------------------------------------------------------------------
# Nix
# ---------------------------------------------------------------------------

# Build results
result
result-*

# direnv's cache
.direnv/

# The NixOS-WSL rootfs that `just nixos-tarball` produces. It defaults to
# ./nixos.wsl — the builder's own default, written to whatever the cwd is —
# and it is around a gigabyte, owned by root because the builder runs under
# sudo. Neither `result` nor `*.gz` catches it, and an untracked gigabyte in
# the repo root is one `git add -A` away from a very bad commit.
nixos.wsl
*.wsl

# flake.lock is NOT ignored. It is the actual pin — reproducibility is the
# point of this repository, and one that ignores its lock file has none.
